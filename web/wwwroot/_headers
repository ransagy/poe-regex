# Revalidate the app shell so deployments roll out immediately.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/precache-manifest.json
  Cache-Control: no-cache

/build-info.json
  Cache-Control: no-cache

# Non-fingerprinted shell assets revalidate instead of staying stale.
/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/web.styles.css
  Cache-Control: no-cache

/data/poe1/*
  Cache-Control: no-cache

# .NET 10 fingerprints every file in _framework/ (content hash in the
# name), so these are safe to cache forever; new builds get new names.
/_framework/*
  Cache-Control: public, max-age=31536000, immutable

# Keep preview and *.pages.dev deployments out of search engines.
# A custom domain is intentionally not matched and stays indexable.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

https://:branch.:project.pages.dev/*
  X-Robots-Tag: noindex
