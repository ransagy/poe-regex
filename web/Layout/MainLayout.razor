@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject web.Services.IntroState Intro
<div class="shell">
    <header class="shell-bar">
        <svg class="shell-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="fg-iron" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c3ccd8"/><stop offset="1" stop-color="#5a6575"/></linearGradient>
                <linearGradient id="fg-hot"><stop offset="0" stop-color="#ff4d12"/><stop offset=".5" stop-color="#ffc04a"/><stop offset="1" stop-color="#ff4d12"/></linearGradient>
                <radialGradient id="fg-gl"><stop offset="0" stop-color="#ff8a1f" stop-opacity=".55"/><stop offset="1" stop-color="#ff8a1f" stop-opacity="0"/></radialGradient>
                <linearGradient id="fg-hd"><stop offset="0" stop-color="#6e7a8b"/><stop offset=".3" stop-color="#d0d8e3"/><stop offset="1" stop-color="#56606f"/></linearGradient>
            </defs>
            <rect x=".5" y=".5" width="63" height="63" rx="13.5" fill="#161a21" stroke="#2f3744"/>
            <ellipse cx="38" cy="34" rx="26" ry="17" fill="url(#fg-gl)"/>
            <g fill="none" stroke-linecap="round" stroke-width="3.2">
                <path d="M32 26L23 18" stroke="#ffd36b"/>
                <path d="M30 29L20 27" stroke="#ff9a22"/>
                <path d="M44 26L52 20" stroke="#ffd36b"/>
                <path d="M46 29L56 27" stroke="#ff9a22"/>
            </g>
            <rect x="28" y="25" width="20" height="6" rx="2" fill="url(#fg-hot)"/>
            <path d="M5 36Q12 32 20 30H57V36L50 38Q44 39 44 44V47L53 51V54H19V51L28 47V44Q28 39 22 38Q11 38 5 36Z" fill="url(#fg-iron)"/>
            <path d="M21 31.2H56" stroke="#fff" stroke-opacity=".4" stroke-width="1.4" stroke-linecap="round"/>
            <rect x="42" y="12" width="18" height="4" rx="2" fill="#c98f55"/>
            <rect x="51" y="11.4" width="9" height="5.2" rx="2.6" fill="#8f5b35"/>
            <rect x="34" y="3" width="8" height="22" rx="1.6" fill="url(#fg-hd)"/>
            <circle cx="38" cy="25" r="7" fill="#ff9a22" fill-opacity=".55"/>
            <path d="M38 17L39.6 23.4L46 25L39.6 26.6L38 33L36.4 26.6L30 25L36.4 23.4Z" fill="#fff3b0"/>
        </svg>
        <h1 class="shell-title">Renly's Recipes</h1>
        <span class="shell-sub">Highlight search strings for Path of Exile 2</span>
        <div class="shell-actions">
            <button type="button" class="shell-link" id="intro-open"
                    disabled="@(Intro.Visible == true)"
                    title="@(Intro.Visible == true ? "The explanation is already open" : "Show the explanation")"
                    @onclick="Intro.Show">What is this?</button>
            <label class="ui-field" title="Palette, saved in this browser">
                <span>Theme</span>
                <select id="theme-select" value="@_theme" @onchange="SetTheme" aria-label="Theme">
                    <option value="forge">Forge Black</option>
                    <optgroup label="Sandstone Bench">
                        <option value="bench-bronze">Bench Bronze</option>
                        <option value="bench-gold">Bench Gold</option>
                        <option value="bench-amber">Bench Amber</option>
                    </optgroup>
                </select>
            </label>
            <label class="ui-field" title="Display scale, saved in this browser">
                <span>Size</span>
                <select value="@_scaleText" @onchange="SetScale" aria-label="Display scale">
                    <option value="1">100%</option>
                    <option value="1.15">115%</option>
                    <option value="1.3">130%</option>
                </select>
            </label>
            <a class="shell-link" href="https://github.com/ransagy/poe-regex" target="_blank" rel="noopener noreferrer"
               title="Source code and engine documentation on GitHub">GitHub</a>
        </div>
    </header>
    <main class="shell-body">
        @Body
    </main>
</div>

@implements IDisposable

@code {
    private double _scale = 1.15;
    private string _scaleText => _scale.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private string _theme = "forge";
    private DotNetObjectReference<MainLayout>? _themeRef;

    protected override async Task OnInitializedAsync()
    {
        await Intro.InitializeAsync();
        Intro.Changed += OnIntroChanged;
    }

    private void OnIntroChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Intro.Changed -= OnIntroChanged;
        _themeRef?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _themeRef ??= DotNetObjectReference.Create(this);
        try
        {
            _scale = await JS.InvokeAsync<double>("poeRegexScale.current");
            var theme = await JS.InvokeAsync<string>("poeRegexTheme.current");
            if (!string.IsNullOrWhiteSpace(theme)) _theme = theme;
            await JS.InvokeVoidAsync("poeRegexTheme.bind", _themeRef);
            StateHasChanged();
        }
        catch
        {
            // JS not ready/failed: the inline bootstrap defaults remain.
        }
    }

    private async Task SetTheme(ChangeEventArgs e)
    {
        var theme = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(theme)) return;
        _theme = theme;
        try { await JS.InvokeVoidAsync("poeRegexTheme.set", theme); }
        catch { }
    }

    [JSInvokable]
    public void ApplyThemeFromStorage(string theme)
    {
        if (string.IsNullOrWhiteSpace(theme) || theme == _theme) return;
        _theme = theme;
        StateHasChanged();
    }

    private async Task SetScale(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var scale)) return;
        _scale = scale;
        try { await JS.InvokeVoidAsync("poeRegexScale.set", scale); }
        catch { }
    }
}
