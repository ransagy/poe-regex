@using PoeRegex.Web.Core

@*
  Compact test-item rows (name + match dot + remove). The backpack grid shows
  placed items; this list is the authoritative roster and keeps list-only
  items (grid full) reachable. Clicking a row opens its detail box under the
  paper doll.
*@
<div class="testitems" aria-label="Test items">
    @if (State.TestItems.Count == 0)
    {
        <div class="hint">no test items yet — import or assemble one above</div>
    }
    @foreach (var item in State.TestItems)
    {
        var hit = HighlightIds.Contains(item.Id);
        <div class="titem @(hit ? "hit" : "") @(State.SelectedItemId == item.Id ? "sel" : "")"
             id="titem-@item.Id"
             @onclick="() => State.SelectTestItem(item.Id)">
            <span class="titem-dot @(hit ? "on" : "")" title="@(hit ? "matches the current query" : "no match")"></span>
            <span class="titem-name">@item.Name</span>
            @if (item.ClassId is not null)
            {
                <span class="titem-cls">· @item.ClassId</span>
            }
            <button id="titem-del-@item.Id" class="titem-del" title="remove"
                    @onclick="() => State.RemoveTestItem(item.Id)"
                    @onclick:stopPropagation="true">×</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter]
    public IReadOnlySet<string> HighlightIds { get; set; } = new HashSet<string>();
}
