@using PoeRegex.Web.Core
@inject EngineService Engine

@if (Open)
{
    <div class="dlg-overlay" id="import-dialog" @onclick="OnBackdrop">
        <div class="dlg" @onclick:stopPropagation="true" role="dialog" aria-label="Import item">
            <div class="panel-head"><span>Import advanced description (English)</span></div>
            <textarea id="import-text" rows="8" placeholder="paste Ctrl+C item text…"
                      value="@_text" @oninput="OnInput" aria-label="Item text"></textarea>
            <div class="modrow">
                <button id="import-parse" @onclick="Parse">preview</button>
                @if (_parsed is not null)
                {
                    <button id="import-save" @onclick="Save">accept &amp; add to backpack</button>
                }
                <button id="import-cancel" @onclick="Close">cancel</button>
            </div>
            @foreach (var v in _violations)
            {
                <div class="@(v.Level == "error" ? "field-error" : "more")">@v.Level: @v.Message</div>
            }
            @if (_saveError is not null)
            {
                <div class="field-error" id="import-save-error">@_saveError</div>
            }
            @if (_parsed is not null)
            {
                <div class="import-preview" id="import-preview">
                    <div><b>@_parsed.Name</b> (@_parsed.Rarity) — @_classId / ilvl @_parsed.ItemLevel</div>
                    @foreach (var (block, bi) in _parsed.Mods.Select((b, i) => (b, i)))
                    {
                        <div class="import-block">
                            <span class="import-kind">@block.Kind @block.Name @(block.Tier is null ? "" : $"T{block.Tier}")</span>
                            @foreach (var (line, li) in block.Lines.Select((l, i) => (l, i)))
                            {
                                var key = (bi, li);
                                var map = _mapped.TryGetValue(key, out var m) ? m : null;
                                <div class="import-line">
                                    <span>@line.Text</span>
                                    @if (map is null || map.ModIds.Count == 0)
                                    {
                                        <span class="map-none">not in catalog</span>
                                    }
                                    else if (map.ModIds.Count == 1)
                                    {
                                        <span class="map-one">@map.ModIds[0]@(map.Approximate ? " ~approx" : "")</span>
                                    }
                                    else
                                    {
                                        <select id="import-pick-@bi-@li" value="@_picked.GetValueOrDefault(key, map.ModIds[0])"
                                                @onchange="e => Pick(key, e)">
                                            @foreach (var id in map.ModIds)
                                            {
                                                <option value="@id">@id</option>
                                            }
                                        </select>
                                        @if (map.Approximate)
                                        {
                                            <span class="map-one">~approx</span>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter, EditorRequired]
    public required bool Open { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback OnClose { get; set; }

    private string _text = "";
    private ParsedItem? _parsed;
    private string? _classId;
    private Dictionary<(int, int), EngineService.ModMapping> _mapped = new();
    private Dictionary<(int, int), string> _picked = new();
    private List<RuleViolation> _violations = [];
    private string? _saveError;

    private void OnInput(ChangeEventArgs e) => _text = e.Value?.ToString() ?? "";

    private void Parse()
    {
        _violations = [];
        _saveError = null;
        _parsed = ItemTextParser.Parse(_text);
        _classId = Engine.ResolveClassId(_parsed.ItemClass);
        _mapped = new();
        _picked = new();
        foreach (var (block, bi) in _parsed.Mods.Select((b, i) => (b, i)))
            foreach (var (line, li) in block.Lines.Select((l, i) => (l, i)))
            {
                var map = Engine.MapLineToMods(_classId, line.CanonicalText, line.Rolls);
                _mapped[(bi, li)] = map;
                if (map.ModIds.Count > 0)
                    _picked[(bi, li)] = map.ModIds[0];
            }
    }

    private void Pick((int, int) key, ChangeEventArgs e)
    {
        if (e.Value is string id) _picked[key] = id;
    }

    private async Task Close()
    {
        _text = "";
        _parsed = null;
        _violations = [];
        _saveError = null;
        await OnClose.InvokeAsync();
    }

    private void OnBackdrop()
    {
        _ = Close();
    }

    private void Save()
    {
        _saveError = null;
        if (_parsed is null) return;
        // Gate: only import what a slot query can test against (in-game classes with mods).
        var playable = _classId is not null && Engine.InGameClasses().Any(c => c.Id == _classId);
        if (!playable)
        {
            _saveError = _classId is null
                ? "no recognizable item class: import blocked"
                : $"class '{_classId}' has no catalog mods: import blocked";
            return;
        }
        var ruleLines = new List<RuleLine>();
        foreach (var (block, bi) in _parsed.Mods.Select((b, i) => (b, i)))
        {
            // One entry per block (multi-line mods count once).
            string? sel = null;
            for (var li = 0; li < block.Lines.Count && sel is null; li++)
                if (_mapped.TryGetValue((bi, li), out var m) && m.ModIds.Count > 0)
                    sel = _picked.GetValueOrDefault((bi, li), m.ModIds[0]);
            ruleLines.Add(new RuleLine(block.Kind, sel));
        }
        _violations = ItemRules.Validate(Engine, ruleLines, _parsed.Rarity).ToList();
        foreach (var (block, bi) in _parsed.Mods.Select((b, i) => (b, i)))
        {
            if (block.Kind == "implicit") continue;
            var mapped = block.Lines.Select((_, li) => li).Any(li =>
                _mapped.TryGetValue((bi, li), out var m) && m.ModIds.Count > 0);
            if (!mapped)
                _violations.Add(new RuleViolation("warning",
                    $"'{block.Name ?? block.Kind}' did not map to the catalog: counts may be off"));
        }
        if (_violations.Any(v => v.Level == "error")) return;
        var item = new TestItem
        {
            Name = _parsed.Name ?? "imported item",
            ClassId = _classId,
            Parsed = _parsed,
        };
        foreach (var (key, map) in _mapped)
        {
            var (bi, li) = key;
            var line = _parsed.Mods[bi].Lines[li];
            item.Mapped.Add(new MappedLine(
                line.Text, line.CanonicalText, line.Rolls, map.ModIds,
                map.ModIds.Count == 0 ? null : _picked.GetValueOrDefault(key, map.ModIds[0])));
        }
        State.AddTestItem(item);
        _ = Close();
    }
}
