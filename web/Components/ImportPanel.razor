@using PoeRegex.Core.Data
@using PoeRegex.Web.Core
@inject EngineService Engine

@if (Open)
{
    <div class="dlg-overlay" id="import-dialog" @onclick="OnBackdrop">
        <div class="dlg" @onclick:stopPropagation="true" role="dialog" aria-label="Import item"
             @onkeydown="OnDialogKeyDown">
            <div class="panel-head"><span>Import advanced description (English)</span></div>
            <textarea id="import-text" rows="8" placeholder="paste Ctrl+C item text…"
                      value="@_text" @oninput="OnInput" @onkeydown:stopPropagation="true"
                      aria-label="Item text"></textarea>
            <div class="modrow">
                <button id="import-parse" class="btn" @onclick="Parse">preview</button>
                @if (_items.Count == 1)
                {
                    <button id="import-save" class="btn" disabled="@(_violations.Any(v => v.Level == "error"))" @onclick="Save">Add</button>
                }
                @if (IsBatch)
                {
                    <button id="import-save-all" class="btn" disabled="@(AddableCount() == 0)" @onclick="SaveAll">
                        add all (@AddableCount())
                    </button>
                }
                <button id="import-cancel" class="btn" @onclick="Close">cancel</button>
            </div>
            @foreach (var v in _violations)
            {
                <div class="@(v.Level == "error" ? "field-error" : "more")">@v.Level: @v.Message</div>
            }
            @if (_saveError is not null)
            {
                <div class="field-error" id="import-save-error">@_saveError</div>
            }
            @if (_items.Count == 1 && _preview is not null && _singleMapped is not null)
            {
                <ItemPreview Item="_preview" Id="import-preview">
                    <LineAnnotation Context="ln">
                        @(Annotations(_items[0], _singleMapped)(ln))
                    </LineAnnotation>
                </ItemPreview>
            }
            @if (IsBatch)
            {
                <div class="import-batch" id="import-batch">
                    <div class="more" id="import-batch-count">
                        @_items.Count items detected — step through the cards; add all adds every importable item
                    </div>
                    <div class="import-batch-head">
                        <span class="import-nav-count" id="import-nav-count">@(_batchIndex + 1) / @_items.Count</span>
                        @if (CurrentRow is { } statusRow)
                        {
                            @if (statusRow.Added)
                            {
                                <span class="import-batch-ok" id="import-status">added</span>
                            }
                            else if (statusRow.AddError is not null)
                            {
                                <span class="field-error import-batch-status" id="import-status">@statusRow.AddError</span>
                            }
                            else if (statusRow.Status is not null)
                            {
                                <span class="field-error import-batch-status" id="import-status">@statusRow.Status</span>
                            }
                            else if (statusRow.Unmapped > 0)
                            {
                                <span class="map-none import-batch-status" id="import-status">@statusRow.Unmapped line(s) not in catalog</span>
                            }
                        }
                    </div>
                    @if (_batchPreview is not null && CurrentRow is { } row)
                    {
                        <div class="import-carousel">
                            <button id="import-prev" class="btn import-side-btn" aria-label="Previous item"
                                    disabled="@(_batchIndex == 0)"
                                    @onclick="() => SelectBatch(_batchIndex - 1)">‹</button>
                            <ItemPreview Item="_batchPreview" Id="import-preview">
                                <LineAnnotation Context="ln">
                                    @(Annotations(row.Parsed, row.Mapped)(ln))
                                </LineAnnotation>
                            </ItemPreview>
                            <button id="import-next" class="btn import-side-btn" aria-label="Next item"
                                    disabled="@(_batchIndex >= _items.Count - 1)"
                                    @onclick="() => SelectBatch(_batchIndex + 1)">›</button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter, EditorRequired]
    public required bool Open { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback OnClose { get; set; }

    /// <summary>One pasted item in a multi-item paste, with its verdicts.</summary>
    private sealed record BatchRow(ParsedItem Parsed, ItemImport.Mapped Mapped)
    {
        public int Unmapped { get; } = ItemImport.UnmappedAffixCount(Parsed, Mapped);
        /// <summary>Verdict for the resolved affixes (gate / rule error); null = importable.</summary>
        public string? Status { get; init; }
        /// <summary>Transient failure from the last add attempt (e.g. backpack full).</summary>
        public string? AddError { get; set; }
        public bool Added { get; set; }
    }

    private string _text = "";
    private List<ParsedItem> _items = [];
    private List<BatchRow> _batch = [];
    private int _batchIndex;
    private TestItem? _preview;
    private TestItem? _batchPreview;
    private ItemImport.Mapped? _singleMapped;
    private List<RuleViolation> _violations = [];
    private string? _saveError;

    private bool IsBatch => _items.Count > 1;

    private int AddableCount() => _batch.Count(r => !r.Added && r.Status is null);

    private void OnInput(ChangeEventArgs e) => _text = e.Value?.ToString() ?? "";

    private void Parse()
    {
        _violations = [];
        _saveError = null;
        _batch = [];
        _batchIndex = 0;
        _batchPreview = null;
        _preview = null;
        _singleMapped = null;
        _items = ItemTextParser.SplitItems(_text).Select(ItemTextParser.Parse).ToList();
        if (_items.Count == 1)
        {
            var mapped = ItemImport.Map(Engine, _items[0]);
            _singleMapped = mapped;
            _preview = ItemImport.Materialize(_items[0], mapped);
            var gate = ItemImport.Gate(Engine, mapped.ClassId);
            _violations = gate is not null
                ? [new RuleViolation("error", gate)]
                : ItemImport.Validate(Engine, _items[0], mapped).ToList();
        }
        else if (IsBatch)
        {
            _batch = _items.Select(p =>
            {
                var mapped = ItemImport.Map(Engine, p);
                var gate = ItemImport.Gate(Engine, mapped.ClassId);
                var error = gate ?? ItemImport.Validate(Engine, p, mapped)
                    .FirstOrDefault(v => v.Level == "error")?.Message;
                return new BatchRow(p, mapped) { Status = error };
            }).ToList();
            SelectBatch(0);
        }
    }

    /// <summary>The item the carousel currently shows, if any.</summary>
    private BatchRow? CurrentRow =>
        _batchIndex >= 0 && _batchIndex < _batch.Count ? _batch[_batchIndex] : null;

    private void SelectBatch(int index)
    {
        if (index < 0 || index >= _batch.Count) return;
        _batchIndex = index;
        RefreshBatchPreview();
    }

    private void RefreshBatchPreview() =>
        _batchPreview = CurrentRow is { } row ? ItemImport.Materialize(row.Parsed, row.Mapped) : null;

    /// <summary>
    /// Arrow keys step the batch carousel while focus is anywhere in the
    /// dialog: the paste box stops keydown propagation so its caret and
    /// selection keys keep working, and held modifiers are left alone.
    /// </summary>
    private void OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey || e.ShiftKey) return;
        if (e.Key == "ArrowLeft") SelectBatch(_batchIndex - 1);
        else if (e.Key == "ArrowRight") SelectBatch(_batchIndex + 1);
    }

    private async Task Close()
    {
        _text = "";
        _items = [];
        _batch = [];
        _batchIndex = 0;
        _batchPreview = null;
        _preview = null;
        _singleMapped = null;
        _violations = [];
        _saveError = null;
        await OnClose.InvokeAsync();
    }

    private void OnBackdrop()
    {
        _ = Close();
    }

    private void Save()
    {
        _saveError = null;
        if (_items.Count != 1 || _singleMapped is null) return;
        if (_violations.Any(v => v.Level == "error")) return;
        var item = ItemImport.Materialize(_items[0], _singleMapped);
        if (!State.AddTestItem(item))
        {
            _saveError = "backpack is full — remove an item first";
            return;
        }
        _ = Close();
    }

    private void SaveAll()
    {
        _saveError = null;
        foreach (var row in _batch)
        {
            if (row.Added || row.Status is not null) continue;
            var item = ItemImport.Materialize(row.Parsed, row.Mapped);
            if (State.AddTestItem(item))
            {
                row.Added = true;
                row.AddError = null;
            }
            else
            {
                row.AddError = "backpack is full — remove an item first";
            }
        }
        if (_batch.All(r => r.Added))
        {
            _ = Close();
            return;
        }
        // Park the carousel on the first item that still needs attention.
        var first = _batch.FindIndex(r => !r.Added);
        if (first >= 0) SelectBatch(first);
        StateHasChanged();
    }

    /// <summary>
    /// Shared per-line annotation for both import cards: the resolved affix
    /// name, dimmed, with the evidence in its tooltip (id · kind · range) and
    /// `+N` when the line stayed ambiguous — no header name, no bracketed
    /// ranges to break the tie. One quieting rule: an unmapped implicit line
    /// says nothing, because implicit blocks never count in the rules and the
    /// affix-only catalog can't map them by design.
    /// </summary>
    private RenderFragment<ItemPreview.PreviewLineRef> Annotations(
        ParsedItem parsed, ItemImport.Mapped mapped)
        => ln =>
        {
            var key = (ln.Block, ln.Line);
            var map = mapped.Lines.TryGetValue(key, out var m) ? m : null;
            var ids = map?.ModIds ?? [];
            var isImplicit = ln.Block >= 0 && ln.Block < parsed.Mods.Count
                && parsed.Mods[ln.Block].Kind == "implicit";
            return builder =>
            {
                if (ids.Count == 0)
                {
                    if (!isImplicit)
                        builder.AddMarkupContent(0, "<span class=\"iprev-annot map-none\">not in catalog</span>");
                    return;
                }
                var mod = Engine.FindMod(ids[0]);
                var label = mod?.Name ?? ids[0];
                if (map!.Approximate) label += " ~approx";
                if (ids.Count > 1) label += $" +{ids.Count - 1}";
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", "iprev-annot map-one");
                builder.AddAttribute(2, "title", AnnotationTitle(ids, mod));
                builder.AddContent(3, label);
                builder.CloseElement();
            };
        };

    /// <summary>Hover text for a resolved line: id, kind, and the catalog range.</summary>
    private static string AnnotationTitle(IReadOnlyList<string> ids, ModEntry? mod)
    {
        var kind = mod?.GenerationType ?? "kind unknown";
        var range = mod?.StatLines.FirstOrDefault() is { } sl
            ? ModSearch.DisplayLine(sl)
            : "no catalog line";
        var title = $"{ids[0]} · {kind} · {range}";
        if (ids.Count > 1) title += $" — {ids.Count} catalog mods match; using this one";
        return title;
    }
}
