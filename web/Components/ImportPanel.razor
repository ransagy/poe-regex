@using PoeRegex.Web.Core
@inject EngineService Engine

@if (Open)
{
    <div class="dlg-overlay" id="import-dialog" @onclick="OnBackdrop">
        <div class="dlg" @onclick:stopPropagation="true" role="dialog" aria-label="Import item">
            <div class="panel-head"><span>Import advanced description (English)</span></div>
            <textarea id="import-text" rows="8" placeholder="paste Ctrl+C item text…"
                      value="@_text" @oninput="OnInput" aria-label="Item text"></textarea>
            <div class="modrow">
                <button id="import-parse" class="btn" @onclick="Parse">preview</button>
                @if (_items.Count == 1)
                {
                    <button id="import-save" class="btn" disabled="@(_violations.Any(v => v.Level == "error"))" @onclick="Save">Add</button>
                }
                @if (IsBatch)
                {
                    <button id="import-save-all" class="btn" disabled="@(AddableCount() == 0)" @onclick="SaveAll">
                        add all (@AddableCount())
                    </button>
                }
                <button id="import-cancel" class="btn" @onclick="Close">cancel</button>
            </div>
            @foreach (var v in _violations)
            {
                <div class="@(v.Level == "error" ? "field-error" : "more")">@v.Level: @v.Message</div>
            }
            @if (_saveError is not null)
            {
                <div class="field-error" id="import-save-error">@_saveError</div>
            }
            @if (_items.Count == 1 && _preview is not null)
            {
                <ItemPreview Item="_preview" Id="import-preview">
                    <LineAnnotation Context="ln">
                        @(Annotations(_items[0], new ItemImport.Mapped(_classId, _mapped), _picked, Pick)(ln))
                    </LineAnnotation>
                </ItemPreview>
            }
            @if (IsBatch)
            {
                <div class="import-batch" id="import-batch">
                    <div class="more" id="import-batch-count">
                        @_items.Count items detected — step through the cards; add all uses each item's picks
                    </div>
                    <div class="import-nav" id="import-nav">
                        <button id="import-prev" class="btn" aria-label="Previous item"
                                disabled="@(_batchIndex == 0)"
                                @onclick="() => SelectBatch(_batchIndex - 1)">‹</button>
                        <span class="import-nav-count" id="import-nav-count">@(_batchIndex + 1) / @_items.Count</span>
                        <button id="import-next" class="btn" aria-label="Next item"
                                disabled="@(_batchIndex >= _items.Count - 1)"
                                @onclick="() => SelectBatch(_batchIndex + 1)">›</button>
                        @if (CurrentRow is { } statusRow)
                        {
                            @if (statusRow.Added)
                            {
                                <span class="import-batch-ok" id="import-status">added</span>
                            }
                            else if (statusRow.AddError is not null)
                            {
                                <span class="field-error import-batch-status" id="import-status">@statusRow.AddError</span>
                            }
                            else if (statusRow.Status is not null)
                            {
                                <span class="field-error import-batch-status" id="import-status">@statusRow.Status</span>
                            }
                            else if (statusRow.Unmapped > 0)
                            {
                                <span class="map-none import-batch-status" id="import-status">@statusRow.Unmapped line(s) not in catalog</span>
                            }
                        }
                    </div>
                    @if (_batchPreview is not null && CurrentRow is { } row)
                    {
                        <ItemPreview Item="_batchPreview" Id="import-preview">
                            <LineAnnotation Context="ln">
                                @(Annotations(row.Parsed, row.Mapped, row.Picked, PickHandler(row))(ln))
                            </LineAnnotation>
                        </ItemPreview>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter, EditorRequired]
    public required bool Open { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback OnClose { get; set; }

    /// <summary>One pasted item in a multi-item paste, with its verdicts.</summary>
    private sealed record BatchRow(ParsedItem Parsed, ItemImport.Mapped Mapped)
    {
        public Dictionary<(int, int), string> Picked { get; init; } = new();
        public IReadOnlyList<RuleViolation> Violations { get; set; } = [];
        public int Unmapped { get; } = ItemImport.UnmappedAffixCount(Parsed, Mapped);
        /// <summary>Verdict for the current picks (gate / rule error); null = importable.</summary>
        public string? Status { get; set; }
        /// <summary>Transient failure from the last add attempt (e.g. backpack full).</summary>
        public string? AddError { get; set; }
        public bool Added { get; set; }
    }

    private string _text = "";
    private List<ParsedItem> _items = [];
    private List<BatchRow> _batch = [];
    private int _batchIndex;
    private TestItem? _preview;
    private TestItem? _batchPreview;
    private string? _classId;
    private Dictionary<(int, int), EngineService.ModMapping> _mapped = new();
    private Dictionary<(int, int), string> _picked = new();
    private List<RuleViolation> _violations = [];
    private string? _saveError;

    private bool IsBatch => _items.Count > 1;

    private int AddableCount() => _batch.Count(r => !r.Added && r.Status is null);

    private void OnInput(ChangeEventArgs e) => _text = e.Value?.ToString() ?? "";

    private void Parse()
    {
        _violations = [];
        _saveError = null;
        _batch = [];
        _batchIndex = 0;
        _batchPreview = null;
        _preview = null;
        _mapped = new();
        _picked = new();
        _classId = null;
        _items = ItemTextParser.SplitItems(_text).Select(ItemTextParser.Parse).ToList();
        if (_items.Count == 1)
        {
            var mapped = ItemImport.Map(Engine, _items[0]);
            _classId = mapped.ClassId;
            _mapped = mapped.Lines;
            _picked = ItemImport.DefaultPicks(Engine, _items[0], mapped);
            _preview = ItemImport.Materialize(_items[0], mapped, _picked);
        }
        else if (IsBatch)
        {
            _batch = _items.Select(p =>
            {
                var mapped = ItemImport.Map(Engine, p);
                var gate = ItemImport.Gate(Engine, mapped.ClassId);
                var picked = ItemImport.DefaultPicks(Engine, p, mapped);
                var violations = gate is null
                    ? ItemImport.Validate(Engine, p, mapped, picked)
                    : (IReadOnlyList<RuleViolation>)[];
                var error = gate ?? violations.FirstOrDefault(v => v.Level == "error")?.Message;
                return new BatchRow(p, mapped) { Picked = picked, Violations = violations, Status = error };
            }).ToList();
            SelectBatch(0);
        }
    }

    /// <summary>The item the carousel currently shows, if any.</summary>
    private BatchRow? CurrentRow =>
        _batchIndex >= 0 && _batchIndex < _batch.Count ? _batch[_batchIndex] : null;

    private void SelectBatch(int index)
    {
        if (index < 0 || index >= _batch.Count) return;
        _batchIndex = index;
        RefreshBatchPreview();
    }

    private void RefreshBatchPreview()
    {
        var row = CurrentRow;
        _batchPreview = row is null ? null : ItemImport.Materialize(row.Parsed, row.Mapped, row.Picked);
    }

    /// <summary>Carousel picks for the current row; null once the row is added (read-only).</summary>
    private Action<(int, int), ChangeEventArgs>? PickHandler(BatchRow row) =>
        row.Added ? null : (k, e) => BatchPick(row, k, e);

    private void BatchPick(BatchRow row, (int, int) key, ChangeEventArgs e)
    {
        if (row.Added || e.Value is not string id) return;
        row.Picked[key] = id;
        RecomputeRowStatus(row);
        RefreshBatchPreview();
    }

    private void RecomputeRowStatus(BatchRow row)
    {
        var gate = ItemImport.Gate(Engine, row.Mapped.ClassId);
        if (gate is not null)
        {
            row.Status = gate;
            return;
        }
        row.Violations = ItemImport.Validate(Engine, row.Parsed, row.Mapped, row.Picked);
        row.Status = row.Violations.FirstOrDefault(v => v.Level == "error")?.Message;
    }

    private void Pick((int, int) key, ChangeEventArgs e)
    {
        if (e.Value is string id) _picked[key] = id;
    }

    private async Task Close()
    {
        _text = "";
        _items = [];
        _batch = [];
        _batchIndex = 0;
        _batchPreview = null;
        _preview = null;
        _violations = [];
        _saveError = null;
        await OnClose.InvokeAsync();
    }

    private void OnBackdrop()
    {
        _ = Close();
    }

    private void Save()
    {
        _saveError = null;
        if (_items.Count != 1) return;
        var parsed = _items[0];
        var gate = ItemImport.Gate(Engine, _classId);
        if (gate is not null)
        {
            _saveError = gate;
            return;
        }
        var mapped = new ItemImport.Mapped(_classId, _mapped);
        _violations = ItemImport.Validate(Engine, parsed, mapped, _picked).ToList();
        if (_violations.Any(v => v.Level == "error")) return;
        var item = ItemImport.Materialize(parsed, mapped, _picked);
        if (!State.AddTestItem(item))
        {
            _saveError = "backpack is full — remove an item first";
            return;
        }
        _ = Close();
    }

    private void SaveAll()
    {
        _saveError = null;
        foreach (var row in _batch)
        {
            if (row.Added || row.Status is not null) continue;
            var item = ItemImport.Materialize(row.Parsed, row.Mapped, row.Picked);
            if (State.AddTestItem(item))
            {
                row.Added = true;
                row.AddError = null;
            }
            else
            {
                row.AddError = "backpack is full — remove an item first";
            }
        }
        if (_batch.All(r => r.Added))
        {
            _ = Close();
            return;
        }
        // Park the carousel on the first item that still needs attention.
        var first = _batch.FindIndex(r => !r.Added);
        if (first >= 0) SelectBatch(first);
        StateHasChanged();
    }

    /// <summary>
    /// Shared per-line annotation for both import cards: the mapping verdict
    /// (dim id, candidate picker) with one quieting rule — an unmapped
    /// implicit line says nothing, because implicit blocks never count in the
    /// rules and the affix-only catalog can't map them by design. Pass a null
    /// pick handler to render read-only (rows already added).
    /// </summary>
    private RenderFragment<ItemPreview.PreviewLineRef> Annotations(
        ParsedItem parsed, ItemImport.Mapped mapped,
        IReadOnlyDictionary<(int, int), string> picked,
        Action<(int, int), ChangeEventArgs>? pick)
        => ln =>
        {
            var key = (ln.Block, ln.Line);
            var map = mapped.Lines.TryGetValue(key, out var m) ? m : null;
            var ids = map?.ModIds ?? [];
            var isImplicit = ln.Block >= 0 && ln.Block < parsed.Mods.Count
                && parsed.Mods[ln.Block].Kind == "implicit";
            return builder =>
            {
                if (ids.Count == 0)
                {
                    if (!isImplicit)
                        builder.AddMarkupContent(0, "<span class=\"iprev-annot map-none\">not in catalog</span>");
                    return;
                }
                if (ids.Count == 1 || pick is null)
                {
                    var id = picked.GetValueOrDefault(key, ids[0]);
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "iprev-annot map-one");
                    builder.AddContent(2, map!.Approximate ? $"{id} ~approx" : id);
                    builder.CloseElement();
                    return;
                }
                builder.OpenElement(0, "select");
                builder.AddAttribute(1, "class", "iprev-annot-select");
                builder.AddAttribute(2, "id", $"import-pick-{ln.Block}-{ln.Line}");
                builder.AddAttribute(3, "value", picked.GetValueOrDefault(key, ids[0]));
                builder.AddAttribute(4, "onchange",
                    EventCallback.Factory.Create<ChangeEventArgs>(this, e => pick(key, e)));
                foreach (var id in ids)
                {
                    builder.OpenElement(5, "option");
                    builder.AddAttribute(6, "value", id);
                    builder.AddContent(7, id);
                    builder.CloseElement();
                }
                builder.CloseElement();
                if (map!.Approximate)
                {
                    builder.OpenElement(8, "span");
                    builder.AddAttribute(9, "class", "iprev-annot map-one");
                    builder.AddContent(10, "~approx");
                    builder.CloseElement();
                }
            };
        };
}
