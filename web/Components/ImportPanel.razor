@using PoeRegex.Web.Core
@inject EngineService Engine

@if (Open)
{
    <div class="dlg-overlay" id="import-dialog" @onclick="OnBackdrop">
        <div class="dlg" @onclick:stopPropagation="true" role="dialog" aria-label="Import item">
            <div class="panel-head"><span>Import advanced description (English)</span></div>
            <textarea id="import-text" rows="8" placeholder="paste Ctrl+C item text…"
                      value="@_text" @oninput="OnInput" aria-label="Item text"></textarea>
            <div class="modrow">
                <button id="import-parse" class="btn" @onclick="Parse">preview</button>
                @if (_items.Count == 1)
                {
                    <button id="import-save" class="btn" disabled="@(_violations.Any(v => v.Level == "error"))" @onclick="Save">Add</button>
                }
                @if (IsBatch)
                {
                    <button id="import-save-all" class="btn" disabled="@(AddableCount() == 0)" @onclick="SaveAll">
                        add all (@AddableCount())
                    </button>
                }
                <button id="import-cancel" class="btn" @onclick="Close">cancel</button>
            </div>
            @foreach (var v in _violations)
            {
                <div class="@(v.Level == "error" ? "field-error" : "more")">@v.Level: @v.Message</div>
            }
            @if (_saveError is not null)
            {
                <div class="field-error" id="import-save-error">@_saveError</div>
            }
            @if (_items.Count == 1 && _preview is not null)
            {
                <ItemPreview Item="_preview" Id="import-preview">
                    <LineAnnotation Context="ln">
                        @{
                            var key = (ln.Block, ln.Line);
                            var map = _mapped.TryGetValue(key, out var m) ? m : null;
                        }
                        @if (map is null || map.ModIds.Count == 0)
                        {
                            <span class="iprev-annot map-none">not in catalog</span>
                        }
                        else if (map.ModIds.Count == 1)
                        {
                            <span class="iprev-annot map-one">@map.ModIds[0]@(map.Approximate ? " ~approx" : "")</span>
                        }
                        else
                        {
                            <select class="iprev-annot-select" id="import-pick-@ln.Block-@ln.Line"
                                    value="@_picked.GetValueOrDefault(key, map.ModIds[0])"
                                    @onchange="e => Pick(key, e)">
                                @foreach (var id in map.ModIds)
                                {
                                    <option value="@id">@id</option>
                                }
                            </select>
                            @if (map.Approximate)
                            {
                                <span class="iprev-annot map-one">~approx</span>
                            }
                        }
                    </LineAnnotation>
                </ItemPreview>
            }
            @if (IsBatch)
            {
                <div class="import-batch" id="import-batch">
                    <div class="more" id="import-batch-count">
                        @_items.Count items detected — add all imports each with the catalog's default picks
                    </div>
                    @foreach (var (row, i) in _batch.Select((r, i) => (r, i)))
                    {
                        <div class="import-batch-row" id="import-batch-row-@i">
                            <span class="import-batch-name @RarityClass(row.Parsed.Rarity)">@(row.Parsed.Name ?? "unnamed item")</span>
                            <span class="import-batch-sub">@(row.Parsed.ItemClass ?? "?") · @(row.Parsed.Rarity ?? "?")</span>
                            @if (row.Added)
                            {
                                <span class="import-batch-ok">added</span>
                            }
                            else if (row.Status is not null)
                            {
                                <span class="field-error import-batch-status">@row.Status</span>
                            }
                            else if (row.Unmapped > 0)
                            {
                                <span class="map-none import-batch-status">@row.Unmapped line(s) not in catalog</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter, EditorRequired]
    public required bool Open { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback OnClose { get; set; }

    /// <summary>One pasted item in a multi-item paste, with its verdicts.</summary>
    private sealed record BatchRow(
        ParsedItem Parsed,
        ItemImport.Mapped Mapped,
        IReadOnlyList<RuleViolation> Violations)
    {
        public int Unmapped { get; } = Mapped.Lines.Count(kv => kv.Value.ModIds.Count == 0);
        public string? Status { get; set; }
        public bool Added { get; set; }
    }

    private string _text = "";
    private List<ParsedItem> _items = [];
    private List<BatchRow> _batch = [];
    private TestItem? _preview;
    private string? _classId;
    private Dictionary<(int, int), EngineService.ModMapping> _mapped = new();
    private Dictionary<(int, int), string> _picked = new();
    private List<RuleViolation> _violations = [];
    private string? _saveError;

    private bool IsBatch => _items.Count > 1;

    private int AddableCount() => _batch.Count(r => !r.Added && r.Status is null);

    private void OnInput(ChangeEventArgs e) => _text = e.Value?.ToString() ?? "";

    private void Parse()
    {
        _violations = [];
        _saveError = null;
        _batch = [];
        _preview = null;
        _mapped = new();
        _picked = new();
        _classId = null;
        _items = ItemTextParser.SplitItems(_text).Select(ItemTextParser.Parse).ToList();
        if (_items.Count == 1)
        {
            var mapped = ItemImport.Map(Engine, _items[0]);
            _classId = mapped.ClassId;
            _mapped = mapped.Lines;
            _picked = ItemImport.DefaultPicks(Engine, _items[0], mapped);
            _preview = ItemImport.Materialize(_items[0], mapped, _picked);
        }
        else if (IsBatch)
        {
            _batch = _items.Select(p =>
            {
                var mapped = ItemImport.Map(Engine, p);
                var gate = ItemImport.Gate(Engine, mapped.ClassId);
                var violations = gate is null
                    ? ItemImport.Validate(Engine, p, mapped, ItemImport.DefaultPicks(Engine, p, mapped))
                    : (IReadOnlyList<RuleViolation>)[];
                var error = gate ?? violations.FirstOrDefault(v => v.Level == "error")?.Message;
                return new BatchRow(p, mapped, violations) { Status = error };
            }).ToList();
        }
    }

    private void Pick((int, int) key, ChangeEventArgs e)
    {
        if (e.Value is string id) _picked[key] = id;
    }

    private async Task Close()
    {
        _text = "";
        _items = [];
        _batch = [];
        _preview = null;
        _violations = [];
        _saveError = null;
        await OnClose.InvokeAsync();
    }

    private void OnBackdrop()
    {
        _ = Close();
    }

    private void Save()
    {
        _saveError = null;
        if (_items.Count != 1) return;
        var parsed = _items[0];
        var gate = ItemImport.Gate(Engine, _classId);
        if (gate is not null)
        {
            _saveError = gate;
            return;
        }
        var mapped = new ItemImport.Mapped(_classId, _mapped);
        _violations = ItemImport.Validate(Engine, parsed, mapped, _picked).ToList();
        if (_violations.Any(v => v.Level == "error")) return;
        var item = ItemImport.Materialize(parsed, mapped, _picked);
        if (!State.AddTestItem(item))
        {
            _saveError = "backpack is full — remove an item first";
            return;
        }
        _ = Close();
    }

    private void SaveAll()
    {
        _saveError = null;
        foreach (var row in _batch)
        {
            if (row.Added || row.Status is not null) continue;
            var result = ItemImport.Import(Engine, row.Parsed);
            if (result.Item is null)
            {
                row.Status = result.Error ?? "import blocked";
                continue;
            }
            if (State.AddTestItem(result.Item)) row.Added = true;
            else row.Status = "backpack is full — remove an item first";
        }
        if (_batch.All(r => r.Added))
        {
            _ = Close();
            return;
        }
        StateHasChanged();
    }

    private static string RarityClass(string? rarity) => rarity switch
    {
        "Magic" => "rarity-magic",
        "Rare" => "rarity-rare",
        "Unique" => "rarity-unique",
        _ => "rarity-normal",
    };
}
