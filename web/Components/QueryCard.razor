@using PoeRegex.Core
@using PoeRegex.Core.Explain
@using PoeRegex.Web.Core
@inject EngineService Engine
@inject IJSRuntime JS
@implements IDisposable

<div class="qcard" id="qcard-@CardId">
    <div class="qcard-head">
        <span class="qcard-title">@Title</span>
        @if (_result is not null)
        {
            <span class="meter-num @(_result.Exceeded ? "over" : "")">@_result.Length / @_result.Limit</span>
        }
    </div>

    @if (_result is not null)
    {
        <div class="qquery" id="qcard-@CardId-query">@_result.Query</div>
        <div class="qactions">
            <button id="qcard-@CardId-copy" class="btn" @onclick="Copy">@(_copyStatus == "copied" ? "Copied" : "Copy")</button>
            <button id="qcard-@CardId-explain" class="btn" @onclick="ToggleExplain">
                @(_showExplain ? "Hide matches" : "Show what it matches")
            </button>
            @if (_explainLoading)
            {
                <span class="qcopy-status" id="qcard-@CardId-explain-loading">Checking the catalog…</span>
            }
            @if (Engine.Validate(_result.Query) is { } warn)
            {
                <span class="qwarn">Syntax: @warn.Code</span>
            }
        </div>
        @foreach (var d in _result.Diagnostics)
        {
            <div class="qdiag">@d.Level @d.Code: @d.Message</div>
        }
        @if (_showExplain && _explain is not null)
        {
            <div class="qexplain" id="qcard-@CardId-explain-panel">
                @foreach (var t in _explain.Tokens)
                {
                    var lines = t.Matches.Select(m => m.Line).Distinct(StringComparer.Ordinal).ToList();
                    <div class="qexplain-block">
                        <div class="qexplain-token">
                            <code>@(t.Excluded ? "!" : "")"@t.Phrase"</code>
                            <span class="qexplain-kind">@KindLabel(t), @lines.Count @(lines.Count == 1 ? "line" : "lines")</span>
                        </div>
                        @if (t.Kind != "class" && lines.Count > 0)
                        {
                            <ul class="qexplain-mods">
                                @foreach (var line in lines.Take(8))
                                {
                                    <li>@line</li>
                                }
                                @if (lines.Count > 8)
                                {
                                    <li class="more">@(lines.Count - 8) more</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required string CardId { get; set; }

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public string? ItemClass { get; set; }

    [Parameter]
    public CompileResult? Result { get; set; }

    private CompileResult? _result;
    private ExplainResult? _explain;
    private bool _showExplain;
    private bool _explainLoading;
    private string _copyStatus = "";
    private CancellationTokenSource? _prewarmCts;

    protected override void OnParametersSet()
    {
        _prewarmCts?.Cancel();
        _prewarmCts?.Dispose();
        _prewarmCts = null;

        _result = Result;
        if (_result is null) _showExplain = false;
        _explain = null;
        _explainLoading = false;

        if (_result is not null)
        {
            _prewarmCts = new CancellationTokenSource();
            _ = PrewarmAsync(_prewarmCts.Token);
        }
    }

    /// <summary>
    /// Warm the explain corpus after the card has settled. This is deliberately
    /// delayed so compilation and rendering finish first; opening Explain then
    /// does not pay the first-scan cost.
    /// </summary>
    private async Task PrewarmAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(500, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        if (token.IsCancellationRequested || _result is null || _showExplain) return;
        Engine.PrewarmExplain(ItemClass);
    }

    public void Dispose()
    {
        _prewarmCts?.Cancel();
        _prewarmCts?.Dispose();
    }

    private async Task ToggleExplain()
    {
        _showExplain = !_showExplain;
        if (!_showExplain || _result is null) return;
        if (_explain is not null) return;

        _explainLoading = true;
        StateHasChanged();
        try
        {
            _explain = await Engine.ExplainAsync(_result.Query, ItemClass);
        }
        finally
        {
            _explainLoading = false;
        }
    }

    private static string KindLabel(ExplainToken t) => t.Kind switch
    {
        "class" => "item class",
        "excluded" => "never on a match",
        "included" => "matches",
        _ => t.Kind,
    };

    private async Task Copy()
    {
        if (_result is null) return;
        try
        {
            _copyStatus = await JS.InvokeAsync<string>("poeRegexCopy", _result.Query);
        }
        catch
        {
            _copyStatus = "unavailable";
        }
    }
}
