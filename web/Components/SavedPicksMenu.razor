@using PoeRegex.Web.Core
@inject web.Services.PersistenceService Persistence
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="saved-picks" @onkeydown="OnKeyDown">
    <button type="button" class="btn" id="saved-picks-open" aria-expanded="@(_open ? "true" : "false")"
            aria-haspopup="dialog" @ref="_openButton" @onclick="Toggle">
        Saved picks
        @if (_savedPicks.Count > 0)
        {
            <span class="saved-picks-count">@_savedPicks.Count</span>
        }
    </button>
    <button type="button" class="btn" id="share-link" disabled="@(!HasPicks)"
            title="Copy a link that opens these picks in another browser" @onclick="Share">
        @(_shareState ?? "Copy share link")
    </button>
    @if (_open)
    {
        <div class="help-backdrop" @onclick="Close"></div>
        <div class="saved-picks-pop" role="dialog" aria-modal="true" aria-label="Saved picks"
             @ref="_dialog" @onkeydown="OnKeyDown">
            <form class="saved-picks-save" @onsubmit="Save">
                <input id="saved-pick-name" placeholder="Name these picks…" autocomplete="off" aria-label="Saved pick name"
                       maxlength="@SnapshotValidator.MaxSavedPickName" @ref="_nameInput"
                       value="@_name" @oninput="e => _name = e.Value?.ToString() ?? string.Empty" />
                <button type="submit" class="btn btn-primary" id="saved-pick-save" disabled="@(!HasPicks)">Save</button>
            </form>
            @if (_undo is { } undo)
            {
                <p class="saved-picks-undo" role="status">
                    @undo.Message
                    <button type="button" class="link" id="saved-pick-undo" @onclick="Undo">Undo</button>
                </p>
            }
            @if (_savedPicks.Count == 0)
            {
                <p class="more">No saved picks yet. Save your picks here to switch between setups.</p>
            }
            else
            {
                <ul class="saved-picks-list">
                    @foreach (var savedPick in _savedPicks)
                    {
                        <li class="saved-pick-row">
                            <span class="saved-pick-what">
                                <span class="saved-pick-name">@savedPick.Name</span>
                                <span class="saved-pick-meta">@ModeLabel(savedPick), @savedPick.PickCount @(savedPick.PickCount == 1 ? "mod" : "mods")</span>
                            </span>
                            <button type="button" class="btn" @onclick="() => Load(savedPick)">Load</button>
                            <button type="button" class="bd-x" title="@($"Delete {savedPick.Name}")" aria-label="@($"Delete {savedPick.Name}")"
                                    @onclick="() => Delete(savedPick)">×</button>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    /// <summary>Bump to make the menu reload the saved list (the page saved one itself).</summary>
    [Parameter]
    public int Version { get; set; }

    private sealed record UndoStep(string Message, List<SavedPick> SavedPicks, WorkbenchSnapshot? Picks);

    private const int MaxShareUrlLength = 8000;

    private List<SavedPick> _savedPicks = [];
    private bool _open;
    private string _name = "";
    private string? _shareState;
    private UndoStep? _undo;
    private int _loadedVersion = -1;
    private int _shareStamp;
    private bool _focusPending;
    private bool _restoreFocus;
    private bool _disposed;
    private ElementReference _openButton;
    private ElementReference _nameInput;
    private ElementReference _dialog;

    private bool HasPicks =>
        State.Global.Included.Count + State.Global.Excluded.Count + State.ExternalIncludes.Count > 0 ||
        State.Slots.Values.Any(c => c.Included.Count + c.Excluded.Count > 0);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedVersion == Version) return;
        _loadedVersion = Version;
        var savedPicks = await Persistence.LoadSavedPicksAsync();
        if (!_disposed) _savedPicks = savedPicks;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_open && _focusPending)
        {
            _focusPending = false;
            try
            {
                await JS.InvokeVoidAsync("poeRegexTrapFocus", _dialog);
                await _nameInput.FocusAsync();
            }
            catch
            {
                // JS unavailable: the dialog still works by mouse/keyboard.
            }
        }
        else if (!_open && _restoreFocus)
        {
            _restoreFocus = false;
            try { await _openButton.FocusAsync(); }
            catch { }
        }
    }

    private static string ModeLabel(SavedPick savedPick) =>
        savedPick.Snapshot.Mode == "advanced" ? "Per slot" : "All gear";

    private async Task Toggle()
    {
        if (_open)
        {
            Close();
            return;
        }
        _open = true;
        _undo = null;
        _focusPending = true;
        var savedPicks = await Persistence.LoadSavedPicksAsync();
        if (!_disposed) _savedPicks = savedPicks;
    }

    private void Close()
    {
        if (!_open) return;
        _open = false;
        _restoreFocus = true;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    public void Dispose() => _disposed = true;

    private async Task Save()
    {
        if (_disposed || !HasPicks) return;
        var name = _name.Trim();
        if (name.Length == 0) name = $"Saved pick {_savedPicks.Count + 1}";
        var before = _savedPicks.ToList();
        _savedPicks.RemoveAll(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase));
        _savedPicks.Insert(0, new SavedPick(name, DateTimeOffset.UtcNow, SnapshotCodec.CaptureCriteria(State)));
        await Persistence.SaveSavedPicksAsync(_savedPicks);
        if (_disposed) return;
        _undo = new UndoStep($"Saved “{name}”.", before, null);
        _name = "";
    }

    private void Load(SavedPick savedPick)
    {
        var before = SnapshotCodec.CaptureCriteria(State);
        WorkbenchSnapshot.RestoreCriteria(State, savedPick.Snapshot);
        _undo = new UndoStep($"Loaded “{savedPick.Name}”.", _savedPicks.ToList(), before);
    }

    private async Task Delete(SavedPick savedPick)
    {
        if (_disposed) return;
        var before = _savedPicks.ToList();
        _savedPicks.Remove(savedPick);
        await Persistence.SaveSavedPicksAsync(_savedPicks);
        if (_disposed) return;
        _undo = new UndoStep($"Deleted “{savedPick.Name}”.", before, null);
    }

    private async Task Undo()
    {
        if (_disposed || _undo is null) return;
        if (_undo.Picks is { } picks) WorkbenchSnapshot.RestoreCriteria(State, picks);
        _savedPicks = _undo.SavedPicks;
        await Persistence.SaveSavedPicksAsync(_savedPicks);
        if (!_disposed) _undo = null;
    }

    private async Task Share()
    {
        if (_disposed) return;
        var url = Nav.BaseUri + "#" + SnapshotCodec.FragmentPrefix +
                  SnapshotCodec.Encode(SnapshotCodec.CaptureCriteria(State));
        if (url.Length > MaxShareUrlLength)
        {
            await FlashShare("Link too long; save your picks instead");
            return;
        }
        try
        {
            var status = await JS.InvokeAsync<string>("poeRegexCopy", url);
            await FlashShare(status == "copied" ? "Link copied" : "Copy failed");
        }
        catch
        {
            await FlashShare("Copy failed");
        }
    }

    private async Task FlashShare(string state)
    {
        if (_disposed) return;
        var stamp = ++_shareStamp;
        _shareState = state;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2200);
        if (_disposed || stamp != _shareStamp) return;
        _shareState = null;
        await InvokeAsync(StateHasChanged);
    }
}
