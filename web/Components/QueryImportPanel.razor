@using PoeRegex.Core
@using PoeRegex.Web.Core
@inject EngineService Engine

@if (Open)
{
    <div class="dlg-overlay" id="query-import-dialog" @onclick="OnBackdrop">
        <div class="dlg" @onclick:stopPropagation="true" role="dialog" aria-label="Import search string"
             @onkeydown="OnDialogKeyDown">
            <div class="panel-head"><span>Import search string</span></div>
            <textarea id="query-import-text" rows="5"
                      placeholder="paste a generated search string…"
                      value="@_text" @oninput="OnInput" @onkeydown:stopPropagation="true"
                      aria-label="Search string"></textarea>
            <div class="modrow">
                <button id="query-import-parse" class="btn" @onclick="Parse">preview</button>
                <button id="query-import-apply" class="btn" disabled="@(!CanApply)" @onclick="Apply">
                    apply
                </button>
                <button id="query-import-cancel" class="btn" @onclick="Close">cancel</button>
            </div>

            @if (_result is null)
            {
                <div class="more">Paste a query generated by the app or another tool. Import is best-effort: unknown terms are preserved for review and are not applied.</div>
            }
            else
            {
                <div class="more" id="query-import-summary">
                    mode: @_result.Mode
                    @if (_result.Classes.Count > 0)
                    {
                        <span> · classes: @string.Join(", ", _result.Classes)</span>
                    }
                    <span> · @_result.Includes.Count include(s) · @_result.Excludes.Count exclude(s) · @_result.Keywords.Count unknown</span>
                </div>
                if (!CanApply)
                {
                    <div class="field-error" id="query-import-warning">
                        @WhyNotApply()
                    </div>
                }
                <div class="qexplain" id="query-import-tokens">
                    @foreach (var t in _result.Tokens)
                    {
                        <div>
                            @(t.Excluded ? "!" : "")"@t.Phrase"
                            [@t.Kind] @t.Confidence
                            @if (t.ModId is not null)
                            {
                                <span> · @t.ModId</span>
                            }
                            else if (t.Pattern is not null)
                            {
                                <span> · @t.Pattern</span>
                            }
                        </div>
                    }
                </div>
                @if (_result.Keywords.Count > 0)
                {
                    <div class="more" id="query-import-keywords">
                        unknown/custom: @string.Join(", ", _result.Keywords)
                    </div>
                }
                @foreach (var d in _result.Diagnostics)
                {
                    <div class="more">@d</div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter, EditorRequired]
    public required bool Open { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback OnClose { get; set; }

    private string _text = "";
    private QueryImportResult? _result;
    private QueryImportService? _service;

    private bool CanApply =>
        _result is not null &&
        _result.Mode is "simple" or "advanced" &&
        _result.Keywords.Count == 0 &&
        _result.Tokens.All(t => t.Confidence != "ambiguous");

    private void Parse()
    {
        _service ??= new QueryImportService(Engine);
        _result = _service.Import(_text);
    }

    private string WhyNotApply()
    {
        if (_result is null) return "";
        if (_result.Mode == "multi-class")
            return "multi-class import is preview-only; apply is not wired for slot groups yet";
        if (_result.Keywords.Count > 0)
            return "unknown/custom terms are present; remove them or import a fully catalog-backed query";
        if (_result.Tokens.Any(t => t.Confidence == "ambiguous"))
            return "one or more fragments map to multiple mods; edit the source query or choose explicitly";
        return "nothing importable was found";
    }

    private void Apply()
    {
        if (!CanApply || _result is null) return;
        var include = _result.Includes.Select(x => new WantedMod(x.Value)).ToList();
        var exclude = _result.Excludes.Select(x => x.Value).ToList();
        var targetSlot = _result.Mode == "advanced" ? SlotForClass(_result.Classes.FirstOrDefault()) : null;
        var classId = _result.Classes.FirstOrDefault();

        State.WithSuppressedNotifications(() =>
        {
            foreach (var slot in GearSlot.All)
                State.ClearChips(slot.Id);
            State.ClearChips(null);
            State.SetMode(_result.Mode);
            if (targetSlot is not null)
            {
                State.SetSlotClass(targetSlot, classId!);
                State.FocusSlot(targetSlot);
                State.AddIncludes(targetSlot, include);
                foreach (var id in exclude) State.AddExclude(targetSlot, id);
            }
            else
            {
                State.AddIncludes(null, include);
                foreach (var id in exclude) State.AddExclude(null, id);
            }
        });
        OnClose.InvokeAsync();
    }

    private string? SlotForClass(string? classId)
    {
        if (string.IsNullOrEmpty(classId)) return GearSlot.All[0].Id;
        var match = GearSlot.All.FirstOrDefault(s =>
            string.Equals(State.Slots[s.Id].ClassId, classId, StringComparison.Ordinal));
        return (match ?? GearSlot.All[0]).Id;
    }

    private void OnInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        _result = null;
    }

    private Task OnBackdrop() => Close();

    private async Task Close()
    {
        _result = null;
        await OnClose.InvokeAsync();
    }

    private async Task OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }
}
