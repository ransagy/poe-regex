@using PoeRegex.Core
@using PoeRegex.Web.Core
@inject EngineService Engine

@if (Open)
{
    <div class="dlg-overlay" id="query-import-dialog" @onclick="OnBackdrop">
        <div class="dlg" @onclick:stopPropagation="true" role="dialog" aria-label="Import search string"
             @onkeydown="OnDialogKeyDown">
            <h2 class="panel-head">@(_guideMode ? "Import a guide filter" : "Import a search string")</h2>
            <div class="logic-seg" role="group" aria-label="Import source">
                <button type="button" id="query-import-mode-app" class="@(_guideMode ? "" : "on")"
                        aria-pressed="@(_guideMode ? "false" : "true")"
                        @onclick="() => SetGuideMode(false)">App string</button>
                <button type="button" id="query-import-mode-guide" class="@(_guideMode ? "on" : "")"
                        aria-pressed="@(_guideMode ? "true" : "false")"
                        @onclick="() => SetGuideMode(true)">Guide filter</button>
            </div>
            <textarea id="query-import-text" rows="5"
                      placeholder="@(_guideMode ? "Paste a build-guide filter…" : "Paste a search string…")"
                      value="@_text" @oninput="OnInput" @onkeydown:stopPropagation="true"
                      aria-label="Search string"></textarea>
            <div class="modrow">
                <button id="query-import-parse" class="btn" disabled="@_busy" @onclick="Parse">
                    @(_busy ? "Reading…" : "Preview")
                </button>
                <button id="query-import-apply" class="btn btn-primary" disabled="@(_busy || !CanApply)" @onclick="Apply">
                    Apply
                </button>
                <button id="query-import-cancel" class="btn" @onclick="Close">Cancel</button>
            </div>

            @if (_busy)
            {
                <div class="more" id="query-import-busy" aria-live="polite">Reading the string…</div>
            }
            else if (_guideMode && _guideResult is not null)
            {
                <div class="more" id="query-import-summary">
                    guide: @_guideResult.Mapped of @_guideResult.Branches.Count branch(es) mapped
                    · @_guideResult.Dropped dropped
                </div>
                <div id="query-import-guide-branches">
                    @foreach (var branch in _guideResult.Branches)
                    {
                        <div class="guide-branch" data-branch="@branch.Index">
                            <code>@branch.Text</code>
                            <span class="qexplain-kind">@branch.Kind</span>
                            @if (branch.Kind == GuideBranchKind.MultiFamily)
                            {
                                <select id="guide-branch-@branch.Index" value="@branch.Selected"
                                        aria-label="@($"Family for {branch.Text}")"
                                        @onchange="e => OnGuideCandidate(branch.Index, e)">
                                    @foreach (var candidate in branch.Candidates)
                                    {
                                        <option value="@candidate.Key" selected="@(candidate.Key == branch.Selected)">
                                            @candidate.Label
                                        </option>
                                    }
                                </select>
                            }
                            else if (branch.Selected is not null)
                            {
                                <span>→ @branch.Selected</span>
                            }
                            else if (branch.Picks.Count > 0)
                            {
                                <span>→ @branch.Picks.Count pick(s)</span>
                            }
                        </div>
                    }
                </div>
                @if (_guideResult.CompiledQuery is not null)
                {
                    <div class="more">compiled: <code>@_guideResult.CompiledQuery</code></div>
                }
                @if (!CanApply)
                {
                    <div class="field-error" id="query-import-warning">
                        @(_guideResult.Warnings.FirstOrDefault() ?? "nothing importable was found")
                    </div>
                }
                else if (_previewModel is not null && _previewState is not null)
                {
                    <div id="query-import-preview">
                        <PickBreakdown Model="_previewModel" State="_previewState"
                                       ReadOnly="true" Title="Your picks · after apply" />
                    </div>
                }
                @foreach (var warning in _guideResult.Warnings)
                {
                    <div class="more">@warning</div>
                }
            }
            else if (_result is null)
            {
                <div class="more">@(_guideMode
                    ? "Paste a build-guide filter. Branches this app can map become picks; the rest are reported and dropped."
                    : "Paste a search string this app produced. Picks it cannot place are reported and left out.")</div>
            }
            else
            {
                <div class="more" id="query-import-summary">
                    mode: @_result.Mode
                    @foreach (var slot in _result.Slots)
                    {
                        <span> · @slot.SlotId@(string.IsNullOrEmpty(slot.ClassId) ? "" : $" ({slot.ClassId})"): @slot.Includes.Count pick(s)</span>
                    }
                    <span> · @_result.Excludes.Count exclude(s)</span>
                </div>
                if (!CanApply)
                {
                    <div class="field-error" id="query-import-warning">
                        @(_result.Diagnostics.FirstOrDefault() ?? "nothing importable was found")
                    </div>
                }
                else if (_previewModel is not null && _previewState is not null)
                {
                    <div id="query-import-preview">
                        <PickBreakdown Model="_previewModel" State="_previewState"
                                       ReadOnly="true" Title="Your picks · after apply" />
                    </div>
                }
                @foreach (var warning in _result.Warnings)
                {
                    <div class="more">@warning</div>
                }
                @foreach (var d in _result.Diagnostics)
                {
                    <div class="more">@d</div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter, EditorRequired]
    public required bool Open { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback OnClose { get; set; }

    private string _text = "";
    private ReconstructedWorkbench? _result;
    private QueryReconstructionService? _service;
    private GuideImportService? _guideService;
    private GuideImportResult? _guideResult;
    private bool _guideMode;
    private readonly Dictionary<int, string> _guideOverrides = [];
    private WorkbenchState? _previewState;
    private SearchModel? _previewModel;
    private bool _busy;
    private int _parseVersion;

    private bool CanApply => _result?.Ok == true;

    private async Task Parse()
    {
        if (_busy) return;
        var version = ++_parseVersion;
        _busy = true;
        _result = null;
        _previewState = null;
        _previewModel = null;
        StateHasChanged();
        // Let the busy state paint before a cold index build blocks the WASM thread.
        await Task.Delay(1);
        try
        {
            _service ??= new QueryReconstructionService(Engine);
            if (_guideMode)
            {
                _guideService ??= new GuideImportService(Engine, _service);
                var guide = _guideService.Import(_text, _guideOverrides);
                if (version != _parseVersion) return;
                _guideResult = guide;
                _result = guide.Workbench;
                if (_result is { Ok: true }) BuildPreview(_result);
            }
            else
            {
                _guideResult = null;
                var result = _service.ReconstructWorkbench(_text);
                if (version != _parseVersion) return;
                _result = result;
                if (result.Ok) BuildPreview(result);
            }
        }
        catch (Exception ex)
        {
            if (version != _parseVersion) return;
            _result = ReconstructedWorkbench.Failed("preview failed: " + ex.Message);
        }
        finally
        {
            if (version == _parseVersion) _busy = false;
        }
    }

    /// <summary>
    /// Applies to a throwaway clone and renders the real Your-picks view, so
    /// the preview can never drift from what Apply will produce.
    /// </summary>
    private void BuildPreview(ReconstructedWorkbench result)
    {
        var preview = new WorkbenchState();
        WorkbenchSnapshot.RestoreCriteria(preview, WorkbenchSnapshot.Capture(State));
        result.ApplyTo(preview);
        _previewState = preview;
        _previewModel = new SearchModel(Engine, preview);
        var (simple, paste) = SearchModel.CompileForStrip(Engine, preview);
        _previewModel.Update(simple, paste);
    }

    private void Apply()
    {
        if (!CanApply || _result is null) return;
        _result.ApplyTo(State);
        OnClose.InvokeAsync();
    }

    private void OnInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        _parseVersion++;
        _busy = false;
        _result = null;
        _guideResult = null;
        _guideOverrides.Clear();
        _previewState = null;
        _previewModel = null;
    }

    private void SetGuideMode(bool guide)
    {
        if (_guideMode == guide) return;
        _guideMode = guide;
        _parseVersion++;
        _busy = false;
        _result = null;
        _guideResult = null;
        _guideOverrides.Clear();
        _previewState = null;
        _previewModel = null;
    }

    private async Task OnGuideCandidate(int index, ChangeEventArgs e)
    {
        _guideOverrides[index] = e.Value?.ToString() ?? "";
        await Parse();
    }

    private Task OnBackdrop() => Close();

    private async Task Close()
    {
        _parseVersion++;
        _busy = false;
        _result = null;
        _guideResult = null;
        _guideOverrides.Clear();
        _previewState = null;
        _previewModel = null;
        await OnClose.InvokeAsync();
    }

    private async Task OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }
}
