@using Microsoft.AspNetCore.Components.Web

@* A small (?) that opens a readable card — click to open, click outside or
   press Escape to close. Used sparingly: one per region that needs more than
   a label can say. *@
<span class="help @Class">
    <button type="button" class="help-btn" @ref="_button" title="@Title" aria-expanded="@_open"
            aria-label="@Title" @onclick="Toggle">?</button>
    @if (_open)
    {
        <div class="help-backdrop" @onclick="Close"></div>
        <div class="help-pop" @ref="_pop" tabindex="-1" @onkeydown="OnKeyDown">
            @ChildContent
        </div>
    }
</span>

@code {
    [Parameter] public string Title { get; set; } = "what is this?";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open;
    private bool _focusPending;
    private bool _restoreFocus;
    private ElementReference _pop;
    private ElementReference _button;

    private void Toggle()
    {
        _open = !_open;
        if (_open) _focusPending = true;
    }

    private void Close()
    {
        if (!_open) return;
        _open = false;
        _restoreFocus = true;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending)
        {
            _focusPending = false;
            try { await _pop.FocusAsync(); }
            catch { /* element already gone */ }
        }
        else if (_restoreFocus)
        {
            _restoreFocus = false;
            try { await _button.FocusAsync(); }
            catch { /* trigger already gone */ }
        }
    }
}
