@* First-run explanation. Inline, dismissible, and deliberately small: the
   workbench is dense enough without a modal on arrival. *@
<div class="intro-card" id="intro-card" role="region" aria-label="What this app does">
    <div class="intro-copy">
        <div class="intro-title">What is this?</div>
        <ul class="intro-goals">
            <li><b>Exact item searches.</b> Build a search that shows exactly the items you want and nothing else — including different mods per gear slot.</li>
            <li><b>Shortest results.</b> Keep the search string as short as possible, so more mods fit in the game's 250-character box.</li>
        </ul>
        <div class="intro-note">Pick mods, copy the quoted string, then paste it into the in-game Highlight item search.</div>
    </div>
    <button type="button" class="btn intro-dismiss" id="intro-dismiss" @onclick="Dismiss">got it</button>
</div>

@code {
    [Parameter] public EventCallback OnDismiss { get; set; }

    private Task Dismiss() => OnDismiss.InvokeAsync();
}
