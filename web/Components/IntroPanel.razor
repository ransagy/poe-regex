@* First-run explanation. Inline, dismissible, and deliberately small: the
   workbench is dense enough without a modal on arrival. *@
<div class="intro-card" id="intro-card" role="region" aria-label="What this app does">
    <div class="intro-copy">
        <div class="intro-title">What is this?</div>
        <p class="intro-lead">It turns the mods you want into one short search string ready to be pasted in-game.</p>
        <ul class="intro-goals">
            <li><b>Exact matches.</b> Find just the gear you want, not everything with the same words.</li>
            <li><b>More mods.</b> Keeps the string short so more mods fit inside the game's limit.</li>
        </ul>
    </div>
    <button type="button" class="btn intro-dismiss" id="intro-dismiss" @onclick="Dismiss">got it</button>
</div>

@code {
    [Parameter] public EventCallback OnDismiss { get; set; }

    private Task Dismiss() => OnDismiss.InvokeAsync();
}
