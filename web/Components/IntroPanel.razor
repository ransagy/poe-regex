<div class="intro-card" id="intro-card" role="region" aria-label="How this works">
    <div class="intro-head">
        <h2 class="intro-title">How it works</h2>
        <button type="button" class="link" id="intro-dismiss" @onclick="Dismiss">Hide</button>
    </div>
    <ol class="intro-steps">
        <li>Add the mods you want. <b>Per slot</b> gives each gear slot its own list.</li>
        <li>Copy the search string.</li>
        <li>Paste it into the Highlight box at your stash or a vendor. Matching items light up.</li>
    </ol>
</div>

@code {
    [Parameter] public EventCallback OnDismiss { get; set; }

    private Task Dismiss() => OnDismiss.InvokeAsync();
}
