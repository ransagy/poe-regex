@using PoeRegex.Web.Core

<div class="seg" role="group" aria-label="Search mode">
    @foreach (var (mode, label, blurb) in Options)
    {
        var active = State.Mode == mode;
        <button id="mode-@mode" type="button" class="seg-opt @(active ? "active" : "")"
                title="@blurb" aria-pressed="@(active ? "true" : "false")"
                @onclick="() => State.SetMode(mode)">@label</button>
    }
</div>
<span class="seg-note">@Options.First(o => o.Mode == State.Mode).Blurb</span>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    private static readonly (string Mode, string Label, string Blurb)[] Options =
    [
        ("simple", "All gear", "One list of mods for every item"),
        ("advanced", "Per slot", "A separate list of mods for each gear slot"),
    ];
}
