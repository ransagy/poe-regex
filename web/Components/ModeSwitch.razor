@using PoeRegex.Web.Core

<div class="mode-switch @(Vertical ? "vertical" : "")" role="group" aria-label="Slot mode">
    @foreach (var mode in new[] { "global", "single", "multi" })
    {
        <button id="mode-@mode"
                class="mode-btn @(State.Mode == mode ? "active" : "")"
                aria-pressed="@(State.Mode == mode)"
                @onclick="() => State.SetMode(mode)">
            @mode
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter]
    public bool Vertical { get; set; }
}
