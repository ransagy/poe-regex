@using PoeRegex.Web.Core

@* Two stacked options instead of a segmented row: each states what the mode
   means, so no separate explanation is needed. *@
<div class="mode-stack" role="group" aria-label="Search mode">
    @foreach (var (mode, label, blurb) in Options)
    {
        var active = State.Mode == mode;
        <button id="mode-@mode" class="mode-opt @(active ? "active" : "")"
                title="@blurb" aria-pressed="@active"
                @onclick="() => State.SetMode(mode)">
            <span class="mode-dot" aria-hidden="true"></span>
            <span class="mode-name">@label</span>
            <span class="mode-blurb">@blurb</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    private static readonly (string Mode, string Label, string Blurb)[] Options =
    [
        ("simple", "Simple", "same mods for every item"),
        ("advanced", "Advanced", "different mods per slot"),
    ];
}
