@using web.Services
@inject GameSession Games
@implements IDisposable

<div class="seg game-switch" role="group" aria-label="Game">
    <button type="button" id="game-poe2" class="seg-opt @(Games.Current == "poe2" ? "active" : "")"
            aria-pressed="@(Games.Current == "poe2" ? "true" : "false")"
            disabled="@Games.IsLoading" @onclick='() => Switch("poe2")'>PoE 2</button>
    <button type="button" id="game-poe1" class="seg-opt @(Games.Current == "poe1" ? "active" : "")"
            aria-pressed="@(Games.Current == "poe1" ? "true" : "false")"
            disabled="@Games.IsLoading" @onclick='() => Switch("poe1")'>PoE 1</button>
</div>
@if (Games.IsLoading)
{
    <span class="seg-note">Loading game data…</span>
}
else if (Games.Error is { } error)
{
    <span class="seg-note game-error">@error</span>
}

@code {
    protected override void OnInitialized() => Games.Changed += OnGameChanged;

    private void OnGameChanged() => InvokeAsync(StateHasChanged);

    private async Task Switch(string game)
    {
        await Games.SwitchAsync(game);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Games.Changed -= OnGameChanged;
}
