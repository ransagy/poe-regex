@using PoeRegex.Core.Data
@using PoeRegex.Web.Core
@inject EngineService Engine
@inject IJSRuntime JS

<div class="modpicker">
    @{
        var crit = ScopeCriteria();
    }
    @if (crit.Included.Count + crit.Excluded.Count > 0)
    {
        <div class="chips-row" id="@RailRowId">
            <button type="button" class="chips-more start" data-dir="-1" aria-label="show earlier picks" disabled>
                <span class="dir" aria-hidden="true">‹</span><span class="n">+0</span>
            </button>
            <div class="chips" aria-label="Wanted mods">
                @foreach (var inc in crit.Included)
                {
                    <button class="chip inc @(inc.IsNamePick ? "by-name" : "")" id="chip-inc-@Scope-@ChipKey(inc)"
                            title="@ChipTitle(inc)" @onclick="() => State.RemoveInclude(Scope, inc)">
                        @ChipLabel(inc)
                    </button>
                }
                @foreach (var exc in crit.Excluded)
                {
                    <button class="chip exc" id="chip-exc-@Scope-@exc" title="remove"
                            @onclick="() => State.RemoveExclude(Scope, exc)">
                        !@DisplayFor(exc)
                    </button>
                }
            </div>
            <button type="button" class="chips-more end" data-dir="1" aria-label="show later picks" disabled>
                <span class="n">+0</span><span class="dir" aria-hidden="true">›</span>
            </button>
            <button class="chip clear" id="chips-clear-@Scope" @onclick="() => State.ClearChips(Scope)">clear</button>
        </div>
    }

    <div class="modrow">
        @* The add-all button is the filter's right edge; it only exists
           while a filter is typed (matching every family is not a workflow). *@
        <div class="search-unit">
            <input id="mod-search" placeholder="type to filter mods…" value="@_search"
                   @oninput="OnSearch" aria-label="Filter mods" />
            @if (_bulkVisible)
            {
                <button id="suggest-all" title="@BulkTitle()" aria-label="@BulkTitle()"
                        disabled="@_bulkOverflow" @onclick="SelectAll">++</button>
            }
        </div>
    </div>

    @if (_families.Count == 0)
    {
        <div class="more">no mods match the filter</div>
    }
    <div class="mod-list">
        <ol class="suggest" aria-label="Mods">
            @foreach (var fam in _families.Take(MaxShown))
            {
                var plainPick = new WantedMod(fam.Anchor.Id);
                var pickedPlain = crit.Included.Any(m => m.SamePick(plainPick));
                var expanded = _search.Trim().Length > 0 || _expanded.Contains(fam.Key);
                <li class="fam-block">
                    <div class="suggest-row fam-row">
                        <span class="gen-tag">@(fam.IsPrefix ? "PREFIX" : "SUFFIX")</span>
                        <button class="suggest-line fam-toggle" id="fam-toggle-@fam.Anchor.Id"
                                aria-expanded="@(expanded ? "true" : "false")"
                                title="@(expanded ? "collapse" : $"expand {fam.Tiers.Count} tier(s)")"
                                @onclick="() => Toggle(fam.Key)">
                            <span class="fam-caret" aria-hidden="true">@(expanded ? "▾" : "▸")</span>
                            <span class="fam-text @(fam.DisplayLines.Count > 1 ? "multi" : "")">
                                @if (fam.DisplayLines.Count == 1)
                                {
                                    @fam.DisplayLines[0]
                                }
                                else
                                {
                                    foreach (var fl in fam.DisplayLines)
                                    {
                                        <span class="mod-line">@fl</span>
                                    }
                                }
                            </span>
                            <span class="tier-count" title="@fam.Tiers.Count tier(s)">@fam.Tiers.Count</span>
                        </button>
                        <button id="pick-inc-@fam.Anchor.Id" title="include this stat (any tier)"
                                disabled="@pickedPlain"
                                @onclick="() => Include(plainPick)">+</button>
                        <button id="pick-exc-@fam.Anchor.Id" title="exclude this stat (any tier)"
                                @onclick="() => AddExclude(fam.Anchor.Id)">−</button>
                    </div>
                    @if (expanded)
                    {
                        <ul class="tier-list">
                            @foreach (var tier in fam.Tiers)
                            {
                                var exactPick = new WantedMod(tier.Anchor.Id, [tier.Name]);
                                var upNames = fam.NamesFrom(tier);
                                var upPick = new WantedMod(tier.Anchor.Id, upNames);
                                var pickedExact = crit.Included.Any(m => m.SamePick(exactPick));
                                var pickedUp = crit.Included.Any(m => m.SamePick(upPick));
                                <li class="suggest-row tier-row">
                                    <span class="tier-name" title="@tier.Name">@(tier.Name.Length > 0 ? tier.Name : tier.Anchor.Id)</span>
                                    <span class="suggest-line multi" title="@string.Join("\n", tier.DisplayLines)">
                                        @foreach (var l in tier.DisplayLines)
                                        {
                                            <span class="mod-line">@l</span>
                                        }
                                    </span>
                                    <button id="pick-tier-@tier.Anchor.Id" title="@TierPickTitle(tier)"
                                            disabled="@pickedExact"
                                            @onclick="() => Include(exactPick)">+</button>
                                    @if (upNames.Count > 1)
                                    {
                                        <button id="pick-tier-up-@tier.Anchor.Id" title="@TierUpTitle(tier, upNames)"
                                                disabled="@pickedUp"
                                                @onclick="() => Include(upPick)">↑</button>
                                    }
                                    <button id="pick-tier-exc-@tier.Anchor.Id" title="@TierExcludeTitle(tier)"
                                            @onclick="() => AddExclude(tier.Name)">−</button>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ol>
    </div>
    @if (_families.Count > MaxShown)
    {
        <div class="more">@(_families.Count - MaxShown) more… keep typing to narrow</div>
    }
</div>

@code {
    private const int MaxShown = 50;

    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    /// <summary>Scope the chips belong to: a slot id, or null for global.</summary>
    [Parameter]
    public string? Scope { get; set; }

    /// <summary>Typeahead source for the current scope (slot class, union, or all).</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<ModEntry> Mods { get; set; }

    private string _search = "";
    private IReadOnlyList<ModFamily> _allFamilies = [];
    private IReadOnlyList<ModFamily> _families = [];
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private bool _bulkVisible;
    private bool _bulkOverflow;
    private int _bulkNew;
    private int _bulkLength;
    private int _bulkLimit;

    private string RailRowId => $"chips-row-{Scope ?? "global"}";

    /// <summary>Item class the scope compiles with (null in global mode).</summary>
    private string? ScopeClassId => Scope is null ? null : State.CriteriaFor(Scope).ClassId;

    protected override void OnParametersSet() => Refresh();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var crit = ScopeCriteria();
        if (crit.Included.Count + crit.Excluded.Count == 0) return;
        try
        {
            await JS.InvokeVoidAsync("poeRegexChipsSync", RailRowId);
        }
        catch
        {
            // No JS yet (static render) — the next interactive render syncs.
        }
    }

    private SlotCriteria ScopeCriteria() => State.CriteriaFor(Scope);

    private void Refresh()
    {
        _allFamilies = ModFamilies.Group(Mods);
        var filter = _search.Trim();
        _families = filter.Length == 0
            ? _allFamilies
            : _allFamilies
                .Select(f => f with
                {
                    Tiers = f.Tiers
                        .Where(t => ModSearch.FilterMods(t.Members, filter).Count > 0).ToList(),
                })
                .Where(f => f.Tiers.Count > 0)
                .ToList();
        UpdateBulk();
    }

    /// <summary>
    /// The add-all button exists only while a filter is typed; it is disabled
    /// when adding every match would push the compiled query over the game's
    /// character limit (previewed with allowOverflow — never throws).
    /// </summary>
    private void UpdateBulk()
    {
        _bulkVisible = false;
        _bulkOverflow = false;
        _bulkNew = 0;
        if (_search.Trim().Length == 0 || _families.Count == 0) return;
        var crit = ScopeCriteria();
        var picks = _families.Select(f => new WantedMod(f.Anchor.Id)).ToList();
        _bulkNew = picks.Count(p => !crit.Included.Any(m => m.SamePick(p)));
        if (_bulkNew < 2) return; // one match: the row's own + is the action
        var preview = SlotBudget.Preview(Engine, crit, ScopeClassId, picks);
        _bulkLength = preview.Length;
        _bulkLimit = preview.Limit;
        _bulkOverflow = preview.Exceeded;
        _bulkVisible = true;
    }

    private string BulkTitle()
    {
        var already = _families.Count - _bulkNew;
        var what = already > 0
            ? $"add all {_bulkNew} matching families ({already} already added)"
            : $"add all {_bulkNew} matching families";
        return _bulkOverflow
            ? $"{what} — would exceed the game's character limit ({_bulkLength}/{_bulkLimit}); narrow the filter"
            : $"{what} ({_bulkLength}/{_bulkLimit} characters)";
    }

    private void Toggle(string key)
    {
        if (!_expanded.Add(key)) _expanded.Remove(key);
    }

    /// <summary>Plain picks show the family's unioned stat text (what they
    /// match, any tier); name picks show the quoted affix name(s).</summary>
    private string DisplayFor(string modId)
    {
        var mod = Mods.FirstOrDefault(m => m.Id == modId);
        if (mod is null) return modId;
        var fam = _allFamilies.FirstOrDefault(f => f.Key == ModFamilies.KeyOf(mod));
        return fam?.DisplayText
               ?? (mod.StatLines.Count > 0 ? ModSearch.DisplayLine(mod.StatLines[0]) : mod.Id);
    }

    private string ChipKey(WantedMod pick) =>
        pick.IsNamePick ? $"{pick.ModId}-n{pick.Names!.Count}" : pick.ModId;

    private string ChipLabel(WantedMod pick) =>
        pick.IsNamePick
            ? (pick.Names!.Count == 1 ? $"\"{pick.Names[0]}\"" : $"\"{pick.Names[0]}\" +{pick.Names.Count - 1}")
            : DisplayFor(pick.ModId);

    private string ChipTitle(WantedMod pick) =>
        pick.IsNamePick
            ? pick.Names!.Count == 1
                ? $"remove \"{pick.Names[0]}\""
                : $"remove ({string.Join(", ", pick.Names)})"
            : "remove (any tier)";

    // Titles are built here, not as markup entities: Blazor sets attributes
    // through DOM APIs, so a literal `&quot;` would show verbatim.
    private static string TierPickTitle(ModTier tier) =>
        $"include \"{tier.Name}\"";

    private static string TierUpTitle(ModTier tier, IReadOnlyList<string> names) =>
        $"include \"{tier.Name}\" and better: {string.Join(", ", names.Where(n => !string.Equals(n, tier.Name, StringComparison.Ordinal)))}";

    private static string TierExcludeTitle(ModTier tier) =>
        $"exclude \"{tier.Name}\"";

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        Refresh();
    }

    private void Include(WantedMod pick)
    {
        State.AddInclude(Scope, pick);
        Refresh();
    }

    private void AddExclude(string term)
    {
        State.AddExclude(Scope, term);
        Refresh();
    }

    /// <summary>Adds every family matching the filter in one notification and
    /// leaves the filter in place. The rail keeps its scroll position (picks
    /// append, so nothing shifts); the pagers reveal what is off-screen.</summary>
    private void SelectAll()
    {
        if (_bulkOverflow) return;
        State.AddIncludes(Scope, _families.Select(f => new WantedMod(f.Anchor.Id)));
        Refresh();
    }
}
