@using PoeRegex.Core.Data
@using PoeRegex.Web.Core
@inject EngineService Engine

<div class="modpicker" id="modpicker-@(Scope ?? "global")">
    @{
        var crit = ScopeCriteria();
    }
    <div class="modrow">
        @* The add-all button is the filter's right edge; it only exists
           while a filter is typed (matching every family is not a workflow). *@
        <div class="search-unit">
            <div class="search-field @(_search.Length > 0 ? "has-clear" : "")">
                <input id="mod-search" placeholder="@_placeholder" value="@_search"
                       @oninput="OnSearch" aria-label="Filter mods" @ref="_searchInput" />
                @if (_search.Length > 0)
                {
                    <button type="button" id="mod-search-clear" class="search-clear"
                            title="Clear filter" aria-label="Clear filter"
                            @onclick="ClearSearch"><span aria-hidden="true">×</span></button>
                }
            </div>
            @if (_bulkVisible)
            {
                <button id="suggest-all" title="@BulkTitle()" aria-label="@BulkTitle()"
                        disabled="@(_bulkOverflow || _bulkTooMany)" @onclick="SelectAll">Add all @_bulkNew</button>
            }
        </div>
    </div>

    <div class="mod-scope">
        <span>@ScopeSummary</span>
        <span class="mod-scope-actions">
            @if (ShowScopeToggle)
            {
                <button type="button" class="link" id="mod-show-all" @onclick="ToggleShowAll">
                    @(_showAll ? "Show common only" : "Show all mods")
                </button>
            }
            <HelpTip Title="Mod search and picker limitations" Class="help-fixed">
                <p>Some mods list several effects, but the game can search only one effect line at a time. The picker uses the best line, so a search can also match other mods that share that line.</p>
                <p>When two rows share a search, one is selected (✓). A covered row uses ⇄ to switch to that mod instead.</p>
                <p>Duplicate mods are merged: if the same effect already exists as a normal mod, the duplicate version from another source is omitted.</p>
            </HelpTip>
        </span>
    </div>
    <div class="glyph-legend" aria-label="Picker symbol legend">
        <span class="legend-add"><b>+</b> Add</span>
        <span class="legend-picked"><b>✓</b> Selected</span>
        <span class="legend-switch" title="Switches a pick; red switches an exclusion"><b>⇄</b> Switch</span>
        <span class="legend-exclude"><b>−</b> Exclude</span>
        <span class="legend-excluded"><b>⊘</b> Excluded</span>
        <span class="legend-better"><b>≥</b> Better</span>
        <span class="legend-covered"><b>covered</b> by an existing pick</span>
    </div>
    @if (_families.Count == 0)
    {
        <div class="more">@(_search.Trim().Length == 0
            ? _placeholder
            : $"No mods match \"{_search.Trim()}\".")</div>
    }
    else
    {
        <div class="mod-list">
            @{
                (IReadOnlyList<ModFamily> List, string Header, string Css)[] sections =
                    [(_augments, "Augments", "augment-sec"),
                     (_implicits, "Implicits", "implicit-sec"),
                     (_corrupted, "Corrupted", "corrupted-sec"),
                     (_prefixes, "Prefixes", ""),
                     (_suffixes, "Suffixes", "")];
                var twoCols = _prefixes.Count > 0 && _suffixes.Count > 0;
            }
            <div class="mod-cols @(twoCols ? "" : "single")">
                @foreach (var (list, header, css) in sections)
                {
                    if (list.Count == 0) continue;
                    <section class="mod-sec @css">
                        <div class="gen-head">@header</div>
                        <ol class="suggest" aria-label="@header">
                            @foreach (var fam in list)
                            {
                                var familyClaim = crit.Included.Count == 0
                                    ? null
                                    : FamilyClaim(fam, crit);
                                var familyClaimTouches = familyClaim is not null &&
                                    FamilyPicked(fam, [familyClaim]);
                                var familyClaimed = familyClaim is not null &&
                                    FamilyPicks(fam, [familyClaim]).Count > 0;
                                var familyRowPicked = familyClaimTouches ||
                                    FamilyPicked(fam, crit.Included);
                                // A tier pick does not own the family-level
                                // claim. Keep the covered state so the family
                                // include action still offers the switch.
                                var coveredClaim = familyClaim is not null &&
                                    !familyClaimTouches;
                                var coveredClaimLabel = coveredClaim ? ClaimLabel(familyClaim!) : null;
                                var excludedFamily = crit.Excluded.Count > 0 &&
                                    FamilyExcludedClaim(fam, crit.Excluded);
                                var excludedHere = crit.Excluded.Count > 0 &&
                                    FamilyExclusionTerms(fam, crit.Excluded).Count > 0;
                                var excludedCovered = excludedFamily && !excludedHere;
                                var pickedTiers = fam.Tiers.Count(t =>
                                    crit.Included.Any(m => TierPicked(t, m)));
                                var excludedTiers = fam.Tiers.Count(t =>
                                    TierExcluded(fam, t, crit.Excluded));
                                var expanded = _expanded.Contains(fam.Key) || _autoExpanded.Contains(fam.Key);
                                // Soul Cores and Abyssal Eyes are one-row augments: a
                                // caret/"1 tier" control adds noise and no information.
                                var singleTierAugment = fam.IsAugmentLike && fam.Tiers.Count == 1;
                                var collapsed = singleTierAugment ||
                                    (CanCollapse(fam) && !HasTierLevelState(fam, crit));
                                var displayLines = collapsed ? TierLines(fam, fam.Tiers[0]) : fam.DisplayLines;
                                var displayTag = fam.SourceTag;
                                <li class="fam-block">
                                    <div class="suggest-row fam-row @(familyRowPicked ? "picked" : "") @(coveredClaim ? "covered" : "") @(excludedFamily ? "excluded" : "")">
                                        @if (collapsed)
                                        {
                                            <span class="suggest-line fam-text @(displayLines.Count > 1 ? "multi" : "")">
                                                @if (displayLines.Count == 1)
                                                {
                                                    @displayLines[0]
                                                }
                                                else
                                                {
                                                    foreach (var fl in displayLines)
                                                    {
                                                        <span class="mod-line">@fl</span>
                                                    }
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="suggest-line fam-toggle" id="fam-toggle-@fam.Anchor.Id"
                                                    aria-expanded="@(expanded ? "true" : "false")"
                                                    title="@FamilyToggleTitle(fam, expanded)"
                                                    @onclick="() => Toggle(fam.Key)">
                                                <span class="fam-caret" aria-hidden="true">@(expanded ? "▾" : "▸")</span>
                                                <span class="fam-text @(displayLines.Count > 1 ? "multi" : "")">
                                                    @if (displayLines.Count == 1)
                                                    {
                                                        @displayLines[0]
                                                    }
                                                    else
                                                    {
                                                        foreach (var fl in displayLines)
                                                        {
                                                            <span class="mod-line">@fl</span>
                                                        }
                                                    }
                                                </span>
                                                <span class="tier-count">@fam.Tiers.Count tiers</span>
                                            </button>
                                        }
                                        @if (coveredClaim || displayTag is not null ||
                                             (!collapsed && (pickedTiers > 0 || excludedTiers > 0)))
                                        {
                                            <span class="fam-status">
                                                @if (coveredClaim)
                                                {
                                                    <span class="covered-note" title="@CoveredTitle(coveredClaimLabel)">covered</span>
                                                }
                                                @if (!collapsed && pickedTiers > 0)
                                                {
                                                    <span class="picked-count" title="@($"{pickedTiers} {(pickedTiers == 1 ? "tier" : "tiers")} picked in this family")">@pickedTiers picked</span>
                                                }
                                                @if (!collapsed && pickedTiers > 0 && excludedTiers > 0)
                                                {
                                                    <span class="summary-sep" aria-hidden="true">·</span>
                                                }
                                                @if (!collapsed && excludedTiers > 0)
                                                {
                                                    <span class="excluded-count" title="@($"{excludedTiers} {(excludedTiers == 1 ? "tier" : "tiers")} excluded in this family")">@excludedTiers excluded</span>
                                                }
                                                @if (displayTag is not null)
                                                {
                                                    <span class="mod-source @fam.SourceCssClass">@displayTag</span>
                                                }
                                            </span>
                                        }
                                        <button id="pick-inc-@fam.Anchor.Id" class="inc @(familyClaimed ? "active" : "") @(coveredClaim ? "switch" : "")"
                                                title="@FamilyIncludeActionTitle(fam, familyClaimed, coveredClaimLabel)"
                                                aria-label="@FamilyIncludeActionTitle(fam, familyClaimed, coveredClaimLabel)"
                                                aria-pressed="@(familyClaimed ? "true" : "false")"
                                                @onclick="() => ToggleFamilyInclude(fam)">@(familyClaimed ? "✓" : coveredClaim ? "⇄" : "+")</button>
                                        <button id="pick-exc-@fam.Anchor.Id" class="exc @(excludedHere ? "active" : "") @(excludedCovered ? "switch" : "")"
                                                title="@FamilyExcludeActionTitle(fam, excludedHere, excludedCovered)"
                                                aria-label="@FamilyExcludeActionTitle(fam, excludedHere, excludedCovered)"
                                                aria-pressed="@(excludedHere ? "true" : "false")"
                                                @onclick="() => ToggleFamilyExclude(fam)">@(excludedHere ? "⊘" : excludedCovered ? "⇄" : "−")</button>
                                    </div>
                                    @if (expanded && !collapsed)
                                    {
                                        <ul class="tier-list">
                                            @foreach (var tier in fam.Tiers)
                                            {
                                                var upNames = fam.NamesFrom(tier);
                                                var tierPick = TierPick(fam, tier);
                                                var tierClaim = crit.Included.Count == 0
                                                    ? null
                                                    : TierClaim(fam, tier, crit);
                                                var tierClaimedHere = tierClaim is not null &&
                                                    TierExplicitPicks(fam, tier, [tierClaim]).Count > 0;
                                                var tierCoveredClaim = tierClaim is not null && !tierClaimedHere;
                                                var tierCoveredLabel = tierCoveredClaim ? ClaimLabel(tierClaim!) : null;
                                                var includedTier = tierClaimedHere ||
                                                    TierExplicitPicks(fam, tier, crit.Included).Count > 0;
                                                var upSelected = TierUpPicks(fam, tier, crit.Included).Count > 0;
                                                var coveringTier = UpCoveringTier(fam, tier, crit.Included);
                                                var coveredByUp = coveringTier is not null;
                                                var coveredHint = coveringTier is { } covering
                                                    ? CoveredTierHint(covering)
                                                    : null;
                                                var upDisabled = coveredByUp && !upSelected;
                                                var tierExclusionTerm = TierExclusionTerm(fam, tier);
                                                var tierExcludedHere = crit.Excluded.Count > 0 &&
                                                    TierExclusionTerms(fam, tier, crit.Excluded).Count > 0;
                                                var tierExclusionKey = crit.Excluded.Count > 0
                                                    ? Engine.ExcludeClaimKey(tierExclusionTerm, ScopeClassId)
                                                    : null;
                                                var tierExcludedClaim = tierExclusionKey is not null &&
                                                    PickClaims.FindExcludes(crit, Engine, ScopeClassId, tierExclusionKey).Count > 0;
                                                var excludedTier = tierExcludedHere || tierExcludedClaim;
                                                var tierExcludedCovered = excludedTier && !tierExcludedHere;
                                                var tierLines = TierLines(fam, tier);
                                                // Augment tiers are informational: the family row carries
                                                // the selection and these rows have no actions.
                                                var tierStateClass = "";
                                                if (!fam.IsAugmentLike)
                                                {
                                                    if (includedTier) tierStateClass += "picked ";
                                                    if (coveredByUp) tierStateClass += "covered up-covered ";
                                                    if (tierCoveredClaim) tierStateClass += "covered ";
                                                    if (excludedTier) tierStateClass += "excluded";
                                                }
                                                <li class="suggest-row tier-row @tierStateClass">
                                                    <span class="suggest-line @(tierLines.Count > 1 ? "multi" : "")" title="@TierTooltip(tier)">
                                                        @foreach (var l in tierLines)
                                                        {
                                                            <span class="mod-line">@l</span>
                                                        }
                                                    </span>
                                                    @if (!fam.IsAugmentLike)
                                                    {
                                                        @if (tierCoveredClaim)
                                                        {
                                                            <span class="covered-note" title="@CoveredTitle(tierCoveredLabel)">covered</span>
                                                        }
                                                        else if (coveredByUp && !upSelected)
                                                        {
                                                            <span class="covered-note" title="@coveredHint">≥ covered</span>
                                                        }
                                                    }
                                                    <span class="tier-name" title="@TierLabel(tier)">@TierLabel(tier)</span>
                                                    @if (!fam.IsAugmentLike)
                                                    {
                                                        <button id="pick-tier-@tier.Anchor.Id" class="inc @(tierClaimedHere ? "active" : "") @(tierCoveredClaim ? "switch" : "")"
                                                                disabled="@coveredByUp"
                                                                aria-disabled="@(coveredByUp ? "true" : "false")"
                                                                title="@TierPickActionTitle(tier, tierClaimedHere, tierCoveredLabel, coveredHint)"
                                                                aria-label="@TierPickActionTitle(tier, tierClaimedHere, tierCoveredLabel, coveredHint)"
                                                                aria-pressed="@(tierClaimedHere ? "true" : "false")"
                                                                @onclick="() => ToggleTierExact(fam, tier)">@(tierClaimedHere ? "✓" : tierCoveredClaim ? "⇄" : "+")</button>
                                                        @if (upNames.Count > 1)
                                                        {
                                                            <button id="pick-tier-up-@tier.Anchor.Id" class="up @(upSelected ? "active" : "")"
                                                                    disabled="@upDisabled"
                                                                    aria-disabled="@(upDisabled ? "true" : "false")"
                                                                    title="@TierUpTitle(tier, upNames, upSelected, coveredHint)"
                                                                    aria-label="@TierUpTitle(tier, upNames, upSelected, coveredHint)"
                                                                    aria-pressed="@(upSelected ? "true" : "false")"
                                                                    @onclick="() => ToggleTierUp(fam, tier)">≥</button>
                                                        }
                                                        <button id="pick-tier-exc-@tier.Anchor.Id" class="exc @(tierExcludedHere ? "active" : "") @(tierExcludedCovered ? "switch" : "")"
                                                                disabled="@coveredByUp"
                                                                aria-disabled="@(coveredByUp ? "true" : "false")"
                                                                title="@TierExcludeActionTitle(tier, tierExcludedHere, tierExcludedCovered, coveredHint)"
                                                                aria-label="@TierExcludeActionTitle(tier, tierExcludedHere, tierExcludedCovered, coveredHint)"
                                                                aria-pressed="@(tierExcludedHere ? "true" : "false")"
                                                                @onclick="() => ToggleTierExclude(fam, tier)">@(tierExcludedHere ? "⊘" : tierExcludedCovered ? "⇄" : "−")</button>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ol>
                    </section>
                }
            </div>
            @if (_search.Trim().Length > 0 && _families.Count > _shownCount)
            {
                <div class="more">@(_families.Count - _shownCount) more. Keep typing to narrow the list.</div>
            }
        </div>
    }
</div>

@code {
    private const int MaxShown = 50;
    private const int MaxAutoExpanded = 8;
    private const int MaxBulkPreview = 64;

    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    /// <summary>Scope the chips belong to: a slot id, or null for global.</summary>
    [Parameter]
    public string? Scope { get; set; }

    /// <summary>Typeahead source for the current scope (slot class, union, or all).</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<ModEntry> Mods { get; set; }

    private string _search = "";
    private ElementReference _searchInput;
    private IReadOnlyList<ModEntry>? _groupedMods;
    private bool _groupedGlobal;
    private bool _unionActive;
    private int _unionWarmVersion;
    private IReadOnlyList<ModFamily> _allFamilies = [];
    private readonly Dictionary<string, string?> _familyClaimKeys = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _tierClaimKeys = new(StringComparer.Ordinal);
    private string? _claimScope;
    private string? _claimClass;
    private IReadOnlyList<ModFamily> _families = [];
    private IReadOnlyList<ModFamily> _matchFamilies = [];
    private int _matchCount;
    private int _shownCount;
    private IReadOnlyList<ModFamily> _augments = [];
    private IReadOnlyList<ModFamily> _implicits = [];
    private IReadOnlyList<ModFamily> _corrupted = [];
    private IReadOnlyList<ModFamily> _prefixes = [];
    private IReadOnlyList<ModFamily> _suffixes = [];
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private readonly HashSet<string> _autoExpanded = new(StringComparer.Ordinal);
    private bool _bulkVisible;
    private bool _bulkOverflow;
    private bool _bulkTooMany;
    private int _bulkNew;
    private int _bulkLength;
    private int _bulkLimit;
    private string _placeholder = "Search mods…";
    private bool _showAll;

    private int CommonCount => _allFamilies.Count(f => ModFamilies.IsCommon(f, ScopeClassId));

    private string ScopeSummary
    {
        get
        {
            var filter = _search.Trim();
            if (filter.Length > 0)
            {
                var text = _matchCount == 1 ? "1 match" : $"{_matchCount} matches";
                var active = _families.Count - _matchCount;
                return active > 0 ? $"{text} · {active} active" : text;
            }
            if (CommonCount == 0 || _allFamilies.Count == CommonCount)
                return _allFamilies.Count == 1 ? "1 mod" : $"{_allFamilies.Count} mods";
            return _showAll
                ? $"All {_allFamilies.Count} mods"
                : $"Common picks · {CommonCount} shown";
        }
    }

    private bool ShowScopeToggle =>
        _search.Trim().Length == 0 &&
        CommonCount > 0 && _allFamilies.Count > CommonCount;

    private void ToggleShowAll()
    {
        _showAll = !_showAll;
        Refresh();
    }

    /// <summary>Item class the scope compiles with (null in global mode).</summary>
    private string? ScopeClassId => Scope is null ? null : State.CriteriaFor(Scope).ClassId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Scope is not null) return;
        // Warm the All-gear union after first paint. The common shortlist is
        // identical raw and unionized, so this stays off the boot path, and
        // the warm-up yields between slices so it cannot block an interaction
        // for the length of the whole union.
        var version = ++_unionWarmVersion;
        var mods = Mods;
        await Task.Delay(200);
        if (version != _unionWarmVersion || Scope is not null || _unionActive) return;
        var union = await ModFamilies.WarmUnionAsync(mods);
        if (version != _unionWarmVersion || Scope is not null || _unionActive ||
            !ReferenceEquals(mods, Mods))
            return;
        _allFamilies = union;
        _unionActive = true;
    }

    protected override void OnParametersSet()
    {
        // Group once per scope change; typing and pick changes only filter
        // this snapshot. The parent re-renders on every pick, so the
        // reference guard matters.
        var global = Scope is null;
        var classId = ScopeClassId;
        if (!ReferenceEquals(_groupedMods, Mods) || _groupedGlobal != global ||
            _claimScope != Scope || _claimClass != classId)
        {
            _groupedMods = Mods;
            _groupedGlobal = global;
            _claimScope = Scope;
            _claimClass = classId;
            _unionActive = false;
            _allFamilies = ModFamilies.CachedGroup(Mods);
            _familyClaimKeys.Clear();
            _tierClaimKeys.Clear();
        }
        State.WithSuppressedNotifications(() =>
            PickClaims.Normalize(ScopeCriteria(), Engine, ScopeClassId));
        Refresh();
    }

    private SlotCriteria ScopeCriteria() => State.CriteriaFor(Scope);

    private void Refresh()
    {
        var filter = _search.Trim();
        // The common shortlist is identical raw and unionized; defer the
        // All-gear union until the user searches or shows all mods.
        if (Scope is null && !_unionActive && (filter.Length > 0 || _showAll))
        {
            _allFamilies = ModFamilies.CachedGroup(Mods, union: true);
            _unionActive = true;
        }
        var filtered = filter.Length == 0
            ? _showAll || CommonCount == 0
                ? _allFamilies
                : _allFamilies.Where(f => ModFamilies.IsCommon(f, ScopeClassId)).ToList()
            : _allFamilies
                .Select(f =>
                {
                    var familyHit = f.DisplayText.Contains(filter, StringComparison.OrdinalIgnoreCase);
                    var tiers = familyHit
                        ? f.Tiers
                        : f.Tiers
                            .Where(t => t.SearchText.Contains(filter, StringComparison.OrdinalIgnoreCase))
                            .ToList();
                    return tiers.Count == 0 ? null : f.WithTiers(tiers);
                })
                .Where(f => f is not null)
                .Select(f => f!)
                .ToList();
        _matchFamilies = filtered;
        _matchCount = filtered.Count;

        // Active includes/excludes stay visible even when the search text or
        // common-only view does not match them. Home also adds the current
        // scope's picks from other classes to the source list, so imported
        // selections and cross-class picks can be pinned here too.
        var crit = ScopeCriteria();
        var byKey = filtered.ToDictionary(f => f.Key, f => f, StringComparer.Ordinal);
        var pinnedKeys = new HashSet<string>(StringComparer.Ordinal);
        foreach (var fam in _allFamilies)
        {
            if (!FamilyHasActiveState(fam, crit)) continue;
            pinnedKeys.Add(fam.Key);
            var pinnedTiers = PinnedTiers(fam, crit);
            if (byKey.TryGetValue(fam.Key, out var existing))
            {
                var tierIds = existing.Tiers.Select(t => t.Anchor.Id)
                    .Concat(pinnedTiers.Select(t => t.Anchor.Id))
                    .ToHashSet(StringComparer.Ordinal);
                byKey[fam.Key] = fam.WithTiers(
                    fam.Tiers.Where(t => tierIds.Contains(t.Anchor.Id)).ToList());
            }
            else
            {
                byKey[fam.Key] = fam.WithTiers(pinnedTiers);
            }
        }
        _families = _allFamilies
            .Where(f => byKey.ContainsKey(f.Key))
            .Select(f => byKey[f.Key])
            .ToList();
        var shown = filter.Length == 0
            ? _families
            : _families.Take(MaxShown)
                .Concat(_families.Skip(MaxShown).Where(f => pinnedKeys.Contains(f.Key)))
                .ToList();
        _shownCount = shown.Count;
        _augments = shown.Where(f => f.IsAugmentLike).ToList();
        _implicits = shown.Where(f => f.IsImplicit).ToList();
        _corrupted = shown.Where(f => f.IsCorrupted).ToList();
        _prefixes = shown.Where(f => f.Kind == "prefix").ToList();
        _suffixes = shown.Where(f => f.Kind == "suffix").ToList();
        // A single letter is too broad to expand every match (hundreds of
        // tier rows in the interpreter); keep it collapsed and auto-expand a
        // capped set once the filter is narrower.
        _autoExpanded.Clear();
        if (filter.Length >= 2)
            foreach (var fam in shown.Take(MaxAutoExpanded)) _autoExpanded.Add(fam.Key);
        UpdateBulk();
    }

    /// <summary>
    /// The add-all button exists only while a filter is typed; it is disabled
    /// when adding every match would push the compiled query over the game's
    /// character limit (previewed with allowOverflow — never throws).
    /// </summary>
    private void UpdateBulk()
    {
        _bulkVisible = false;
        _bulkOverflow = false;
        _bulkTooMany = false;
        _bulkNew = 0;
        if (_search.Trim().Length == 0 || _matchFamilies.Count == 0) return;
        var crit = ScopeCriteria();
        var picks = _matchFamilies.Select(f => f.Pick()).ToList();
        _bulkNew = picks.Count(p => !crit.Included.Any(m => m.SamePick(p)));
        if (_bulkNew < 2) return; // one match: the row's own + is the action
        // Broad filters can match most of the catalog; compiling a preview for
        // every match on each keystroke is what made the first letter hang.
        // Keep ++ visible, but disabled until the filter narrows enough.
        if (_bulkNew > MaxBulkPreview)
        {
            _bulkVisible = true;
            _bulkTooMany = true;
            _bulkOverflow = true;
            _bulkLength = _bulkNew * 4;
            _bulkLimit = 250;
            return;
        }
        var preview = SlotBudget.Preview(Engine, crit, ScopeClassId, picks, State.ExternalIncludes);
        _bulkLength = preview.Length;
        _bulkLimit = preview.Limit;
        _bulkOverflow = preview.Exceeded;
        _bulkVisible = true;
    }

    private string BulkTitle()
    {
        var already = _matchFamilies.Count - _bulkNew;
        var what = already > 0
            ? $"Add all {_bulkNew} matching mods ({already} already added)"
            : $"Add all {_bulkNew} matching mods";
        if (_bulkTooMany)
            return $"More than {MaxBulkPreview} matches would not fit in the game's limit. Narrow the search.";
        return _bulkOverflow
            ? $"Adding all {_bulkNew} would make the string {_bulkLength} of {_bulkLimit} characters. Narrow the search."
            : $"{what}, {_bulkLength} of {_bulkLimit} characters";
    }

    private void Toggle(string key)
    {
        if (!_expanded.Add(key)) _expanded.Remove(key);
    }

    /// <summary>
    /// True when any included pick belongs to this family. Picks are matched
    /// by member id, by variant id overlap, and finally by family key +
    /// generation: an imported or global pick can carry another scope's
    /// anchor and variant set, so exact <see cref="WantedMod.SamePick"/>
    /// equality misses it even though the family is the same.
    /// </summary>
    private bool FamilyPicked(ModFamily fam, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return false;
        var memberIds = fam.MemberIds;
        return included.Any(pick => PickTouchesFamily(fam, pick, memberIds));
    }

    /// <summary>Any active include or exclusion keeps this family visible.</summary>
    private bool FamilyHasActiveState(ModFamily fam, SlotCriteria crit)
    {
        if (FamilyPicked(fam, crit.Included)) return true;
        if (crit.Excluded.Count == 0) return false;
        if (FamilyExcludedClaim(fam, crit.Excluded)) return true;
        return fam.Tiers.Any(t => TierExcluded(fam, t, crit.Excluded));
    }

    /// <summary>
    /// True when a tier-level action needs its tier rows visible. A
    /// family-level exclusion already reads on the family row, so it must not
    /// uncollapse a single-tier family.
    /// </summary>
    private bool HasTierLevelState(ModFamily fam, SlotCriteria crit)
    {
        var familyExcludes = FamilyExclusionTerms(fam, crit.Excluded);
        return fam.Tiers.Any(t =>
            TierExplicitPicks(fam, t, crit.Included).Count > 0 ||
            TierUpPicks(fam, t, crit.Included).Count > 0 ||
            UpCoveringTier(fam, t, crit.Included) is not null ||
            TierExclusionTerms(fam, t, crit.Excluded)
                .Except(familyExcludes, StringComparer.Ordinal)
                .Any());
    }

    /// <summary>Tiers that must stay visible for an active family.</summary>
    private List<ModTier> PinnedTiers(ModFamily fam, SlotCriteria crit)
    {
        if (FamilyPicks(fam, crit.Included).Count > 0 ||
            FamilyExcludedClaim(fam, crit.Excluded))
        {
            return fam.Tiers.ToList();
        }
        var tiers = fam.Tiers.Where(t =>
            TierExplicitPicks(fam, t, crit.Included).Count > 0 ||
            TierUpPicks(fam, t, crit.Included).Count > 0 ||
            UpCoveringTier(fam, t, crit.Included) is not null ||
            TierExcluded(fam, t, crit.Excluded)).ToList();
        return tiers.Count > 0 ? tiers : fam.Tiers.ToList();
    }

    private bool PickTouchesFamily(ModFamily fam, WantedMod pick, IReadOnlySet<string> memberIds)
    {
        if (memberIds.Contains(pick.ModId)) return true;
        if (pick.VariantModIds is { Count: > 0 } variants)
        {
            if (variants.Any(memberIds.Contains)) return true;
            if (variants.Any(id => SameFamilyAs(fam, id))) return true;
        }
        return SameFamilyAs(fam, pick.ModId);
    }

    private bool SameFamilyAs(ModFamily fam, string modId)
    {
        var mod = Engine.FindMod(modId);
        if (mod is null ||
            !string.Equals(mod.GenerationType, fam.Kind, StringComparison.OrdinalIgnoreCase))
            return false;
        if (fam.MemberIds.Contains(mod.Id)) return true;
        if (string.IsNullOrEmpty(mod.Family)) return false;
        return fam.Members.Any(m =>
            string.Equals(m.Family, mod.Family, StringComparison.Ordinal) &&
            string.Equals(m.Source, mod.Source, StringComparison.Ordinal));
    }

    /// <summary>
    /// True when a pick covers this tier: its anchor is one of the tier's
    /// members (plain or name pick), or a name pick carries this tier's
    /// affix name (a tier-or-better set anchored to another member). A plain
    /// pick that carries family variants is the whole-family pick and covers
    /// every tier; it is excluded so it does not inflate the picked count.
    /// </summary>
    private static bool TierPicked(ModTier tier, WantedMod pick)
    {
        if (!pick.IsNamePick && pick.VariantModIds is { Count: > 0 }) return false;
        if (tier.MemberIds.Contains(pick.ModId)) return true;
        return pick.IsNamePick && tier.Name.Length > 0 &&
               pick.Names!.Contains(tier.Name, StringComparer.Ordinal);
    }

    /// <summary>Whole-family picks, matched by family identity rather than exact equality.</summary>
    private List<WantedMod> FamilyPicks(ModFamily fam, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return [];
        var memberIds = fam.MemberIds;
        return included.Where(pick => IsFamilyPick(fam, pick, memberIds)).ToList();
    }

    private bool IsFamilyPick(ModFamily fam, WantedMod pick, IReadOnlySet<string> memberIds)
    {
        if (pick.IsNamePick || pick.VariantModIds is not { Count: > 0 } variants) return false;
        return variants.Any(memberIds.Contains) ||
               variants.Any(id => SameFamilyAs(fam, id)) ||
               SameFamilyAs(fam, pick.ModId);
    }

    /// <summary>Picks that explicitly choose this tier (a single affix name or a plain anchor).</summary>
    private List<WantedMod> TierExplicitPicks(
        ModFamily fam, ModTier tier, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return [];
        var tierIds = tier.MemberIds;
        var memberIds = fam.MemberIds;
        return included
            .Where(pick => IsExplicitTierPick(fam, tier, pick, tierIds, memberIds))
            .ToList();
    }

    private bool IsExplicitTierPick(
        ModFamily fam, ModTier tier, WantedMod pick,
        IReadOnlySet<string> tierIds, IReadOnlySet<string> memberIds)
    {
        if (pick.IsNamePick)
        {
            if (pick.Names!.Count != 1) return false;
            if (!PickTouchesFamily(fam, pick, memberIds)) return false;
            return tier.Name.Length > 0
                ? string.Equals(pick.Names[0], tier.Name, StringComparison.Ordinal)
                : tierIds.Contains(pick.ModId);
        }
        if (pick.VariantModIds is { Count: > 0 }) return false; // whole-family pick
        if (tierIds.Contains(pick.ModId)) return true;
        // Imported plain picks can be anchored to another scope's member.
        // Desecrated tiers share a faction name, so only the id identifies one.
        var mod = Engine.FindMod(pick.ModId);
        return tier.Source is not ("desecrated" or "implicit") && mod is not null && tier.Name.Length > 0 &&
               SameFamilyAs(fam, pick.ModId) &&
               string.Equals(mod.Name ?? "", tier.Name, StringComparison.Ordinal);
    }

    /// <summary>
    /// Tier-or-better picks anchored at this tier. Their anchor is the lowest
    /// covered tier, so choosing one lights the ↑ button on that row only;
    /// better tiers are covered, not individually selected.
    /// </summary>
    private List<WantedMod> TierUpPicks(
        ModFamily fam, ModTier tier, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return [];
        var memberIds = fam.MemberIds;
        return included
            .Where(pick => IsUpPick(fam, pick, memberIds) &&
                           UpAnchorTier(fam, pick) is { } anchor &&
                           anchor.Anchor.Id == tier.Anchor.Id)
            .ToList();
    }

    private bool IsUpPick(ModFamily fam, WantedMod pick, IReadOnlySet<string> memberIds) =>
        pick.IsNamePick && pick.Names!.Count > 1 &&
        PickTouchesFamily(fam, pick, memberIds);

    private static ModTier? UpAnchorTier(ModFamily fam, WantedMod pick) =>
        fam.Tiers.FirstOrDefault(t =>
            t.Name.Length > 0 && pick.Names!.Contains(t.Name, StringComparer.Ordinal));

    /// <summary>The or-better pick covering this tier, if any.</summary>
    private ModTier? UpCoveringTier(
        ModFamily fam, ModTier tier, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0 || tier.Name.Length == 0) return null;
        var memberIds = fam.MemberIds;
        foreach (var pick in included)
        {
            if (!IsUpPick(fam, pick, memberIds) ||
                !pick.Names!.Contains(tier.Name, StringComparer.Ordinal)) continue;
            return UpAnchorTier(fam, pick);
        }
        return null;
    }

    private List<WantedMod> FamilyUpPicks(ModFamily fam, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return [];
        var memberIds = fam.MemberIds;
        return included.Where(pick => IsUpPick(fam, pick, memberIds)).ToList();
    }

    private static string CoveredTierHint(ModTier coveringTier) =>
        $"Covered by \"{TierLabel(coveringTier)}\" or better; remove that choice to edit this tier.";

    private static IReadOnlyList<string> TierLines(ModFamily fam, ModTier tier) =>
        fam.IsUnion || fam.IsDesecrated || fam.IsImplicit || fam.IsCorrupted
            ? tier.UnionLines
            : tier.DisplayLines;

    private static string TierTooltip(ModTier tier) =>
        string.Join("\n", tier.Members
            .Select(m => string.Join(" / ", m.StatLines.Select(ModSearch.DisplayLine)) +
                         (m.Classes.Count > 0 ? $" — {string.Join(", ", m.Classes)}" : ""))
            .Distinct(StringComparer.Ordinal));

    private static string TierLabel(ModTier tier) =>
        tier.DisplayLabel.Length > 0
            ? tier.DisplayLabel
            : tier.DisplayLines.FirstOrDefault() ?? tier.Anchor.Id;

    private static WantedMod TierPick(ModFamily fam, ModTier tier) =>
        fam.IsDesecrated || fam.IsImplicit || fam.IsCorrupted || fam.IsAugmentLike || tier.Name.Length == 0
            ? new WantedMod(tier.Anchor.Id)
            : new WantedMod(tier.Anchor.Id, [tier.Name]);

    private bool CanCollapse(ModFamily fam)
    {
        if (fam.IsAugmentLike) return false;
        if (fam.Tiers.Count != 1) return false;
        var tier = fam.Tiers[0];
        var familyFragment = Engine.PickFragment(fam.Pick(), ScopeClassId);
        var tierFragment = Engine.PickFragment(TierPick(fam, tier), ScopeClassId);
        return !string.IsNullOrEmpty(familyFragment) &&
               string.Equals(familyFragment, tierFragment, StringComparison.Ordinal);
    }

    /// <summary>
    /// Exclusions store either an affix name (picker tier excludes) or a mod
    /// id (imported/global excludes), so a family matches both its own ids
    /// and same-family ids from another scope. A tier name never matches a
    /// mod id; family identity is compared by key + generation to avoid
    /// lighting up unrelated families that share an affix name.
    ///
    /// A picker family exclusion stores the family anchor id, which is also
    /// the first tier's anchor. Tier rows therefore ignore id-based matches
    /// while the family is excluded; an explicitly excluded tier name still
    /// applies, so mixed family+tier exclusions render both rows.
    /// </summary>
    private bool FamilyExcluded(ModFamily fam, IReadOnlyList<string> excluded) =>
        FamilyExclusionTerms(fam, excluded).Count > 0;

    private bool TierExcluded(ModFamily fam, ModTier tier, IReadOnlyList<string> excluded) =>
        TierExclusionTerms(fam, tier, excluded).Count > 0;

    private List<string> FamilyExclusionTerms(ModFamily fam, IReadOnlyList<string> excluded)
    {
        if (excluded.Count == 0) return [];
        var memberIds = fam.MemberIds;
        return excluded
            .Where(e => memberIds.Contains(e) || SameFamilyAs(fam, e))
            .Distinct(StringComparer.Ordinal)
            .ToList();
    }

    private List<string> TierExclusionTerms(
        ModFamily fam, ModTier tier, IReadOnlyList<string> excluded)
    {
        if (excluded.Count == 0) return [];
        // Desecrated/implicit tiers can share a fragment per family. A
        // member-id exclusion is therefore family-wide, and every row shows it
        // instead of leaving the clicked row unchanged.
        if (fam.IsDesecrated || fam.IsImplicit || fam.IsCorrupted)
            return FamilyExclusionTerms(fam, excluded);
        var familyExcluded = FamilyExcluded(fam, excluded);
        var tierIds = tier.MemberIds;
        var matches = new List<string>();
        foreach (var term in excluded)
        {
            // Name-based tier excludes always apply, including alongside a
            // family exclusion.
            if (tier.Name.Length > 0 &&
                string.Equals(term, tier.Name, StringComparison.Ordinal))
            {
                matches.Add(term);
                continue;
            }
            // The family anchor is also the first tier's anchor; while the
            // family is excluded, id matches are family-level, not tier-level.
            if (familyExcluded) continue;
            if (tierIds.Contains(term))
            {
                matches.Add(term);
                continue;
            }
            // An imported exclude can carry another scope's member id for the
            // same family; match it by affix name within that family.
            var mod = Engine.FindMod(term);
            if (mod is not null && tier.Name.Length > 0 && SameFamilyAs(fam, term) &&
                string.Equals(mod.Name ?? "", tier.Name, StringComparison.Ordinal))
                matches.Add(term);
        }
        return matches.Distinct(StringComparer.Ordinal).ToList();
    }

    // Titles are built here, not as markup entities: Blazor sets attributes
    // through DOM APIs, so a literal `&quot;` would show verbatim. Family
    // titles name the content, like the tier titles do.
    private static string FamilyToggleTitle(ModFamily fam, bool expanded) =>
        $"{(expanded ? "Hide" : "Show")} {fam.Tiers.Count} tiers of {fam.DisplayText}";

    private static string FamilyIncludeTitle(ModFamily fam, bool included) =>
        included
            ? $"Included: {fam.DisplayText}. Remove inclusion."
            : $"Include {fam.DisplayText} (any tier)";

    private static string FamilyExcludeTitle(ModFamily fam, bool excluded) =>
        excluded
            ? $"Excluded: {fam.DisplayText}. Remove exclusion."
            : $"Exclude {fam.DisplayText} (any tier)";

    private static string FamilyExcludeActionTitle(
        ModFamily fam, bool excludedHere, bool excludedCovered) =>
        excludedCovered
            ? $"Same exclusion is selected on another mod. Use ⇄ to switch the exclusion to {fam.DisplayText}."
            : FamilyExcludeTitle(fam, excludedHere);

    private static string FamilyIncludeActionTitle(
        ModFamily fam, bool claimedHere, string? coveredLabel) =>
        coveredLabel is not null
            ? $"Same search is selected on {coveredLabel}. Use ⇄ to switch to {fam.DisplayText}."
            : FamilyIncludeTitle(fam, claimedHere);

    private WantedMod? FamilyClaim(ModFamily fam, SlotCriteria crit)
    {
        var key = FamilyClaimKey(fam);
        return key is null ? null : PickClaims.FindInclude(crit, Engine, ScopeClassId, key);
    }

    private bool FamilyExcludedClaim(ModFamily fam, IReadOnlyList<string> excluded)
    {
        if (FamilyExcluded(fam, excluded)) return true;
        var key = Engine.ExcludeClaimKey(fam.Anchor.Id, ScopeClassId);
        return key is not null &&
               PickClaims.FindExcludes(ScopeCriteria(), Engine, ScopeClassId, key).Count > 0;
    }

    private WantedMod? TierClaim(ModFamily fam, ModTier tier, SlotCriteria crit)
    {
        var key = TierClaimKey(fam, tier);
        return key is null ? null : PickClaims.FindInclude(crit, Engine, ScopeClassId, key);
    }

    private string? FamilyClaimKey(ModFamily fam)
    {
        if (_familyClaimKeys.TryGetValue(fam.Key, out var cached)) return cached;
        var source = _allFamilies.FirstOrDefault(f =>
            string.Equals(f.Key, fam.Key, StringComparison.Ordinal)) ?? fam;
        var key = Engine.PickClaimKey(source.Pick(), ScopeClassId);
        _familyClaimKeys[fam.Key] = key;
        return key;
    }

    private string? TierClaimKey(ModFamily fam, ModTier tier)
    {
        var id = fam.Key + "\u0001" + tier.Anchor.Id + "\u0001" + tier.Name;
        if (_tierClaimKeys.TryGetValue(id, out var cached)) return cached;
        var key = Engine.PickClaimKey(TierPick(fam, tier), ScopeClassId);
        _tierClaimKeys[id] = key;
        return key;
    }

    private string ClaimLabel(WantedMod pick) =>
        pick.IsNamePick && pick.Names is { Count: > 0 }
            ? $"\"{pick.Names[0]}\""
            : SearchModel.FamilyText(_allFamilies, Mods, pick.ModId, Engine);

    private static string CoveredTitle(string? label) =>
        label is null
            ? "The same search is selected on another row. Use ⇄ to switch."
            : $"The same search is selected on {label}. Use ⇄ to switch to this mod.";

    private static string TierPickTitle(
        ModTier tier, bool included, string? coveredHint)
    {
        if (coveredHint is not null) return coveredHint;
        var label = TierLabel(tier);
        return included
            ? $"Included: \"{label}\". Remove inclusion."
            : $"Add \"{label}\"";
    }

    private static string TierPickActionTitle(
        ModTier tier, bool claimedHere, string? coveredLabel, string? coveredHint)
    {
        if (coveredLabel is not null)
            return $"The same search is selected on {coveredLabel}. Use ⇄ to switch to \"{TierLabel(tier)}\".";
        return TierPickTitle(tier, claimedHere, coveredHint);
    }

    private static string TierUpTitle(
        ModTier tier, IReadOnlyList<string> names, bool selected, string? coveredHint)
    {
        var label = TierLabel(tier);
        if (selected)
            return $"Selected: \"{label}\" — this tier or better. Remove selection.";
        if (coveredHint is not null) return coveredHint;
        return $"\"{label}\" — this tier or better. Add: {string.Join(", ", names.Where(n => !string.Equals(n, tier.Name, StringComparison.Ordinal)))}";
    }

    private static string TierExcludeActionTitle(
        ModTier tier, bool excludedHere, bool excludedCovered, string? coveredHint)
    {
        if (excludedCovered)
            return $"The same exclusion is selected on another row. Use ⇄ to switch the exclusion to \"{TierLabel(tier)}\".";
        if (coveredHint is not null) return coveredHint;
        var label = TierLabel(tier);
        return excludedHere
            ? $"Excluded: \"{label}\". Remove exclusion."
            : $"Exclude \"{label}\"";
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        Refresh();
    }

    private async Task ClearSearch()
    {
        _search = "";
        Refresh();
        await _searchInput.FocusAsync();
    }

    private void RemoveClaimIncludes(EngineService engine, SlotCriteria crit, string? key)
    {
        if (key is null) return;
        foreach (var pick in PickClaims.FindIncludes(crit, engine, ScopeClassId, key))
            State.RemoveInclude(Scope, pick);
    }

    private void RemoveClaimExcludes(EngineService engine, SlotCriteria crit, string? key)
    {
        if (key is null) return;
        foreach (var term in PickClaims.FindExcludes(crit, engine, ScopeClassId, key))
            State.RemoveExclude(Scope, term);
    }

    private void ToggleFamilyInclude(ModFamily fam)
    {
        var crit = ScopeCriteria();
        var pick = fam.Pick();
        var key = FamilyClaimKey(fam);
        if (key is null)
        {
            var existing = FamilyPicks(fam, crit.Included);
            if (existing.Count > 0)
                foreach (var p in existing) State.RemoveInclude(Scope, p);
            else
                State.AddInclude(Scope, pick);
            Refresh();
            return;
        }

        var claims = PickClaims.FindIncludes(crit, Engine, ScopeClassId, key);
        var claimedHere = claims.Any(p => FamilyPicks(fam, [p]).Count > 0);
        RemoveClaimIncludes(Engine, crit, key);
        RemoveClaimExcludes(Engine, crit, Engine.ExcludeClaimKey(fam.Anchor.Id, ScopeClassId));
        if (!claimedHere) State.AddInclude(Scope, pick);
        Refresh();
    }

    private void ToggleFamilyExclude(ModFamily fam)
    {
        var crit = ScopeCriteria();
        var term = fam.Anchor.Id;
        var key = Engine.ExcludeClaimKey(term, ScopeClassId);
        if (key is null)
        {
            var existing = FamilyExclusionTerms(fam, crit.Excluded);
            if (existing.Count > 0)
                foreach (var e in existing) State.RemoveExclude(Scope, e);
            else
                State.AddExclude(Scope, term);
            Refresh();
            return;
        }

        var claims = PickClaims.FindExcludes(crit, Engine, ScopeClassId, key);
        var claimedHere = FamilyExclusionTerms(fam, crit.Excluded).Count > 0;
        RemoveClaimExcludes(Engine, crit, key);
        if (!claimedHere)
        {
            var includeKey = FamilyClaimKey(fam);
            RemoveClaimIncludes(Engine, crit, includeKey);
            if (includeKey != key) RemoveClaimIncludes(Engine, crit, key);
            State.AddExclude(Scope, term);
        }
        Refresh();
    }

    private static string TierExclusionTerm(ModFamily fam, ModTier tier) =>
        fam.IsDesecrated || fam.IsImplicit || fam.IsCorrupted || fam.IsAugmentLike ||
        tier.Name.Length == 0
            ? tier.Anchor.Id
            : tier.Name;

    private void ToggleTierExact(ModFamily fam, ModTier tier)
    {
        var crit = ScopeCriteria();
        var pick = TierPick(fam, tier);
        var key = TierClaimKey(fam, tier);
        if (key is not null)
        {
            var claims = PickClaims.FindIncludes(crit, Engine, ScopeClassId, key);
            var claimedHere = TierExplicitPicks(fam, tier, claims).Count > 0;
            if (claims.Count > 0)
            {
                RemoveClaimIncludes(Engine, crit, key);
                RemoveClaimExcludes(Engine, crit, Engine.ExcludeClaimKey(TierExclusionTerm(fam, tier), ScopeClassId));
                if (!claimedHere) State.AddInclude(Scope, pick);
                Refresh();
                return;
            }
        }

        if (UpCoveringTier(fam, tier, crit.Included) is not null) return; // undo or-better first
        var existing = TierExplicitPicks(fam, tier, crit.Included);
        if (existing.Count > 0)
        {
            foreach (var p in existing) State.RemoveInclude(Scope, p);
        }
        else
        {
            foreach (var p in TierUpPicks(fam, tier, crit.Included))
                State.RemoveInclude(Scope, p);
            foreach (var e in TierExclusionTerms(fam, tier, crit.Excluded))
                State.RemoveExclude(Scope, e);
            State.AddInclude(Scope, pick);
        }
        Refresh();
    }

    private void ToggleTierUp(ModFamily fam, ModTier tier)
    {
        var crit = ScopeCriteria();
        var pick = new WantedMod(tier.Anchor.Id, fam.NamesFrom(tier));
        var key = Engine.PickClaimKey(pick, ScopeClassId);
        if (key is not null)
        {
            var claims = PickClaims.FindIncludes(crit, Engine, ScopeClassId, key);
            var claimedHere = TierUpPicks(fam, tier, claims).Count > 0;
            if (claims.Count > 0)
            {
                RemoveClaimIncludes(Engine, crit, key);
                RemoveClaimExcludes(Engine, crit, Engine.ExcludeClaimKey(TierExclusionTerm(fam, tier), ScopeClassId));
                if (!claimedHere) State.AddInclude(Scope, pick);
                Refresh();
                return;
            }
        }

        var existing = TierUpPicks(fam, tier, crit.Included);
        if (existing.Count > 0)
        {
            foreach (var p in existing) State.RemoveInclude(Scope, p);
        }
        else
        {
            if (UpCoveringTier(fam, tier, crit.Included) is { } covering &&
                covering.Anchor.Id != tier.Anchor.Id) return;
            foreach (var p in FamilyUpPicks(fam, crit.Included))
                State.RemoveInclude(Scope, p);
            // Selecting "this or better" covers every tier at or above the
            // anchor. Any explicit include or exclusion left on one of those
            // tiers is now contradictory, so clear the whole covered range.
            var coveredTiers = fam.Tiers
                .Where(t => t.RequiredLevel >= tier.RequiredLevel)
                .ToList();
            foreach (var p in coveredTiers
                         .SelectMany(t => TierExplicitPicks(fam, t, crit.Included))
                         .Distinct())
                State.RemoveInclude(Scope, p);
            foreach (var e in coveredTiers
                         .SelectMany(t => TierExclusionTerms(fam, t, crit.Excluded))
                         .Distinct(StringComparer.Ordinal))
                State.RemoveExclude(Scope, e);
            State.AddInclude(Scope, pick);
        }
        Refresh();
    }

    private void ToggleTierExclude(ModFamily fam, ModTier tier)
    {
        var crit = ScopeCriteria();
        var term = TierExclusionTerm(fam, tier);
        var key = Engine.ExcludeClaimKey(term, ScopeClassId);
        if (key is not null)
        {
            var claims = PickClaims.FindExcludes(crit, Engine, ScopeClassId, key);
            var claimedHere = TierExclusionTerms(fam, tier, crit.Excluded).Count > 0;
            if (claims.Count > 0)
            {
                RemoveClaimExcludes(Engine, crit, key);
                if (!claimedHere) State.AddExclude(Scope, term);
                Refresh();
                return;
            }
        }

        if (UpCoveringTier(fam, tier, crit.Included) is not null) return; // undo or-better first
        var existing = TierExclusionTerms(fam, tier, crit.Excluded);
        if (existing.Count > 0)
        {
            foreach (var e in existing) State.RemoveExclude(Scope, e);
        }
        else
        {
            foreach (var p in TierExplicitPicks(fam, tier, crit.Included))
                State.RemoveInclude(Scope, p);
            foreach (var p in TierUpPicks(fam, tier, crit.Included))
                State.RemoveInclude(Scope, p);
            State.AddExclude(Scope, term);
        }
        Refresh();
    }

    /// <summary>Adds every family matching the filter in one notification and
    /// leaves the filter in place. The rail keeps its scroll position (picks
    /// append, so nothing shifts); the pagers reveal what is off-screen.</summary>
    private void SelectAll()
    {
        if (_bulkOverflow || _bulkTooMany) return;
        var crit = ScopeCriteria();
        var keys = crit.Included
            .Select(p => Engine.PickClaimKey(p, ScopeClassId))
            .Where(k => k is not null)
            .ToHashSet(StringComparer.Ordinal);
        var picks = new List<WantedMod>();
        foreach (var family in _matchFamilies)
        {
            var pick = family.Pick();
            var key = FamilyClaimKey(family);
            if (key is not null && !keys.Add(key)) continue;
            picks.Add(pick);
        }
        State.AddIncludes(Scope, picks);
        Refresh();
    }
}
