@using PoeRegex.Core.Data
@using PoeRegex.Core.Search
@using PoeRegex.Web.Core

<div class="modpicker">
    @{
        var crit = ScopeCriteria();
    }
    <div class="chips" aria-label="Wanted mods">
        @foreach (var inc in crit.Included)
        {
            <button class="chip inc" id="chip-inc-@Scope-@inc.ModId" title="remove"
                    @onclick="() => State.RemoveInclude(Scope, inc.ModId)">
                @DisplayFor(inc.ModId)@(inc.MinValue is null ? "" : $" ≥{inc.MinValue}")
            </button>
        }
        @foreach (var exc in crit.Excluded)
        {
            <button class="chip exc" id="chip-exc-@Scope-@exc" title="remove"
                    @onclick="() => State.RemoveExclude(Scope, exc)">
                !@DisplayFor(exc)
            </button>
        }
        @if (crit.Included.Count + crit.Excluded.Count > 0)
        {
            <button class="chip clear" id="chips-clear-@Scope" @onclick="() => State.ClearChips(Scope)">clear</button>
        }
    </div>

    <div class="modrow">
        <input id="mod-search" placeholder="type to filter mods…" value="@_search"
               @oninput="OnSearch" aria-label="Filter mods" />
        <input id="mod-min" placeholder="min roll, e.g. 80" inputmode="decimal" value="@_minText"
               @oninput="OnMin" aria-label="Minimum roll: only match values at or above this" title="Only match rolls at or above this value (applies to single-value mods)" />
    </div>

    @if (_suggestions.Count > 0 && !_takenOnly)
    {
        <button id="suggest-all" @onclick="SelectAll">[select all @_suggestions.Count]</button>
    }
    @if (_suggestions.Count == 0 && !_takenOnly)
    {
        <div class="more">no mods match the filter</div>
    }
    <div class="mod-list">
        <ol class="suggest" aria-label="Mods">
            @foreach (var m in _suggestions.Take(MaxShown))
            {
                var lines = m.StatLines;
                var line = lines.FirstOrDefault();
                var prefix = IsPrefix(m);
                var display = line is null ? m.Id : ModSearch.DisplayLine(line);
                var fullText = lines.Count > 0
                    ? string.Join("\n", lines.Select(ModSearch.DisplayLine))
                    : m.Id;
                <li class="suggest-row">
                    <span class="gen-tag" title="@(prefix ? "prefix" : "suffix")">@(prefix ? "P" : "S")</span>
                    @if (lines.Count <= 1)
                    {
                        <span class="suggest-line" title="@fullText">@display</span>
                    }
                    else
                    {
                        <span class="suggest-line multi" title="@fullText">
                            @foreach (var sl in lines)
                            {
                                <span class="mod-line">@ModSearch.DisplayLine(sl)</span>
                            }
                        </span>
                    }
                    <button id="pick-inc-@m.Id" title="include" @onclick="() => Include(m)">+</button>
                    <button id="pick-exc-@m.Id" title="exclude" @onclick="() => State.AddExclude(Scope, m.Id)">−</button>
                </li>
            }
        </ol>
    </div>
    @if (_suggestions.Count > MaxShown)
    {
        <div class="more">@(_suggestions.Count - MaxShown) more… keep typing to narrow</div>
    }
    @if (_minError is not null)
    {
        <div class="field-error">@_minError</div>
    }
    @if (_minSkipped is not null)
    {
        <div class="more" id="min-skipped">min ignored for @_minSkipped — a multi-value line takes no single threshold</div>
    }
</div>

@code {
    private const int MaxShown = 50;

    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    /// <summary>Scope the chips belong to: a slot id, or null for global.</summary>
    [Parameter]
    public string? Scope { get; set; }

    /// <summary>Typeahead source for the current scope (slot class, union, or all).</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<ModEntry> Mods { get; set; }

    private string _search = "";
    private string _minText = "";
    private string? _minError;
    private string? _minSkipped;
    private List<ModEntry> _suggestions = [];
    private bool _takenOnly;

    protected override void OnParametersSet() => Refresh();

    private SlotCriteria ScopeCriteria() => State.CriteriaFor(Scope);

    /// <summary>Friendly chip text: the mod's range line, falling back to the id.</summary>
    private string DisplayFor(string modId) =>
        Mods.FirstOrDefault(m => m.Id == modId)?.StatLines.FirstOrDefault() is { } sl
            ? ModSearch.DisplayLine(sl)
            : modId;

    private void Refresh()
    {
        var crit = ScopeCriteria();
        var taken = crit.Included.Select(m => m.ModId).Concat(crit.Excluded);
        var avail = ModSearch.AvailableMods(Mods, taken);
        _suggestions = ModSearch.FilterMods(avail, _search).ToList();
        _takenOnly = avail.Count == 0;
    }

    /// <summary>Tag shown on each mod line: prefix (P) or suffix (S).</summary>
    private static bool IsPrefix(ModEntry m) =>
        m.GenerationType.Equals("prefix", StringComparison.OrdinalIgnoreCase);

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _minSkipped = null;
        Refresh();
    }

    private void OnMin(ChangeEventArgs e)
    {
        _minText = e.Value?.ToString() ?? "";
        _minError = null;
        _minSkipped = null;
    }

    /// <returns>(min, valid): valid=false only when text is present but not a number.</returns>
    private (double? min, bool valid) ParseMin()
    {
        var t = _minText.Trim();
        if (t.Length == 0) { _minError = null; return (null, true); }
        if (double.TryParse(t, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var v))
        { _minError = null; return (v, true); }
        _minError = $"min '{t}' is not a number";
        return (null, false);
    }

    private void Include(ModEntry m)
    {
        var (min, valid) = ParseMin();
        if (!valid) return;
        _minSkipped = null;
        var applied = min;
        if (min is not null && !SupportsMin(m))
        {
            applied = null;
            _minSkipped = $"\"{m.Name ?? m.Id}\"";
        }
        State.AddInclude(Scope, m.Id, applied);
        Refresh();
    }

    private void SelectAll()
    {
        var (min, valid) = ParseMin();
        if (!valid) return;
        _minSkipped = null;
        var skipped = 0;
        foreach (var m in _suggestions)
        {
            var applied = min;
            if (min is not null && !SupportsMin(m))
            {
                applied = null;
                skipped++;
            }
            State.AddInclude(Scope, m.Id, applied);
        }
        if (skipped > 0) _minSkipped = $"{skipped} selected mod(s)";
        _search = "";
        Refresh();
    }

    /// <summary>
    /// A floor only compiles onto a line with exactly one rolled number
    /// (`+46 to Accuracy Rating`): the threshold builder cannot express a
    /// floor on multi-value lines (`Adds 2 to 43 Lightning Damage`) and falls
    /// back to a plain text match, so the min is dropped there instead of
    /// silently pretending. Grouped family/tier pickers will carry per-value
    /// floors later.
    /// </summary>
    private static bool SupportsMin(ModEntry m) =>
        m.StatLines.Count > 0 &&
        m.StatLines.All(s => s.Pattern.Count(c => c == SuffixIndex.DigitPlaceholder) == 1);
}
