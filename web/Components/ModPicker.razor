@using PoeRegex.Core.Data
@using PoeRegex.Web.Core
@inject EngineService Engine

<div class="modpicker" id="modpicker-@(Scope ?? "global")">
    @{
        var crit = ScopeCriteria();
    }
    <div class="modrow">
        @* The add-all button is the filter's right edge; it only exists
           while a filter is typed (matching every family is not a workflow). *@
        <div class="search-unit">
            <input id="mod-search" placeholder="@_placeholder" value="@_search"
                   @oninput="OnSearch" aria-label="Filter mods" />
            @if (_bulkVisible)
            {
                <button id="suggest-all" title="@BulkTitle()" aria-label="@BulkTitle()"
                        disabled="@(_bulkOverflow || _bulkTooMany)" @onclick="SelectAll">Add all @_bulkNew</button>
            }
        </div>
    </div>

    @if (_families.Count == 0)
    {
        <div class="more">@(_search.Trim().Length == 0
            ? _placeholder
            : $"No mods match \"{_search.Trim()}\".")</div>
    }
    else
    {
        <div class="mod-list">
            @if (_search.Trim().Length == 0 && CommonCount > 0 && _allFamilies.Count > CommonCount)
            {
                <div class="mod-scope">
                    <span>@(_showAll ? $"All {_allFamilies.Count} mods" : $"Common picks · {CommonCount} shown")</span>
                    <button type="button" class="link" id="mod-show-all" @onclick="ToggleShowAll">
                        @(_showAll ? "Show common only" : $"Show all {_allFamilies.Count} mods")
                    </button>
                </div>
            }
            @{
                (IReadOnlyList<ModFamily> List, string Header)[] sections =
                    [(_prefixes, "Prefixes"), (_suffixes, "Suffixes")];
                var twoCols = _prefixes.Count > 0 && _suffixes.Count > 0;
            }
            <div class="mod-cols @(twoCols ? "" : "single")">
                @foreach (var (list, header) in sections)
                {
                    if (list.Count == 0) continue;
                    <section class="mod-sec">
                        <div class="gen-head">@header</div>
                        <ol class="suggest" aria-label="@header">
                            @foreach (var fam in list)
                            {
                                var pickedFamily = FamilyPicked(fam, crit.Included);
                                var familyIncluded = FamilyPicks(fam, crit.Included).Count > 0;
                                var pickedTiers = fam.Tiers.Count(t =>
                                    crit.Included.Any(m => TierPicked(t, m)));
                                var excludedFamily = FamilyExcluded(fam, crit.Excluded);
                                var excludedTiers = fam.Tiers.Count(t =>
                                    TierExcluded(fam, t, crit.Excluded));
                                var expanded = _expanded.Contains(fam.Key) || _autoExpanded.Contains(fam.Key);
                                <li class="fam-block">
                                    <div class="suggest-row fam-row @(pickedFamily ? "picked" : "") @(excludedFamily ? "excluded" : "")">
                                        <button class="suggest-line fam-toggle" id="fam-toggle-@fam.Anchor.Id"
                                                aria-expanded="@(expanded ? "true" : "false")"
                                                title="@FamilyToggleTitle(fam, expanded)"
                                                @onclick="() => Toggle(fam.Key)">
                                            <span class="fam-caret" aria-hidden="true">@(expanded ? "▾" : "▸")</span>
                                            <span class="fam-text @(fam.DisplayLines.Count > 1 ? "multi" : "")">
                                                @if (fam.DisplayLines.Count == 1)
                                                {
                                                    @fam.DisplayLines[0]
                                                }
                                                else
                                                {
                                                    foreach (var fl in fam.DisplayLines)
                                                    {
                                                        <span class="mod-line">@fl</span>
                                                    }
                                                }
                                            </span>
                                            @if (excludedFamily)
                                            {
                                                <span class="state-badge excluded" title="This family is excluded">⊘ Excluded</span>
                                            }
                                            <span class="tier-count">@fam.Tiers.Count tiers</span>
                                            @if (pickedTiers > 0)
                                            {
                                                <span class="picked-count" title="@($"{pickedTiers} {(pickedTiers == 1 ? "tier" : "tiers")} picked in this family")">@pickedTiers picked</span>
                                            }
                                            @if (pickedTiers > 0 && excludedTiers > 0)
                                            {
                                                <span class="summary-sep" aria-hidden="true">·</span>
                                            }
                                            @if (excludedTiers > 0)
                                            {
                                                <span class="excluded-count" title="@($"{excludedTiers} {(excludedTiers == 1 ? "tier" : "tiers")} excluded in this family")">@excludedTiers excluded</span>
                                            }
                                        </button>
                                        <button id="pick-inc-@fam.Anchor.Id" class="inc @(familyIncluded ? "active" : "")"
                                                title="@FamilyIncludeTitle(fam, familyIncluded)"
                                                aria-label="@FamilyIncludeTitle(fam, familyIncluded)"
                                                aria-pressed="@(familyIncluded ? "true" : "false")"
                                                @onclick="() => ToggleFamilyInclude(fam)">@(familyIncluded ? "✓" : "+")</button>
                                        <button id="pick-exc-@fam.Anchor.Id" class="exc @(excludedFamily ? "active" : "")"
                                                title="@FamilyExcludeTitle(fam, excludedFamily)"
                                                aria-label="@FamilyExcludeTitle(fam, excludedFamily)"
                                                aria-pressed="@(excludedFamily ? "true" : "false")"
                                                @onclick="() => ToggleFamilyExclude(fam)">@(excludedFamily ? "⊘" : "−")</button>
                                    </div>
                                    @if (expanded)
                                    {
                                        <ul class="tier-list">
                                            @foreach (var tier in fam.Tiers)
                                            {
                                                var upNames = fam.NamesFrom(tier);
                                                var includedTier = TierExplicitPicks(fam, tier, crit.Included).Count > 0;
                                                var upSelected = TierUpPicks(fam, tier, crit.Included).Count > 0;
                                                var coveredByUp = TierCoveredByUp(fam, tier, crit.Included);
                                                var excludedTier = TierExcluded(fam, tier, crit.Excluded);
                                                <li class="suggest-row tier-row @(includedTier ? "picked" : "") @(coveredByUp ? "covered" : "") @(excludedTier ? "excluded" : "")">
                                                    <span class="suggest-line multi" title="@string.Join("\n", tier.DisplayLines)">
                                                        @foreach (var l in tier.DisplayLines)
                                                        {
                                                            <span class="mod-line">@l</span>
                                                        }
                                                    </span>
                                                    <span class="tier-name" title="@tier.Name">@(tier.Name.Length > 0 ? tier.Name : tier.Anchor.Id)</span>
                                                    @if (includedTier)
                                                    {
                                                        <span class="state-badge included" title="This tier is explicitly included">✓ Included</span>
                                                    }
                                                    @if (coveredByUp)
                                                    {
                                                        <span class="state-badge up" title="@(upSelected ? "This tier is the start of an or-better selection" : "Covered by an or-better selection below")">@(upSelected ? "↑ Or better" : "↑ Covered")</span>
                                                    }
                                                    @if (excludedTier)
                                                    {
                                                        <span class="state-badge excluded" title="This tier is excluded">⊘ Excluded</span>
                                                    }
                                                    <button id="pick-tier-@tier.Anchor.Id" class="inc @(includedTier ? "active" : "")"
                                                            title="@TierPickTitle(tier, includedTier)"
                                                            aria-label="@TierPickTitle(tier, includedTier)"
                                                            aria-pressed="@(includedTier ? "true" : "false")"
                                                            @onclick="() => ToggleTierExact(fam, tier)">@(includedTier ? "✓" : "+")</button>
                                                    @if (upNames.Count > 1)
                                                    {
                                                        <button id="pick-tier-up-@tier.Anchor.Id" class="up @(upSelected ? "active" : "")"
                                                                title="@TierUpTitle(tier, upNames, upSelected)"
                                                                aria-label="@TierUpTitle(tier, upNames, upSelected)"
                                                                aria-pressed="@(upSelected ? "true" : "false")"
                                                                @onclick="() => ToggleTierUp(fam, tier)">@(upSelected ? "✓" : "↑")</button>
                                                    }
                                                    <button id="pick-tier-exc-@tier.Anchor.Id" class="exc @(excludedTier ? "active" : "")"
                                                            title="@TierExcludeTitle(tier, excludedTier)"
                                                            aria-label="@TierExcludeTitle(tier, excludedTier)"
                                                            aria-pressed="@(excludedTier ? "true" : "false")"
                                                            @onclick="() => ToggleTierExclude(fam, tier)">@(excludedTier ? "⊘" : "−")</button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ol>
                    </section>
                }
            </div>
            @if (_search.Trim().Length > 0 && _families.Count > MaxShown)
            {
                <div class="more">@(_families.Count - MaxShown) more. Keep typing to narrow the list.</div>
            }
        </div>
    }
</div>

@code {
    private const int MaxShown = 50;
    private const int MaxAutoExpanded = 8;
    private const int MaxBulkPreview = 64;

    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    /// <summary>Scope the chips belong to: a slot id, or null for global.</summary>
    [Parameter]
    public string? Scope { get; set; }

    /// <summary>Typeahead source for the current scope (slot class, union, or all).</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<ModEntry> Mods { get; set; }

    private string _search = "";
    private IReadOnlyList<ModEntry>? _groupedMods;
    private IReadOnlyList<ModFamily> _allFamilies = [];
    private IReadOnlyList<ModFamily> _families = [];
    private IReadOnlyList<ModFamily> _prefixes = [];
    private IReadOnlyList<ModFamily> _suffixes = [];
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private readonly HashSet<string> _autoExpanded = new(StringComparer.Ordinal);
    private bool _bulkVisible;
    private bool _bulkOverflow;
    private bool _bulkTooMany;
    private int _bulkNew;
    private int _bulkLength;
    private int _bulkLimit;
    private string _placeholder = "Search mods…";
    private bool _showAll;

    private int CommonCount => _allFamilies.Count(ModFamilies.IsCommon);

    private void ToggleShowAll()
    {
        _showAll = !_showAll;
        Refresh();
    }

    /// <summary>Item class the scope compiles with (null in global mode).</summary>
    private string? ScopeClassId => Scope is null ? null : State.CriteriaFor(Scope).ClassId;

    protected override void OnParametersSet()
    {
        // Group once per scope change; typing and pick changes only filter
        // this snapshot. The parent re-renders on every pick, so the
        // reference guard matters.
        if (!ReferenceEquals(_groupedMods, Mods))
        {
            _groupedMods = Mods;
            _allFamilies = ModFamilies.CachedGroup(Mods);
        }
        Refresh();
    }

    private SlotCriteria ScopeCriteria() => State.CriteriaFor(Scope);

    private void Refresh()
    {
        var filter = _search.Trim();
        _families = filter.Length == 0
            ? _showAll || CommonCount == 0 ? _allFamilies : _allFamilies.Where(ModFamilies.IsCommon).ToList()
            : _allFamilies
                .Select(f =>
                {
                    var familyHit = f.DisplayText.Contains(filter, StringComparison.OrdinalIgnoreCase);
                    var tiers = familyHit
                        ? f.Tiers
                        : f.Tiers
                            .Where(t => t.SearchText.Contains(filter, StringComparison.OrdinalIgnoreCase))
                            .ToList();
                    return tiers.Count == 0 ? null : f with { Tiers = tiers };
                })
                .Where(f => f is not null)
                .Select(f => f!)
                .ToList();
        var shown = filter.Length == 0 && (_showAll || CommonCount == 0) ? _families : _families.Take(MaxShown).ToList();
        _prefixes = shown.Where(f => f.IsPrefix).ToList();
        _suffixes = shown.Where(f => !f.IsPrefix).ToList();
        // A single letter is too broad to expand every match (hundreds of
        // tier rows in the interpreter); keep it collapsed and auto-expand a
        // capped set once the filter is narrower.
        _autoExpanded.Clear();
        if (filter.Length >= 2)
            foreach (var fam in shown.Take(MaxAutoExpanded)) _autoExpanded.Add(fam.Key);
        UpdateBulk();
    }

    /// <summary>
    /// The add-all button exists only while a filter is typed; it is disabled
    /// when adding every match would push the compiled query over the game's
    /// character limit (previewed with allowOverflow — never throws).
    /// </summary>
    private void UpdateBulk()
    {
        _bulkVisible = false;
        _bulkOverflow = false;
        _bulkTooMany = false;
        _bulkNew = 0;
        if (_search.Trim().Length == 0 || _families.Count == 0) return;
        var crit = ScopeCriteria();
        var picks = _families.Select(f => f.Pick()).ToList();
        _bulkNew = picks.Count(p => !crit.Included.Any(m => m.SamePick(p)));
        if (_bulkNew < 2) return; // one match: the row's own + is the action
        // Broad filters can match most of the catalog; compiling a preview for
        // every match on each keystroke is what made the first letter hang.
        // Keep ++ visible, but disabled until the filter narrows enough.
        if (_bulkNew > MaxBulkPreview)
        {
            _bulkVisible = true;
            _bulkTooMany = true;
            _bulkOverflow = true;
            _bulkLength = _bulkNew * 4;
            _bulkLimit = 250;
            return;
        }
        var preview = SlotBudget.Preview(Engine, crit, ScopeClassId, picks);
        _bulkLength = preview.Length;
        _bulkLimit = preview.Limit;
        _bulkOverflow = preview.Exceeded;
        _bulkVisible = true;
    }

    private string BulkTitle()
    {
        var already = _families.Count - _bulkNew;
        var what = already > 0
            ? $"Add all {_bulkNew} matching mods ({already} already added)"
            : $"Add all {_bulkNew} matching mods";
        if (_bulkTooMany)
            return $"More than {MaxBulkPreview} matches would not fit in the game's limit. Narrow the search.";
        return _bulkOverflow
            ? $"Adding all {_bulkNew} would make the string {_bulkLength} of {_bulkLimit} characters. Narrow the search."
            : $"{what}, {_bulkLength} of {_bulkLimit} characters";
    }

    private void Toggle(string key)
    {
        if (!_expanded.Add(key)) _expanded.Remove(key);
    }

    /// <summary>
    /// True when any included pick belongs to this family. Picks are matched
    /// by member id, by variant id overlap, and finally by family key +
    /// generation: an imported or global pick can carry another scope's
    /// anchor and variant set, so exact <see cref="WantedMod.SamePick"/>
    /// equality misses it even though the family is the same.
    /// </summary>
    private bool FamilyPicked(ModFamily fam, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return false;
        var memberIds = fam.Members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);
        return included.Any(pick => PickTouchesFamily(fam, pick, memberIds));
    }

    private bool PickTouchesFamily(ModFamily fam, WantedMod pick, HashSet<string> memberIds)
    {
        if (memberIds.Contains(pick.ModId)) return true;
        if (pick.VariantModIds is { Count: > 0 } variants)
        {
            if (variants.Any(memberIds.Contains)) return true;
            if (variants.Any(id => SameFamilyAs(fam, id))) return true;
        }
        return SameFamilyAs(fam, pick.ModId);
    }

    private bool SameFamilyAs(ModFamily fam, string modId)
    {
        var mod = Engine.FindMod(modId);
        return mod is not null &&
               string.Equals(ModFamilies.KeyOf(mod), fam.Key, StringComparison.Ordinal) &&
               string.Equals(mod.GenerationType, fam.IsPrefix ? "prefix" : "suffix",
                   StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// True when a pick covers this tier: its anchor is one of the tier's
    /// members (plain or name pick), or a name pick carries this tier's
    /// affix name (a tier-or-better set anchored to another member). A plain
    /// pick that carries family variants is the whole-family pick and covers
    /// every tier; it is excluded so it does not inflate the picked count.
    /// </summary>
    private static bool TierPicked(ModTier tier, WantedMod pick)
    {
        if (!pick.IsNamePick && pick.VariantModIds is { Count: > 0 }) return false;
        if (tier.Members.Any(m => string.Equals(m.Id, pick.ModId, StringComparison.Ordinal)))
            return true;
        return pick.IsNamePick && tier.Name.Length > 0 &&
               pick.Names!.Contains(tier.Name, StringComparer.Ordinal);
    }

    /// <summary>Whole-family picks, matched by family identity rather than exact equality.</summary>
    private List<WantedMod> FamilyPicks(ModFamily fam, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return [];
        var memberIds = fam.Members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);
        return included.Where(pick => IsFamilyPick(fam, pick, memberIds)).ToList();
    }

    private bool IsFamilyPick(ModFamily fam, WantedMod pick, HashSet<string> memberIds)
    {
        if (pick.IsNamePick || pick.VariantModIds is not { Count: > 0 } variants) return false;
        return variants.Any(memberIds.Contains) ||
               variants.Any(id => SameFamilyAs(fam, id)) ||
               SameFamilyAs(fam, pick.ModId);
    }

    /// <summary>Picks that explicitly choose this tier (a single affix name or a plain anchor).</summary>
    private List<WantedMod> TierExplicitPicks(
        ModFamily fam, ModTier tier, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return [];
        var tierIds = tier.Members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);
        var memberIds = fam.Members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);
        return included
            .Where(pick => IsExplicitTierPick(fam, tier, pick, tierIds, memberIds))
            .ToList();
    }

    private bool IsExplicitTierPick(
        ModFamily fam, ModTier tier, WantedMod pick,
        HashSet<string> tierIds, HashSet<string> memberIds)
    {
        if (pick.IsNamePick)
        {
            if (pick.Names!.Count != 1) return false;
            if (!PickTouchesFamily(fam, pick, memberIds)) return false;
            return tier.Name.Length > 0
                ? string.Equals(pick.Names[0], tier.Name, StringComparison.Ordinal)
                : tierIds.Contains(pick.ModId);
        }
        if (pick.VariantModIds is { Count: > 0 }) return false; // whole-family pick
        if (tierIds.Contains(pick.ModId)) return true;
        // Imported plain picks can be anchored to another scope's member.
        var mod = Engine.FindMod(pick.ModId);
        return mod is not null && tier.Name.Length > 0 && SameFamilyAs(fam, pick.ModId) &&
               string.Equals(mod.Name ?? "", tier.Name, StringComparison.Ordinal);
    }

    /// <summary>
    /// Tier-or-better picks anchored at this tier. Their anchor is the lowest
    /// covered tier, so choosing one lights the ↑ button on that row only;
    /// better tiers are covered, not individually selected.
    /// </summary>
    private List<WantedMod> TierUpPicks(
        ModFamily fam, ModTier tier, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0) return [];
        var memberIds = fam.Members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);
        return included
            .Where(pick => IsUpPick(fam, pick, memberIds) &&
                           UpAnchorTier(fam, pick) is { } anchor &&
                           anchor.Anchor.Id == tier.Anchor.Id)
            .ToList();
    }

    private bool IsUpPick(ModFamily fam, WantedMod pick, HashSet<string> memberIds) =>
        pick.IsNamePick && pick.Names!.Count > 1 &&
        PickTouchesFamily(fam, pick, memberIds);

    private static ModTier? UpAnchorTier(ModFamily fam, WantedMod pick) =>
        fam.Tiers.FirstOrDefault(t =>
            t.Name.Length > 0 && pick.Names!.Contains(t.Name, StringComparer.Ordinal));

    private bool TierCoveredByUp(ModFamily fam, ModTier tier, IReadOnlyList<WantedMod> included)
    {
        if (included.Count == 0 || tier.Name.Length == 0) return false;
        var memberIds = fam.Members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);
        return included.Any(pick => IsUpPick(fam, pick, memberIds) &&
                                    pick.Names!.Contains(tier.Name, StringComparer.Ordinal));
    }

    /// <summary>
    /// Exclusions store either an affix name (picker tier excludes) or a mod
    /// id (imported/global excludes), so a family matches both its own ids
    /// and same-family ids from another scope. A tier name never matches a
    /// mod id; family identity is compared by key + generation to avoid
    /// lighting up unrelated families that share an affix name.
    /// </summary>
    private bool FamilyExcluded(ModFamily fam, IReadOnlyList<string> excluded) =>
        FamilyExclusionTerms(fam, excluded).Count > 0;

    private bool TierExcluded(ModFamily fam, ModTier tier, IReadOnlyList<string> excluded) =>
        TierExclusionTerms(fam, tier, excluded).Count > 0;

    private List<string> FamilyExclusionTerms(ModFamily fam, IReadOnlyList<string> excluded)
    {
        if (excluded.Count == 0) return [];
        var memberIds = fam.Members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);
        return excluded
            .Where(e => memberIds.Contains(e) || SameFamilyAs(fam, e))
            .Distinct(StringComparer.Ordinal)
            .ToList();
    }

    private List<string> TierExclusionTerms(
        ModFamily fam, ModTier tier, IReadOnlyList<string> excluded)
    {
        if (excluded.Count == 0) return [];
        var tierIds = tier.Members.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);
        var matches = new List<string>();
        foreach (var term in excluded)
        {
            if (tier.Name.Length > 0 && string.Equals(term, tier.Name, StringComparison.Ordinal))
            {
                matches.Add(term);
                continue;
            }
            if (tierIds.Contains(term))
            {
                matches.Add(term);
                continue;
            }
            // An imported exclude can carry another scope's member id for the
            // same family; match it by affix name within that family.
            var mod = Engine.FindMod(term);
            if (mod is not null && tier.Name.Length > 0 && SameFamilyAs(fam, term) &&
                string.Equals(mod.Name ?? "", tier.Name, StringComparison.Ordinal))
                matches.Add(term);
        }
        return matches.Distinct(StringComparer.Ordinal).ToList();
    }

    // Titles are built here, not as markup entities: Blazor sets attributes
    // through DOM APIs, so a literal `&quot;` would show verbatim. Family
    // titles name the content, like the tier titles do.
    private static string FamilyToggleTitle(ModFamily fam, bool expanded) =>
        $"{(expanded ? "Hide" : "Show")} {fam.Tiers.Count} tiers of {fam.DisplayText}";

    private static string FamilyIncludeTitle(ModFamily fam, bool included) =>
        included
            ? $"Included: {fam.DisplayText}. Remove inclusion."
            : $"Include {fam.DisplayText} (any tier)";

    private static string FamilyExcludeTitle(ModFamily fam, bool excluded) =>
        excluded
            ? $"Excluded: {fam.DisplayText}. Remove exclusion."
            : $"Exclude {fam.DisplayText} (any tier)";

    private static string TierPickTitle(ModTier tier, bool included)
    {
        var label = tier.Name.Length > 0 ? tier.Name : tier.Anchor.Id;
        return included
            ? $"Included: \"{label}\". Remove inclusion."
            : $"Add \"{label}\"";
    }

    private static string TierUpTitle(
        ModTier tier, IReadOnlyList<string> names, bool selected)
    {
        var label = tier.Name.Length > 0 ? tier.Name : tier.Anchor.Id;
        if (selected)
            return $"Selected: \"{label}\" or better. Remove selection.";
        return $"Add \"{label}\" or better: {string.Join(", ", names.Where(n => !string.Equals(n, tier.Name, StringComparison.Ordinal)))}";
    }

    private static string TierExcludeTitle(ModTier tier, bool excluded)
    {
        var label = tier.Name.Length > 0 ? tier.Name : tier.Anchor.Id;
        return excluded
            ? $"Excluded: \"{label}\". Remove exclusion."
            : $"Exclude \"{label}\"";
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        Refresh();
    }

    private void ToggleFamilyInclude(ModFamily fam)
    {
        var crit = ScopeCriteria();
        var existing = FamilyPicks(fam, crit.Included);
        if (existing.Count > 0)
        {
            foreach (var pick in existing) State.RemoveInclude(Scope, pick);
        }
        else
        {
            foreach (var term in FamilyExclusionTerms(fam, crit.Excluded))
                State.RemoveExclude(Scope, term);
            State.AddInclude(Scope, fam.Pick());
        }
        Refresh();
    }

    private void ToggleFamilyExclude(ModFamily fam)
    {
        var crit = ScopeCriteria();
        var existing = FamilyExclusionTerms(fam, crit.Excluded);
        if (existing.Count > 0)
        {
            foreach (var term in existing) State.RemoveExclude(Scope, term);
        }
        else
        {
            foreach (var pick in FamilyPicks(fam, crit.Included))
                State.RemoveInclude(Scope, pick);
            State.AddExclude(Scope, fam.Anchor.Id);
        }
        Refresh();
    }

    private void ToggleTierExact(ModFamily fam, ModTier tier)
    {
        var crit = ScopeCriteria();
        var existing = TierExplicitPicks(fam, tier, crit.Included);
        if (existing.Count > 0)
        {
            foreach (var pick in existing) State.RemoveInclude(Scope, pick);
        }
        else
        {
            foreach (var pick in TierUpPicks(fam, tier, crit.Included))
                State.RemoveInclude(Scope, pick);
            foreach (var term in TierExclusionTerms(fam, tier, crit.Excluded))
                State.RemoveExclude(Scope, term);
            State.AddInclude(Scope, new WantedMod(tier.Anchor.Id, [tier.Name]));
        }
        Refresh();
    }

    private void ToggleTierUp(ModFamily fam, ModTier tier)
    {
        var crit = ScopeCriteria();
        var existing = TierUpPicks(fam, tier, crit.Included);
        if (existing.Count > 0)
        {
            foreach (var pick in existing) State.RemoveInclude(Scope, pick);
        }
        else
        {
            foreach (var pick in TierExplicitPicks(fam, tier, crit.Included))
                State.RemoveInclude(Scope, pick);
            foreach (var term in TierExclusionTerms(fam, tier, crit.Excluded))
                State.RemoveExclude(Scope, term);
            State.AddInclude(Scope, new WantedMod(tier.Anchor.Id, fam.NamesFrom(tier)));
        }
        Refresh();
    }

    private void ToggleTierExclude(ModFamily fam, ModTier tier)
    {
        var crit = ScopeCriteria();
        var existing = TierExclusionTerms(fam, tier, crit.Excluded);
        if (existing.Count > 0)
        {
            foreach (var term in existing) State.RemoveExclude(Scope, term);
        }
        else
        {
            foreach (var pick in TierExplicitPicks(fam, tier, crit.Included))
                State.RemoveInclude(Scope, pick);
            foreach (var pick in TierUpPicks(fam, tier, crit.Included))
                State.RemoveInclude(Scope, pick);
            State.AddExclude(Scope, tier.Name.Length > 0 ? tier.Name : tier.Anchor.Id);
        }
        Refresh();
    }

    /// <summary>Adds every family matching the filter in one notification and
    /// leaves the filter in place. The rail keeps its scroll position (picks
    /// append, so nothing shifts); the pagers reveal what is off-screen.</summary>
    private void SelectAll()
    {
        if (_bulkOverflow || _bulkTooMany) return;
        State.AddIncludes(Scope, _families.Select(f => f.Pick()));
        Refresh();
    }
}
