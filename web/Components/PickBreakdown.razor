@using System.Globalization
@using PoeRegex.Core.Data
@using PoeRegex.Web.Core
@inject EngineService Engine
@implements IDisposable

<section class="picks" aria-labelledby="picks-title">
    <h2 class="picks-title" id="picks-title">@Title</h2>
    @if (!HasPicks)
    {
        <p class="picks-empty">@(State.Mode == "advanced" ? "Nothing picked yet. Choose a slot, then use + on a mod." : "Nothing picked yet. Use + on a mod to add it.")</p>
    }
    @if (State.Mode == "advanced")
    {
        @if (Model.Anchor is { } anchor)
        {
            <div class="bd-sec bd-anchor @(Model.IsHot(anchor.Index) ? "hot" : "")"
                 @onmouseenter="() => Model.Hot(anchor.Index)" @onmouseleave="Model.Cool">
                <div class="bd-head">
                    <span class="bd-name">Item classes</span>
                    <code class="bd-frag" title="@anchor.Text">@anchor.Text</code>
                    <span class="bd-cost">@anchor.Cost</span>
                </div>
            </div>
        }
        @foreach (var slot in State.ActiveSlots())
        {
            var crit = State.CriteriaFor(slot);
            var blocks = Model.ScopeBlocks(slot);
            <div class="bd-sec @(State.FocusedSlot == slot ? "focused" : "") @(blocks.Any(Model.IsHot) ? "hot" : "")"
                 @onmouseleave="Model.Cool">
                <div class="bd-head" @onmouseenter="() => Model.Hot(blocks)">
                    @if (ReadOnly)
                    {
                        <span class="bd-name">@SearchModel.SlotLabel(slot)</span>
                    }
                    else
                    {
                        <button type="button" class="bd-name bd-slot" title="Edit @SearchModel.SlotLabel(slot) mods"
                                @onclick="() => State.SelectSlot(slot)">@SearchModel.SlotLabel(slot)</button>
                    }
                    @if (SlotSub(slot) is { } sub)
                    {
                        <span class="bd-sub">@sub</span>
                    }
                    @if (blocks.Count > 0)
                    {
                        <span class="bd-cost" title="@CostTitle(slot, blocks)">@Model.Cost(blocks)</span>
                    }
                    @if (!ReadOnly)
                    {
                        <button type="button" class="link bd-clear" id="chips-clear-@slot"
                                @onclick="() => State.ClearChips(slot)">Clear</button>
                    }
                </div>
                @PickList(slot, crit, Engine.ModsForClass(State.SlotClassOrDefault(slot)))
            </div>
        }
        @if (State.ActiveSlots().Count > 0 &&
             State.Global.Excluded.Any(e => !RawExclusion.IsRaw(e)))
        {
            <div class="bd-sec" @onmouseleave="Model.Cool">
                <div class="bd-head">
                    <span class="bd-name" title="Excludes from the All gear list also apply per slot">All gear</span>
                </div>
                @PickList(null, new SlotCriteria { Excluded = State.Global.Excluded }, Engine.PlayableMods())
            </div>
        }
    }
    else if (State.Global.Included.Count > 0 ||
             State.Global.Excluded.Any(e => !RawExclusion.IsRaw(e)))
    {
        var blocks = Model.ScopeBlocks(null);
        <div class="bd-sec @(blocks.Any(Model.IsHot) ? "hot" : "")" @onmouseleave="Model.Cool">
            <div class="bd-head" @onmouseenter="() => Model.Hot(blocks)">
                <span class="bd-name">All gear</span>
                @if (blocks.Count > 0)
                {
                    <span class="bd-cost" title="@($"{Model.Cost(blocks)} characters")">@Model.Cost(blocks)</span>
                }
                @if (!ReadOnly)
                {
                    <button type="button" class="link bd-clear" id="chips-clear-global"
                            @onclick="() => State.ClearChips(null)">Clear</button>
                }
            </div>
            @PickList(null, State.Global, Engine.PlayableMods())
        </div>
    }
    @if (State.ExternalIncludes.Count > 0 || ImportedAnyOf().Count > 0 ||
         ImportedExclusions().Count > 0)
    {
        <div class="bd-sec" @onmouseleave="Model.Cool">
            <div class="bd-head">
                <span class="bd-name">Custom text</span>
                @if (!ReadOnly)
                {
                    <button type="button" class="link bd-clear" id="chips-clear-imported"
                            @onclick="ClearImportedTerms">Clear</button>
                }
            </div>
            @ImportedList()
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required SearchModel Model { get; set; }

    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    /// <summary>Render the same rows without edit controls, for previews.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public string Title { get; set; } = "Your picks";

    private SearchModel? _subscribed;
    private WantedMod? _minBusy;
    private int? _hotAnyOfIndex;

    private bool HasPicks => State.Mode == "advanced"
        ? State.ActiveSlots().Count > 0 || State.ExternalIncludes.Count > 0 ||
          ImportedAnyOf().Count > 0 || ImportedExclusions().Count > 0
        : State.Global.Included.Count + State.Global.Excluded.Count > 0;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Model)) return;
        if (_subscribed is not null) _subscribed.HotChanged -= Repaint;
        Model.HotChanged += Repaint;
        _subscribed = Model;
    }

    private void Repaint() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.HotChanged -= Repaint;
    }

    private RenderFragment PickList(string? slot, SlotCriteria crit, IReadOnlyList<ModEntry> mods) => __builder =>
    {
        var hasChips = crit.Included.Count > 0 || crit.Excluded.Count > 0;
        var families = ModFamilies.CachedGroup(mods, union: slot is null && hasChips);
        var cls = slot is null ? null : State.SlotClassOrDefault(slot);
        var scopeKey = slot ?? "global";
        var scopeBlocks = Model.ScopeBlocks(slot);
        var regularIncluded = crit.Included.Where(p => !p.IsRawText).ToList();
        var familyIndex = regularIncluded.Count == 0
            ? null
            : ModFamilies.IndexOf(families);
        if (regularIncluded.Count > 0)
        {
            <div class="bd-logic">
                @if (crit.Included.Count > 1)
                {
                    <span class="logic-seg" role="group" aria-label="How these picks combine">
                        <button type="button" id="logic-any-@scopeKey" class="@(crit.MatchAll ? "" : "on")"
                                aria-pressed="@(crit.MatchAll ? "false" : "true")"
                                disabled="@ReadOnly"
                                title="Light up items with at least one of these mods"
                                @onclick="() => State.SetMatchAll(slot, false)">Any of</button>
                        <button type="button" id="logic-all-@scopeKey" class="@(crit.MatchAll ? "on" : "")"
                                aria-pressed="@(crit.MatchAll ? "true" : "false")"
                                disabled="@ReadOnly"
                                title="Light up only items with every one of these mods"
                                @onclick="() => State.SetMatchAll(slot, true)">All of</button>
                    </span>
                    @if (crit.MatchAll && cls is not null && Model.MergedToAny(cls))
                    {
                        <span class="logic-note" title="Two slots of the same item class share one block in the combined string">Shares a block with another @SearchModel.SlotLabel(slot!) slot, so it matches any of these.</span>
                    }
                }
                else
                {
                    <span>@(crit.MatchAll ? "All of" : "Any of")</span>
                }
            </div>
            <ul class="bd-list" @onmouseenter="() => { if (!crit.MatchAll) Model.Hot(scopeBlocks); }">
                @foreach (var inc in regularIncluded)
                {
                    var frag = Model.PickFragment(inc, cls);
                    var incMod = Engine.FindMod(inc.ModId);
                    var family = incMod is null ? null : familyIndex?.GetValueOrDefault(incMod.Id);
                    var tier = family?.Tiers
                        .FirstOrDefault(t => t.MemberIds.Contains(incMod!.Id));
                    var own = Model.PickBlock(slot, inc);
                    var label = inc.IsNamePick
                        ? $"\"{inc.Names![0]}\""
                        : SearchModel.FamilyText(families, mods, inc.ModId, Engine);
                    if (family is not null && (family.IsDesecrated || family.IsImplicit) && !inc.IsNamePick)
                    {
                        if (family.Tiers.Count == 1)
                            label = string.Join(" / ", PickTierLines(family, family.Tiers[0]));
                        else if (inc.VariantModIds is not { Count: > 1 } && tier is not null)
                            label = string.Join(" / ", PickTierLines(family, tier));
                    }
                    var source = SourceFor(inc);
                    var minIgnored = inc.MinValue is not null && frag is not null
                        && frag == Model.PickFragment(inc with { MinValue = null }, cls);
                    var busy = _minBusy?.SamePick(inc) == true;
                    <li class="bd-row inc @(ReadOnly ? "ro" : "") @(own >= 0 && Model.IsHot(own) || Model.IsPickHot(inc) ? "hot" : "")" id="chip-inc-@scopeKey-@ChipKey(inc)"
                        @onmouseenter="() => { if (own >= 0) Model.Hot(own); else if (!Model.HotPick(inc)) Model.Hot(scopeBlocks); }">
                        <span class="bd-what">
                            <span class="bd-label">
                                <span class="bd-text">@label@(inc.IsNamePick && inc.Names!.Count > 1 ? " or better" : "")</span>
                                @if (source is { } tag)
                                {
                                    <span class="mod-source @tag.Css">@tag.Text</span>
                                }
                            </span>
                            @if (inc.IsNamePick && tier is not null)
                            {
                                <span class="bd-detail">@string.Join(" / ", PickTierLines(family, tier))</span>
                            }
                            else if (family?.IsAugmentLike == true && tier is not null)
                            {
                                <span class="bd-detail">@tier.DisplayLabel</span>
                            }
                        </span>
                        @if (!ReadOnly && AcceptsMin(inc, cls))
                        {
                            <input class="bd-min @(minIgnored ? "noop" : "") @(busy ? "working" : "")" type="number" inputmode="numeric" min="0" step="1"
                                   id="min-@scopeKey-@ChipKey(inc)" placeholder="@(busy ? "…" : "min")" autocomplete="off"
                                   aria-busy="@(busy ? "true" : "false")"
                                   value="@inc.MinValue?.ToString(CultureInfo.InvariantCulture)"
                                   title="@(busy ? "Applying the minimum…" : minIgnored ? "No effect at this value: this pick already matches every value" : "Only match this value or higher (a longer fragment)")"
                                   aria-label="@($"Minimum value for {label}")"
                                   @onchange="e => SetMin(slot, inc, cls, e)" />
                        }
                        else
                        {
                            <span></span>
                        }
                        @if (frag is not null)
                        {
                            <code class="bd-frag" title="@frag">@frag</code>
                            <span class="bd-n" title="@($"{frag.Length} characters on its own")">@frag.Length<span class="bd-unit"> chars</span></span>
                        }
                        else
                        {
                            <span class="bd-frag missing">no fragment</span>
                            <span class="bd-n"></span>
                        }
                        @if (!ReadOnly)
                        {
                            <button type="button" class="bd-x" id="chip-remove-inc-@scopeKey-@ChipKey(inc)"
                                    title="@RemoveTitle(inc, label)" aria-label="@RemoveTitle(inc, label)"
                                    @onclick="() => State.RemoveInclude(slot, inc)">×</button>
                        }
                    </li>
                }
            </ul>
        }
        var regularExcluded = crit.Excluded.Where(e => !RawExclusion.IsRaw(e)).ToList();
        if (regularExcluded.Count > 0)
        {
            <div class="bd-logic"><span>@(slot is null ? "None of" : "None of, on any slot")</span></div>
            <ul class="bd-list">
                @foreach (var exc in regularExcluded)
                {
                    var frag = Model.ExcludeFragment(exc);
                    var block = Model.ExcludeBlock(exc);
                    var label = SearchModel.ExcludeLabel(exc, mods, union: slot is null);
                    var source = SourceFor(exc);
                    <li class="bd-row exc @(ReadOnly ? "ro" : "") @(block is not null && Model.IsHot(block.Index) ? "hot" : "")" id="chip-exc-@scopeKey-@exc"
                        @onmouseenter="() => { if (block is not null) Model.Hot(block.Index); }">
                        <span class="bd-what">
                            <span class="bd-label">
                                <span class="bd-text">@label</span>
                                @if (source is { } tag)
                                {
                                    <span class="mod-source @tag.Css">@tag.Text</span>
                                }
                            </span>
                        </span>
                        <span></span>
                        <code class="bd-frag" title="@frag">@frag</code>
                        <span class="bd-n" title="@(block is null ? "" : $"{block.Cost} characters as its own block")">@if (block is not null) { @block.Cost<span class="bd-unit"> chars</span> }</span>
                        @if (!ReadOnly)
                        {
                            <button type="button" class="bd-x" id="chip-remove-exc-@scopeKey-@exc"
                                    title="@($"Remove {label}")" aria-label="@($"Remove {label}")"
                                    @onclick="() => State.RemoveExclude(slot, exc)">×</button>
                        }
                    </li>
                }
            </ul>
        }
    };

    /// <summary>Raw custom text included in the pick group (Any of), with its owning scope.</summary>
    private IReadOnlyList<(string? Slot, WantedMod Pick)> ImportedAnyOf()
    {
        var picks = new List<(string? Slot, WantedMod Pick)>();
        if (State.Mode == "advanced")
            foreach (var slot in State.ActiveSlots())
                picks.AddRange(State.CriteriaFor(slot).Included
                    .Where(p => p.IsRawText)
                    .Select(p => ((string?)slot, p)));
        picks.AddRange(State.Global.Included
            .Where(p => p.IsRawText)
            .Select(p => ((string?)null, p)));
        return picks
            .GroupBy(p => p.Pick.ModId, StringComparer.Ordinal)
            .Select(g => g.First())
            .ToList();
    }

    private bool ImportedAnyOfMatchAll =>
        ImportedAnyOf().Any(p =>
            (p.Slot is null ? State.Global : State.CriteriaFor(p.Slot)).MatchAll);

    /// <summary>Raw exclusions stored in the normal exclusion list, but shown in the imported group.</summary>
    private IReadOnlyList<string> ImportedExclusions()
    {
        var terms = new List<string>();
        if (State.Mode == "advanced")
            terms.AddRange(State.ActiveSlots().SelectMany(s => State.CriteriaFor(s).Excluded));
        terms.AddRange(State.Global.Excluded);
        return terms
            .Where(RawExclusion.IsRaw)
            .Distinct(StringComparer.Ordinal)
            .ToList();
    }

    private void RemoveImportedExclusion(string exclusion)
    {
        State.WithSuppressedNotifications(() =>
        {
            if (State.Mode == "advanced")
                foreach (var slot in State.ActiveSlots())
                    if (State.CriteriaFor(slot).Excluded.Contains(exclusion, StringComparer.Ordinal))
                        State.RemoveExclude(slot, exclusion);
            if (State.Global.Excluded.Contains(exclusion, StringComparer.Ordinal))
                State.RemoveExclude(null, exclusion);
        });
    }

    private void ClearImportedTerms()
    {
        State.WithSuppressedNotifications(() =>
        {
            foreach (var (slot, pick) in ImportedAnyOf())
                State.RemoveInclude(slot, pick);
            State.SetExternalIncludes([]);
            if (State.Mode == "advanced")
                foreach (var slot in State.ActiveSlots())
                    State.CriteriaFor(slot).Excluded.RemoveAll(RawExclusion.IsRaw);
            State.Global.Excluded.RemoveAll(RawExclusion.IsRaw);
        });
    }

    private RenderFragment ImportedList() => __builder =>
    {
        var anyOf = ImportedAnyOf();
        var includes = State.ExternalIncludes;
        var excludes = ImportedExclusions();
        if (anyOf.Count > 0)
        {
            <div class="bd-logic"><span>@(ImportedAnyOfMatchAll ? "Must match" : "Any of")</span></div>
            <ul class="bd-list">
                @foreach (var item in anyOf.Select((Entry, Index) => (Entry, Index)))
                {
                    var term = RawText.Decode(item.Entry.Pick.ModId);
                    var blocks = item.Entry.Slot is null ? Model.ScopeBlocks(null) : Model.ScopeBlocks(item.Entry.Slot);
                    <li class="bd-row imported @(ReadOnly ? "ro" : "") @(_hotAnyOfIndex == item.Index ? "hot" : "")"
                        id="chip-import-any-@item.Index"
                        @onmouseenter="() => { _hotAnyOfIndex = item.Index; Model.Hot(blocks); }"
                        @onmouseleave="() => { _hotAnyOfIndex = null; Model.Cool(); }">
                        <span class="bd-what"><span class="bd-label"><span class="bd-text">@term</span></span></span>
                        <span class="bd-n" title="@($"{term.Length} characters as part of the pick group")">@term.Length<span class="bd-unit"> chars</span></span>
                        @if (!ReadOnly)
                        {
                            <button type="button" class="bd-x" id="chip-remove-import-any-@item.Index"
                                    title="@($"Remove custom text {term}")"
                                    aria-label="@($"Remove custom text {term}")"
                                    @onclick="() => State.RemoveInclude(item.Entry.Slot, item.Entry.Pick)">×</button>
                        }
                    </li>
                }
            </ul>
        }
        if (includes.Count > 0)
        {
            <div class="bd-logic"><span>Must match</span></div>
            <ul class="bd-list">
                @foreach (var item in includes.Select((Term, Index) => (Term, Index)))
                {
                    var block = Model.ExternalBlock(item.Term);
                    <li class="bd-row imported @(ReadOnly ? "ro" : "") @(block is not null && Model.IsHot(block.Index) ? "hot" : "")"
                        id="chip-import-inc-@item.Index"
                        @onmouseenter="() => { if (block is not null) Model.Hot(block.Index); }">
                        <span class="bd-what"><span class="bd-label"><span class="bd-text">@item.Term</span></span></span>
                        <span class="bd-n" title="@(block is null ? "" : $"{block.Cost} characters as its own block")">@if (block is not null) { @block.Cost<span class="bd-unit"> chars</span> }</span>
                        @if (!ReadOnly)
                        {
                            <button type="button" class="bd-x" id="chip-remove-import-inc-@item.Index"
                                    title="@($"Remove custom text {item.Term}")"
                                    aria-label="@($"Remove custom text {item.Term}")"
                                    @onclick="() => State.RemoveExternalInclude(item.Term)">×</button>
                        }
                    </li>
                }
            </ul>
        }
        if (excludes.Count > 0)
        {
            <div class="bd-logic"><span>None of</span></div>
            <ul class="bd-list">
                @foreach (var item in excludes.Select((Exclusion, Index) => (Exclusion, Index)))
                {
                    var term = RawExclusion.Decode(item.Exclusion);
                    var block = Model.ExcludeBlock(item.Exclusion);
                    <li class="bd-row exc imported @(ReadOnly ? "ro" : "") @(block is not null && Model.IsHot(block.Index) ? "hot" : "")"
                        id="chip-import-exc-@item.Index"
                        @onmouseenter="() => { if (block is not null) Model.Hot(block.Index); }">
                        <span class="bd-what"><span class="bd-label"><span class="bd-text">@term</span></span></span>
                        <span class="bd-n" title="@(block is null ? "" : $"{block.Cost} characters as its own block")">@if (block is not null) { @block.Cost<span class="bd-unit"> chars</span> }</span>
                        @if (!ReadOnly)
                        {
                            <button type="button" class="bd-x" id="chip-remove-import-exc-@item.Index"
                                    title="@($"Remove imported exclusion {term}")"
                                    aria-label="@($"Remove imported exclusion {term}")"
                                    @onclick="() => RemoveImportedExclusion(item.Exclusion)">×</button>
                        }
                    </li>
                }
            </ul>
        }
    };

    /// <summary>
    /// Prefer the shipped capability table so the box appears immediately and
    /// drawing a chip never triggers the value corpus. A missing table entry
    /// falls back to the live probe only after the scope is warm.
    /// </summary>
    private bool AcceptsMin(WantedMod pick, string? cls) =>
        Engine.PrecomputedMinCapability(pick, cls)
        ?? (Engine.IsValueScopeReady(cls) && Engine.CanApplyMin(pick, cls));

    private static IReadOnlyList<string> PickTierLines(ModFamily? family, ModTier tier) =>
        family is { IsUnion: true } or { IsDesecrated: true } or { IsImplicit: true }
            or { IsCorrupted: true }
            ? tier.UnionLines
            : tier.DisplayLines;

    private (string Text, string Css)? SourceFor(WantedMod pick)
    {
        var ids = pick.VariantModIds is { Count: > 0 } variants
            ? variants
            : (IReadOnlyList<string>)new[] { pick.ModId };
        return SourceFor(ids);
    }

    private (string Text, string Css)? SourceFor(string term)
    {
        var mod = Engine.FindMod(term);
        if (mod is not null) return SourceFor([mod.Id]);
        var byName = Engine.PlayableMods()
            .Where(m => (m.Source is "desecrated" or "implicit" or "corrupted") && m.Name == term)
            .ToList();
        return SourceFor(byName.Select(m => m.Id));
    }

    private (string Text, string Css)? SourceFor(IEnumerable<string> ids)
    {
        var mods = ids.Select(Engine.FindMod)
            .Where(m => m is not null)
            .Select(m => m!)
            .ToList();
        if (mods.Any(m => m.Source == "implicit")) return ("Implicit", "source-implicit");
        if (mods.Any(m => m.Source == "corrupted")) return ("Corrupted", "source-corrupted");
        if (mods.Any(m => m.Source is "augment" or "bonded"))
        {
            var text = ModFamilies.AugmentSourceTag(mods);
            if (text is not null)
                return (text, mods.Any(m => m.Source == "bonded")
                    ? "source-bonded"
                    : "source-augment");
        }
        var factions = mods
            .Where(m => m.Source == "desecrated")
            .Select(m => ModFamily.FactionName(m.Name))
            .Where(x => x.Length > 0)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(x => x, StringComparer.Ordinal)
            .ToList();
        return factions.Count == 0
            ? null
            : (string.Join(" / ", factions), "source-desecrated");
    }

    private async Task SetMin(string? slot, WantedMod pick, string? cls, ChangeEventArgs e)
    {
        var text = e.Value?.ToString()?.Trim();
        double? value = double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var v) && v > 0
            ? Math.Floor(v)
            : null;
        // Paint the working state before the (possibly first-use) compile, so
        // the first minimum never looks like a frozen input.
        _minBusy = pick;
        await InvokeAsync(StateHasChanged);
        // A min typed before the background warm-up finishes waits for the
        // chunked corpus load instead of blocking the UI thread.
        await Engine.PrewarmValuePathAsync(cls);
        State.SetMinValue(slot, pick, value);
        _minBusy = null;
        await InvokeAsync(StateHasChanged);
    }

    private string CostTitle(string slot, List<int> blocks)
    {
        var shared = State.ActiveSlots()
            .Where(s => s != slot && Model.ScopeBlocks(s).Intersect(blocks).Any())
            .Select(SearchModel.SlotLabel).Distinct().ToList();
        var what = blocks.Count == 1 ? "1 block" : $"{blocks.Count} blocks";
        return shared.Count == 0
            ? $"{Model.Cost(blocks)} characters in {what}"
            : $"{Model.Cost(blocks)} characters in {what}, shared with {string.Join(" and ", shared)}";
    }

    /// <summary>Base class under the slot name where the slot is not 1:1 with a class.</summary>
    private string? SlotSub(string slot)
    {
        if (slot is not ("weapon" or "offhand")) return null;
        var id = State.SlotClassOrDefault(slot);
        return Engine.Classes.FirstOrDefault(c => c.Id == id)?.Name ?? id;
    }

    private static string ChipKey(WantedMod pick) => pick switch
    {
        { IsNamePick: true } => $"{pick.ModId}-n-{string.Join('-', pick.Names!)}".Replace(' ', '_'),
        { VariantModIds.Count: > 0 } => $"{pick.ModId}-v",
        _ => pick.ModId,
    };

    private static string RemoveTitle(WantedMod pick, string label) =>
        pick.IsNamePick && pick.Names!.Count > 1
            ? $"Remove {label} or better ({string.Join(", ", pick.Names)})"
            : $"Remove {label}";
}
