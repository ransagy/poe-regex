@using PoeRegex.Core.Data
@using PoeRegex.Web.Core
@inject EngineService Engine

@if (Open)
{
    <div class="dlg-overlay" id="builder-dialog" @onclick="OnBackdrop">
        <div class="dlg dlg-builder" @onclick:stopPropagation="true" role="dialog" aria-label="Assemble item">
            <div class="panel-head"><span>Assemble test item from mods (enforced)</span></div>
            <div class="builder-cols">
                <div class="builder-left">
                    <div class="modrow">
                        <select id="builder-class" value="@_classId" @onchange="OnClass" aria-label="Builder class">
                            @foreach (var c in Engine.InGameClasses())
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                        <select id="builder-rarity" value="@_rarity" @onchange="e => { _rarity = e.Value?.ToString() ?? Rare; Refresh(); }" aria-label="Builder rarity">
                            <option value="Normal">Normal</option>
                            <option value="Magic">Magic</option>
                            <option value="Rare">Rare</option>
                        </select>
                    </div>
                    <div class="modrow">
                        <input id="builder-search" placeholder="type to filter mods…" value="@_search"
                               @oninput="OnSearch" aria-label="Builder mod filter" />
                    </div>
                    <ol class="suggest" aria-label="Builder suggestions">
                        @foreach (var fam in _families.Take(30))
                        {
                            var expanded = _search.Trim().Length > 0 || _expanded.Contains(fam.Key);
                            <li class="fam-block">
                                <div class="suggest-row fam-row">
                                    <span class="gen-tag" title="@(fam.IsPrefix ? "prefix" : "suffix")">@(fam.IsPrefix ? "prefix" : "suffix")</span>
                                    <button class="suggest-line fam-toggle" id="builder-fam-@fam.Anchor.Id"
                                            aria-expanded="@(expanded ? "true" : "false")"
                                            title="@(expanded ? "collapse" : $"expand {fam.Tiers.Count} tier(s)")"
                                            @onclick="() => Toggle(fam.Key)">
                                        <span class="fam-caret" aria-hidden="true">@(expanded ? "▾" : "▸")</span>
                                        <span class="fam-text">@fam.DisplayText</span>
                                        <span class="tier-count" title="@fam.Tiers.Count tier(s)">@fam.Tiers.Count</span>
                                    </button>
                                </div>
                                @if (expanded)
                                {
                                    <ul class="tier-list">
                                        @foreach (var tier in fam.Tiers)
                                        {
                                            <li class="suggest-row tier-row">
                                                <span class="tier-name" title="@tier.Name">@(tier.Name.Length > 0 ? tier.Name : tier.Anchor.Id)</span>
                                                <span class="suggest-line multi" title="@string.Join("\n", tier.DisplayLines)">
                                                    @foreach (var l in tier.DisplayLines)
                                                    {
                                                        <span class="mod-line">@l</span>
                                                    }
                                                </span>
                                                <button id="builder-add-@tier.Anchor.Id" class="btn" title="add &quot;@tier.Name&quot; (@tier.Anchor.GenerationType)"
                                                        @onclick="() => Add(tier.Anchor)">+</button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ol>
                    @foreach (var v in _violations)
                    {
                        <div class="@(v.Level == "error" ? "field-error" : "more")">@v.Level: @v.Message</div>
                    }
                </div>
                <div class="builder-right">
                    <input id="builder-name" placeholder="item name" value="@_name"
                           @oninput="e => _name = e.Value?.ToString() ?? string.Empty" aria-label="Built item name" />
                    <ItemPreview Item="PreviewItem()" Id="builder-preview" />
                    @if (_added.Count > 0)
                    {
                        <div class="chips" aria-label="Added mods">
                            @foreach (var id in _added)
                            {
                                <button class="chip inc" id="builder-del-@id" title="remove: @DisplayFor(id)"
                                        @onclick="() => Remove(id)">@ChipLabel(id)</button>
                            }
                        </div>
                    }
                </div>
            </div>
            @if (_saveError is not null)
            {
                <div class="field-error" id="builder-save-error">@_saveError</div>
            }
            <div class="modrow">
                <button id="builder-save" class="btn" disabled="@(_added.Count == 0 || _violations.Any(v => v.Level == "error"))"
                        @onclick="Save">Add</button>
                <button id="builder-cancel" class="btn" @onclick="Close">cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private const string Rare = "Rare";

    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    [Parameter, EditorRequired]
    public required bool Open { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback OnClose { get; set; }

    private string _classId = "Ring";
    private string _rarity = Rare;
    private string _search = "";
    private string _name = "";
    private IReadOnlyList<ModFamily> _families = [];
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private List<string> _added = [];
    private List<RuleViolation> _violations = [];
    private string? _saveError;

    protected override void OnParametersSet()
    {
        if (Open) Refresh();
    }

    private void Refresh()
    {
        var taken = _added.ToHashSet(StringComparer.Ordinal);
        var avail = Engine.ModsForClass(_classId).Where(m => !taken.Contains(m.Id)).ToList();
        var all = ModFamilies.Group(avail);
        var filter = _search.Trim();
        _families = filter.Length == 0
            ? all
            : all.Select(f => f with
              {
                  Tiers = f.Tiers
                      .Where(t => ModSearch.FilterMods(t.Members, filter).Count > 0).ToList(),
              })
              .Where(f => f.Tiers.Count > 0)
              .ToList();
        _violations = ItemRules.Validate(Engine,
            _added.Select(id => RuleLineFor(id)), _rarity).ToList();
    }

    private void Toggle(string key)
    {
        if (!_expanded.Add(key)) _expanded.Remove(key);
    }

    /// <summary>
    /// The item as it would be added: parsed text carries the name / class /
    /// rarity, mapped lines carry each catalog mod's stat lines. Feeds the
    /// live preview card and Save alike, so dialog and backpack agree.
    /// </summary>
    private TestItem PreviewItem()
    {
        var cls = Engine.PlayableClasses().FirstOrDefault(c => c.Id == _classId);
        var parsed = new ParsedItem(cls?.Name, _rarity,
            _name.Trim().Length > 0 ? _name.Trim() : $"Built {cls?.Name ?? _classId}",
            [], null, null, null, null, false, []);
        var item = new TestItem { Name = parsed.Name!, ClassId = _classId, Parsed = parsed, Built = true };
        foreach (var id in _added)
        {
            var mod = Engine.FindMod(id);
            if (mod is null) continue;
            var header = ItemTextParser.CatalogModHeader(mod);
            item.Mapped.Add(new MappedLine(header, header, [], [], id, IsHeader: true));
            foreach (var s in mod.StatLines)
                item.Mapped.Add(new MappedLine(s.Line, s.Line, [], [id], id));
        }
        return item;
    }

    /// <summary>Full stat text for a mod (chip tooltips, saved text).</summary>
    private string DisplayFor(string modId)
    {
        var mod = Engine.FindMod(modId);
        if (mod?.StatLines is { Count: > 0 } lines)
        {
            // Show every line as the item's actual text (no "×N" simplification).
            var text = string.Join(" \u00b7 ", lines.Select(ModSearch.DisplayLine));
            return text;
        }
        return modId;
    }

    private string ChipLabel(string modId)
    {
        var mod = Engine.FindMod(modId);
        return mod?.Name is { Length: > 0 } name ? name : modId;
    }

    private RuleLine RuleLineFor(string modId)
    {
        var mod = Engine.FindMod(modId);
        return new RuleLine(mod?.GenerationType.ToLowerInvariant() ?? "unknown", modId);
    }

    private void OnClass(ChangeEventArgs e)
    {
        _classId = e.Value?.ToString() ?? "Ring";
        _added.Clear();
        Refresh();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        Refresh();
    }

    private void Add(ModEntry m)
    {
        if (!_added.Contains(m.Id, StringComparer.Ordinal))
            _added.Add(m.Id);
        Refresh();
    }

    private void Remove(string id)
    {
        _added.Remove(id);
        Refresh();
    }

    private async Task Close()
    {
        _added.Clear();
        _name = "";
        _search = "";
        _saveError = null;
        await OnClose.InvokeAsync();
    }

    private void OnBackdrop()
    {
        _ = Close();
    }

    private void Save()
    {
        _saveError = null;
        if (_added.Count == 0 || _violations.Any(v => v.Level == "error")) return;
        if (!State.AddTestItem(PreviewItem()))
        {
            _saveError = "backpack is full — remove an item first";
            return;
        }
        _ = Close();
    }
}
