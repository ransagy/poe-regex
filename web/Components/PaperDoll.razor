@using PoeRegex.Web.Core

@*
  Paper doll: the nine gear slots arranged like the PoE2 inventory panel
  (hand-drawn CSS, no game assets). Slots are absolutely positioned in a
  fixed-aspect panel (like the game: fixed frames, not a shared grid).
  Positions are the author's reading, TO-CONFIRM (Phase 3 QA).
*@
<div class="doll @(State.Mode == "global" ? "dimmed" : "")" aria-label="Equipment" aria-disabled="@(State.Mode == "global")">
    @foreach (var slot in GearSlot.All)
    {
        var active = State.ActiveSlots().Contains(slot.Id);
        <button id="slot-@slot.Id"
                class="gear-slot @(active ? "active" : "")"
                style="@Placement(slot)"
                aria-pressed="@active"
                title="@slot.Label"
                @onclick="() => State.SelectSlot(slot.Id)">
            <span class="gear-label">@slot.Label</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    // Percent geometry in a 100x100 panel (maintainer-directed arrangement):
    // weapon tall-left at armour height, offhand tall-right, helmet top-center,
    // body center, amulet above the offhand and right of the helmet, rings
    // flanking the body's bottom edge, boots under the offhand, belt under
    // the body, gloves under the weapon and left of the belt.
    private static string Placement(GearSlot slot) => slot.Id switch
    {
        "weapon" => "left:2%; top:24%; width:17%; height:40%;",
        "helmet" => "left:23%; top:4%; width:24%; height:16%;",
        "body" => "left:23%; top:24%; width:24%; height:40%;",
        "ring1" => "left:14%; top:55%; width:9%; height:9%;",
        "amulet" => "left:51%; top:4%; width:11%; height:11%;",
        "offhand" => "left:64%; top:24%; width:17%; height:40%;",
        "ring2" => "left:49%; top:55%; width:9%; height:9%;",
        "gloves" => "left:2%; top:68%; width:17%; height:12%;",
        "belt" => "left:23%; top:68%; width:24%; height:12%;",
        "boots" => "left:64%; top:68%; width:17%; height:12%;",
        _ => "",
    };
}
