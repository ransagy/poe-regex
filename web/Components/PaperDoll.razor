@using PoeRegex.Web.Core

@*
  Paper doll: the nine gear slots arranged like the PoE2 inventory panel
  (hand-drawn CSS, no game assets). Slots are absolutely positioned in a
  fixed-aspect panel (like the game: fixed frames, not a shared grid).
  Positions follow the in-game panel (maintainer-reviewed).
*@
<div class="doll @(State.Mode == "global" ? "dimmed" : "")" aria-label="Equipment" aria-disabled="@(State.Mode == "global")">
    @foreach (var slot in GearSlot.All)
    {
        var active = State.ActiveSlots().Contains(slot.Id);
        <button id="slot-@slot.Id"
                class="gear-slot @(active ? "active" : "")"
                style="@Placement(slot)"
                aria-pressed="@active"
                title="@slot.Label"
                @onclick="() => State.SelectSlot(slot.Id)">
            <span class="gear-label">@slot.Label</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    // Percent geometry in a 100x100 panel, read from the in-game gear panel
    // (footprint ratios: weapons/body 2x4, helmet/gloves/boots 2x2, belt 2x1,
    // amulet/rings 1x1). Weapon/offhand tops sit just under the helmet top and
    // their bottoms are level with the rings' bottoms; helmet on the body;
    // rings in the outer gutters, bottom-aligned on the gloves/boots line;
    // amulet in the right ring's column with its top level with the helmet
    // bottom; belt under the body, bottom-aligned with gloves/boots; weapon
    // and offhand are inset so their inner edges reach about a third of the
    // way across the glove/boot boxes' outer edge (gutters kept to both the
    // gloves/boots and the rings); glove inner edges flush with the ring
    // columns. Helmet/gloves/boots are exact squares (18x24 in the 4:3
    // panel); weapon/offhand match the body column width. Gutters between
    // every pair of slots; panel is 4:3 so the cells render square.
    private static string Placement(GearSlot slot) => slot.Id switch
    {
        "weapon" => "left:2.5%; top:5%; width:23%; height:63%;",
        "helmet" => "left:41%; top:4%; width:18%; height:24%;",
        "body" => "left:38.5%; top:30%; width:23%; height:48%;",
        "ring1" => "left:27.5%; top:56%; width:9%; height:12%;",
        "amulet" => "left:63.5%; top:27%; width:9%; height:12%;",
        "offhand" => "left:74.5%; top:5%; width:23%; height:63%;",
        "ring2" => "left:63.5%; top:56%; width:9%; height:12%;",
        "gloves" => "left:18.5%; top:70%; width:18%; height:24%;",
        "belt" => "left:38.5%; top:82%; width:23%; height:12%;",
        "boots" => "left:63.5%; top:70%; width:18%; height:24%;",
        _ => "",
    };
}
