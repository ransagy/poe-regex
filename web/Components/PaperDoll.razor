@using PoeRegex.Web.Core

@*
  Paper doll: the nine gear slots arranged like the PoE2 inventory panel
  (hand-drawn CSS, no game assets). Slots are absolutely positioned in a
  fixed-aspect panel (like the game: fixed frames, not a shared grid).
  Positions follow the in-game panel (maintainer-reviewed).
*@
<div class="doll @(State.Mode == "global" ? "dimmed" : "")" aria-label="Equipment" aria-disabled="@(State.Mode == "global")">
    @foreach (var slot in GearSlot.All)
    {
        var active = State.ActiveSlots().Contains(slot.Id);
        <button id="slot-@slot.Id"
                class="gear-slot @(active ? "active" : "")"
                style="@Placement(slot)"
                aria-pressed="@active"
                title="@slot.Label"
                @onclick="() => State.SelectSlot(slot.Id)">
            <span class="gear-label">@slot.Label</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    // Percent geometry in a 100x100 panel, read from the in-game gear panel.
    // Weapon/offhand tops sit just under the helmet top and their bottoms are
    // level with the rings' bottoms; helmet on the body; rings in the outer
    // gutters, bottom-aligned on the gloves/boots line; amulet in the right
    // ring's column with its top level with the helmet bottom; belt under the
    // body, bottom-aligned with gloves/boots; glove/boot inner edges flush
    // with the ring columns. The 2-cell slots share one 23-wide class: the
    // helmet/gloves/boots are equal exact squares (23x30.67) and the body a
    // taller 23x47.33 slab between the helmet and belt. Gutters between every
    // pair of slots; panel is 4:3 so the cells render square.
    private static string Placement(GearSlot slot) => slot.Id switch
    {
        "weapon" => "left:2.5%; top:5%; width:23%; height:60.33%;",
        "helmet" => "left:38.5%; top:4%; width:23%; height:30.67%;",
        "body" => "left:38.5%; top:36.67%; width:23%; height:47.33%;",
        "ring1" => "left:27.5%; top:53.33%; width:9%; height:12%;",
        "amulet" => "left:63.5%; top:33.67%; width:9%; height:12%;",
        "offhand" => "left:74.5%; top:5%; width:23%; height:60.33%;",
        "ring2" => "left:63.5%; top:53.33%; width:9%; height:12%;",
        "gloves" => "left:13.5%; top:67.33%; width:23%; height:30.67%;",
        "belt" => "left:38.5%; top:86%; width:23%; height:12%;",
        "boots" => "left:63.5%; top:67.33%; width:23%; height:30.67%;",
        _ => "",
    };
}
