@using PoeRegex.Web.Core

@*
  Paper doll: the nine gear slots arranged like the PoE2 inventory panel
  (hand-drawn CSS, no game assets). Slots are absolutely positioned in a
  fixed-aspect panel (like the game: fixed frames, not a shared grid).
  Positions are the author's reading, TO-CONFIRM (Phase 3 QA).
*@
<div class="doll @(State.Mode == "global" ? "dimmed" : "")" aria-label="Equipment" aria-disabled="@(State.Mode == "global")">
    @foreach (var slot in GearSlot.All)
    {
        var active = State.ActiveSlots().Contains(slot.Id);
        <button id="slot-@slot.Id"
                class="gear-slot @(active ? "active" : "")"
                style="@Placement(slot)"
                aria-pressed="@active"
                title="@slot.Label"
                @onclick="() => State.SelectSlot(slot.Id)">
            <span class="gear-label">@slot.Label</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required WorkbenchState State { get; set; }

    // Percent geometry in a 100x100 panel (maintainer-directed arrangement
    // with game footprint ratios: weapons/body 2x4, helmet/gloves/boots 2x2,
    // belt 2x1, amulet/rings 1x1). Belt under the body; gloves under the
    // weapon with matching right edges (clear of the belt); boots under the
    // offhand; amulet aligned to the offhand's left edge; rings in the
    // weapon/body gutters, bottom-aligned, no overlaps.
    private static string Placement(GearSlot slot) => slot.Id switch
    {
        "weapon" => "left:2%; top:24%; width:20%; height:44%;",
        "helmet" => "left:34%; top:2%; width:20%; height:22%;",
        "body" => "left:34%; top:24%; width:20%; height:44%;",
        "ring1" => "left:23%; top:53%; width:10%; height:11%;",
        "amulet" => "left:66%; top:9%; width:10%; height:11%;",
        "offhand" => "left:66%; top:24%; width:20%; height:44%;",
        "ring2" => "left:55%; top:53%; width:10%; height:11%;",
        "gloves" => "left:2%; top:68%; width:20%; height:22%;",
        "belt" => "left:34%; top:79%; width:20%; height:11%;",
        "boots" => "left:66%; top:68%; width:20%; height:22%;",
        _ => "",
    };
}
