@page "/"
@using PoeRegex.Core
@using PoeRegex.Core.Compilation
@using PoeRegex.Core.Data
@using PoeRegex.Web.Core
@using web.Services
@inject EngineService Engine
@inject WorkbenchState State
@inject web.Services.PersistenceService Persistence
@inject web.Services.IntroState Intro
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Renly's Recipes</PageTitle>

<div class="bench mode-@State.Mode">
    @if (Intro.Visible == true)
    {
        <div class="intro-top">
            <IntroPanel IdSuffix="-top" OnDismiss="DismissIntro" />
        </div>
    }
    <SearchBar Model="_model" State="State" Unresolved="@UnresolvedDiagnostics()">
        <Tools>
            <div class="hero-checks" role="group" aria-label="Check the string">
                <button type="button" class="tool-toggle @(_panel == "items" ? "on" : "")" id="test-lab-toggle"
                        aria-expanded="@(_panel == "items" ? "true" : "false")" aria-controls="test-lab-body"
                        @onclick='() => TogglePanel("items")'>
                    <svg class="tool-chev" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 4.5L6 8L9.5 4.5" /></svg>
                    Test on items
                    <span class="tool-count">@State.TestItems.Count</span>
                    @if (_dimNonMatching && State.TestItems.Count > 0)
                    {
                        <span class="tool-sub">@_highlight.Count lit</span>
                    }
                </button>
                <button type="button" class="tool-toggle @(_panel == "details" ? "on" : "")" id="more-info-toggle"
                        aria-expanded="@(_panel == "details" ? "true" : "false")" aria-controls="more-info"
                        @onclick='() => TogglePanel("details")'>
                    <svg class="tool-chev" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 4.5L6 8L9.5 4.5" /></svg>
                    What it matches
                </button>
            </div>
            <div class="hero-lib">
                <RecipeMenu State="State" Version="_recipesVersion" />
                <button type="button" class="btn" id="query-import-open"
                        title="Turn a search string back into picks" @onclick="() => _queryImportOpen = true">Import string</button>
            </div>
        </Tools>
    </SearchBar>

    @if (_panel == "items")
    {
        <section class="drawer" id="test-lab-body" aria-label="Test items">
            <div class="drawer-head">
                <p class="drawer-lead">Items the string matches light up; the rest dim. Click an item to read it.</p>
                <div class="pack-tools">
                    <button id="import-open" class="btn" @onclick="() => _importOpen = true">Import item</button>
                    <button id="builder-open" class="btn" @onclick="() => _builderOpen = true">Assemble item</button>
                    <button id="pack-remove" class="btn" disabled="@(State.SelectedItemId is null)"
                            title="@RemoveTitle()" @onclick="RemoveSelected">Remove</button>
                    <HelpTip Title="What test items are for" Class="help-right">
                        <ul>
                            <li><b>Import item</b> pastes items copied from the game.</li>
                            <li><b>Assemble item</b> builds one from catalog mods.</li>
                            <li>Items the search string matches light up; the rest dim.</li>
                        </ul>
                    </HelpTip>
                </div>
            </div>
            <div class="pack-wrap">
                <BackpackGrid State="State" HighlightIds="_highlight" DimNonMatching="_dimNonMatching" OnPick="PickItem" />
            </div>
        </section>
    }
    @if (_panel == "details")
    {
        <section class="drawer" id="more-info" aria-label="What the string matches">
            @if (_model.Query.Length == 0)
            {
                <p class="drawer-lead">Add picks first. This panel then lists the mods each part of the string matches.</p>
            }
            else
            {
                <p class="drawer-lead">Each slot's own string, with the catalog mods it matches. Use it to check that nothing extra lights up.</p>
                <div class="drawer-grid">
                    @if (_paste is not null)
                    {
                        <div class="qcard" id="combined-paste">
                            <div class="qcard-head">
                                <span class="qcard-title">How the combined string is built</span>
                                <span class="meter-num @(_paste.Exceeded ? "over" : "")">@_paste.Length / @_paste.Limit</span>
                            </div>
                            <dl class="qparts">
                                <dt>Item classes</dt>
                                <dd><code>@_paste.Anchor</code></dd>
                                @foreach (var g in _paste.Groups)
                                {
                                    <dt>@g.Label</dt>
                                    <dd><code>@g.Token</code></dd>
                                }
                            </dl>
                            @foreach (var d in _paste.Diagnostics)
                            {
                                <div class="qdiag">@d.Level @d.Code: @d.Message</div>
                            }
                            <p class="more">Excluded mods apply to every slot. Slots of the same item class share one block.</p>
                        </div>
                    }
                    @foreach (var t in _tasks)
                    {
                        <QueryCard CardId="@t.CardId" Title="@t.Title" ItemClass="@t.ItemClass" Result="@t.Result" />
                    }
                </div>
            }
        </section>
    }
    @if (_notice is not null)
    {
        <p class="bench-notice" role="status">
            @_notice
            <button type="button" class="link" id="notice-dismiss" @onclick="() => _notice = null">Dismiss</button>
        </p>
    }

    <div class="bench-bar">
        <ModeSwitch State="State" />
    </div>

    <div class="bench-main">
        @if (State.Mode == "advanced")
        {
            <aside class="col-doll" aria-label="Gear slots">
                <PaperDoll State="State" />
            </aside>
        }
        <section class="col-picker" aria-label="Mods">
            @if (State.Mode == "advanced")
            {
                @if (State.FocusedSlot is { } focus)
                {
                    <div class="col-head">
                        <h2 class="col-title">@(GearSlot.ById(focus)?.Label ?? focus)</h2>
                        @if (focus is "weapon" or "offhand")
                        {
                            <select class="col-class" id="slot-class-@focus" aria-label="@(GearSlot.ById(focus)?.Label) base class"
                                    value="@State.SlotClassOrDefault(focus)" @onchange="e => SetClass(focus, e)">
                                @foreach (var cls in ClassOptions(focus))
                                {
                                    <option value="@cls.Id">@cls.Name</option>
                                }
                            </select>
                        }
                    </div>
                    <ModPicker State="State" Scope="@focus" Mods="@RailMods" />
                }
                else
                {
                    <p class="col-empty">Choose a gear slot to see the mods it can roll.</p>
                }
            }
            else
            {
                <ModPicker State="State" Scope="@null" Mods="@RailMods" />
            }
        </section>
        <div class="col-out">
            @if (Intro.Visible == true)
            {
                <div class="intro-side">
                    <IntroPanel IdSuffix="-side" OnDismiss="DismissIntro" />
                </div>
            }
            <PickBreakdown Model="_model" State="State" />
        </div>
    </div>

    <ImportPanel State="State" Open="_importOpen" OnClose="CloseImport" />
    <QueryImportPanel State="State" Open="_queryImportOpen" OnClose="CloseQueryImport" />
    <ItemBuilder State="State" Open="_builderOpen" OnClose="CloseBuilder" />
</div>

<footer class="shell-foot">
    <span id="engine-status">@_engineStatus</span>
    <span class="@(Engine.DataReady ? "" : "warn")" id="data-stamp"
          title="Catalog data version, target model, and exact table status">
        Data @Engine.DataVersion, @Engine.TargetModel, @(Engine.DataReady ? "exact table" : "exact table missing")
    </span>
    <BuildStamp />
    <span class="legal-links">
        <a href="license.txt" target="_blank" rel="noopener noreferrer">License</a>
        <a href="notice.txt" target="_blank" rel="noopener noreferrer">Notice</a>
        <a href="provenance.md" target="_blank" rel="noopener noreferrer">Data provenance</a>
    </span>
    <button id="workbench-reset" class="link foot-reset" title="Clears every slot's class and mods, and the test items"
            @onclick="ResetWorkbench">Reset workbench</button>
</footer>

<ItemTooltip Item="@SelectedItem()" X="_ttX" Y="_ttY" OnDismiss="DismissTooltip" />

@if (_stale)
{
    <div class="dlg-overlay" id="stale-overlay">
        <div class="dlg" role="dialog" aria-modal="true" aria-labelledby="stale-title">
            <h2 class="panel-head" id="stale-title">
                @(_staleShared ? "Shared recipe opened in another tab" : "Workbench changed in another tab")
            </h2>
            <p class="more">
                @(_staleShared
                    ? "A shared recipe was opened in another tab. This tab is frozen so it cannot overwrite the new workbench."
                    : "Another tab changed the workbench. This tab is frozen so it cannot overwrite the newer state.")
            </p>
            @if (_staleBackup == BackupOutcome.Added)
            {
                <p class="more">Your picks from this tab were saved under Recipes.</p>
            }
            else if (_staleBackup == BackupOutcome.AlreadyPresent)
            {
                <p class="more">Your picks from this tab are already saved under Recipes.</p>
            }
            <div class="modrow">
                <button type="button" class="btn btn-primary" id="stale-reload" @ref="_staleReload" @onclick="ReloadStale">Reload</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record TaskView(
        string CardId, string Title, string? ItemClass, CompileResult Result);

    private enum BackupOutcome { Added, AlreadyPresent, Failed }

    private string _engineStatus = "booting...";
    private List<TaskView> _tasks = [];
    private List<TaskView> _barTasks = [];
    private List<(string Label, string? Query)> _labelledQueries = [];
    private HashSet<string> _highlight = [];
    private bool _dimNonMatching;
    private bool _importOpen;
    private bool _queryImportOpen;
    private bool _builderOpen;
    private string? _panel;
    private SearchModel _model = null!;
    private MultiPasteResult? _paste;
    private double _ttX;
    private double _ttY;
    private string? _notice;
    private int _recipesVersion;
    private bool _openingShared;
    private bool _stale;
    private bool _staleShared;
    private BackupOutcome? _staleBackup;
    private bool _staleFocus;
    private bool _disposed;
    private ElementReference _staleReload;
    private DotNetObjectReference<Home>? _tabRef;
    private readonly HashSet<string> _warmedValueKeys = new(StringComparer.Ordinal);
    private bool _warmScheduled;

    protected override void OnInitialized()
    {
        _model = new SearchModel(Engine, State);
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Intro.Changed += OnIntroChanged;
        await Intro.InitializeAsync();
        _engineStatus = $"Engine ready, {Engine.InGameClasses().Count()} item classes";
        var saved = await Persistence.LoadAsync();
        if (saved is not null)
            WorkbenchSnapshot.Restore(State, saved);
        // Silently refresh builder-assembled items against the current catalog so
        // lines saved under an older (buggy) renderer text stop displaying.
        var healed = false;
        foreach (var item in State.TestItems)
            if (item.Reheal(Engine)) healed = true;
        if (healed) _ = Persistence.SaveAsync(WorkbenchSnapshot.Capture(State));
        await OpenSharedRecipeAsync();
        Recompute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_stale && _staleFocus)
        {
            _staleFocus = false;
            try { await _staleReload.FocusAsync(); } catch { }
        }
        if (!firstRender || _disposed) return;
        _tabRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("poeRegexWatchTabs", _tabRef); }
        catch
        {
            // Cross-tab handoff is best-effort.
            _tabRef.Dispose();
            _tabRef = null;
        }
        // Warm the value-threshold corpus after the first paint so the first
        // minimum is immediate; see PrewarmValuePath.
        ScheduleValuePrewarm();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed || _stale) return;
        if (RecipeCodec.TokenFromFragment(new Uri(e.Location).Fragment) is not null)
            _ = OpenSharedRecipeFromNavigationAsync();
    }

    private async Task OpenSharedRecipeFromNavigationAsync()
    {
        try
        {
            await OpenSharedRecipeAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _notice = "That share link could not be read, so your picks are unchanged.";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>A share link replaces the picks; earlier picks are saved as a recipe first so nothing is lost.</summary>
    private async Task OpenSharedRecipeAsync()
    {
        var token = RecipeCodec.TokenFromFragment(new Uri(Nav.Uri).Fragment);
        if (token is null || _openingShared || _stale) return;
        _openingShared = true;
        try
        {
            try { await JS.InvokeVoidAsync("history.replaceState", null, "", Nav.BaseUri); }
            catch { }
            var shared = RecipeCodec.Decode(token);
            if (shared is null)
            {
                _notice = "That share link could not be read, so your picks are unchanged.";
                return;
            }
            var hadPicks = State.Global.Included.Count + State.Global.Excluded.Count > 0 ||
                           State.Slots.Values.Any(c => c.Included.Count + c.Excluded.Count > 0);
            if (hadPicks && await BackupPicksAsync("Before shared link") == BackupOutcome.Added)
                _recipesVersion++;
            WorkbenchSnapshot.RestoreCriteria(State, shared);
            // Persist before announcing the handoff so another tab cannot
            // reload into the previous workbench.
            await Persistence.SaveAsync(WorkbenchSnapshot.Capture(State));
            await Persistence.MarkSharedHandoffAsync();
            _notice = hadPicks
                ? "Opened a shared recipe. Your earlier picks are saved under Recipes."
                : "Opened a shared recipe.";
        }
        finally
        {
            _openingShared = false;
        }
    }

    private async Task<BackupOutcome> BackupPicksAsync(string prefix)
    {
        try
        {
            var current = RecipeCodec.CaptureCriteria(State);
            var fingerprint = RecipeCodec.Encode(current);
            var recipes = await Persistence.LoadRecipesAsync();
            if (recipes.Any(r =>
                    string.Equals(RecipeCodec.Encode(r.Snapshot), fingerprint, StringComparison.Ordinal)))
                return BackupOutcome.AlreadyPresent;

            recipes.Insert(0, new SavedRecipe(
                $"{prefix}, {DateTime.Now:yyyy-MM-dd HH:mm}",
                DateTimeOffset.UtcNow, current));
            await Persistence.SaveRecipesAsync(recipes);
            return BackupOutcome.Added;
        }
        catch
        {
            return BackupOutcome.Failed;
        }
    }

    [JSInvokable]
    public Task OnSharedRecipeOpenedElsewhere() => FreezeStaleAsync(shared: true);

    [JSInvokable]
    public Task OnWorkbenchChangedInOtherTab() => FreezeStaleAsync(shared: false);

    private async Task FreezeStaleAsync(bool shared)
    {
        if (_disposed || _stale) return;
        _stale = true;
        _staleShared = shared;
        var hadPicks = State.Global.Included.Count + State.Global.Excluded.Count > 0 ||
                       State.Slots.Values.Any(c => c.Included.Count + c.Excluded.Count > 0);
        if (hadPicks)
            _staleBackup = await BackupPicksAsync(shared
                ? "Before shared link (other tab)"
                : "Before external change (other tab)");
        _staleFocus = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadStale()
    {
        try { await JS.InvokeVoidAsync("poeRegexReload"); }
        catch { Nav.NavigateTo(Nav.BaseUri, forceLoad: true); }
    }

    private Task DismissIntro() => Intro.DismissAsync();

    private void OnIntroChanged() => InvokeAsync(StateHasChanged);

    private void CloseImport() => _importOpen = false;
    private void CloseQueryImport() => _queryImportOpen = false;

    private void CloseBuilder() => _builderOpen = false;

    /// <summary>One check panel at a time; closing test items also dismisses a pinned item card.</summary>
    private void TogglePanel(string panel)
    {
        _panel = _panel == panel ? null : panel;
        if (_panel != "items") State.SelectTestItem(null);
    }

    private void OnStateChanged()
    {
        if (_stale || _disposed) return;
        Recompute();
        _ = Persistence.SaveAsync(WorkbenchSnapshot.Capture(State));
        InvokeAsync(StateHasChanged);
        // After the pick paints, warm the value path for the scope so the
        // first min entry is immediate.
        ScheduleValuePrewarm();
    }

    /// <summary>
    /// Warm the real-line corpus for the editing scope in the background so a
    /// min entry never pays the lazy index build. Only runs when a pick in the
    /// scope can actually take a minimum, and once per scope.
    /// </summary>
    private void ScheduleValuePrewarm()
    {
        if (_disposed || _warmScheduled) return;
        var targets = ValuePrewarmTargets.For(State, Engine)
            .Where(t => !_warmedValueKeys.Contains(t.Key))
            .ToList();
        if (targets.Count == 0) return;
        _warmScheduled = true;
        _ = PrewarmAsync(targets);
    }

    private async Task PrewarmAsync(IReadOnlyList<(string Key, string? ItemClass)> targets)
    {
        try
        {
            // Let the pick that triggered this paint first.
            await Task.Yield();
            if (_disposed) return;
            foreach (var (key, itemClass) in targets)
            {
                if (_warmedValueKeys.Contains(key)) continue;
                try
                {
                    await Engine.PrewarmValuePathAsync(itemClass);
                }
                catch
                {
                    // Warm-up is best effort; remember the attempt so a failed
                    // scope does not retry forever.
                }
                _warmedValueKeys.Add(key);
                if (_disposed) return;
                // Show this scope's min boxes before starting the next class.
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1);
            }
        }
        finally
        {
            _warmScheduled = false;
        }
        // New picks/classes may have appeared while the corpus was loading.
        if (!_disposed) ScheduleValuePrewarm();
    }

    private async Task CopyBar(string query)
    {
        try { await JS.InvokeAsync<string>("poeRegexCopy", query); }
        catch { }
    }

    /// <summary>Pack tile click: pin the tooltip at the cursor; same tile dismisses.</summary>
    private void PickItem((string Id, double X, double Y) pick)
    {
        if (State.SelectedItemId == pick.Id)
        {
            State.SelectTestItem(null);
            return;
        }
        _ttX = pick.X;
        _ttY = pick.Y;
        State.SelectTestItem(pick.Id);
    }

    private void DismissTooltip() => State.SelectTestItem(null);

    private void RemoveSelected()
    {
        if (State.SelectedItemId is { } id)
            State.RemoveTestItem(id);
    }

    private string RemoveTitle() => SelectedItem() is { } item
        ? $"Remove {item.Name} from the backpack"
        : "Select an item in the backpack first";

    private void Recompute()
    {
        var tasks = new List<TaskView>();
        _paste = null;
        if (State.Mode == "simple")
        {
            tasks.Add(CompileTask("simple", "All gear", null, State.Global));
        }
        else
        {
            var active = State.ActiveSlots();
            foreach (var s in active)
            {
                var crit = State.CriteriaFor(s);
                var label = GearSlot.ById(s)?.Label ?? s;
                var cls = ClassName(crit.ClassId);
                tasks.Add(CompileTask(s, string.Equals(label, cls, StringComparison.OrdinalIgnoreCase) ? label : $"{label} ({cls})", crit.ClassId, crit));
            }
            if (active.Count > 0)
            {
                // Over-budget pastes keep their value: the strip shows the full
                // string with the k/N meter in its over state (allowOverflow
                // never throws); the in-game box is the judge, not the compiler.
                _paste = Engine.Combine(
                    active.Select(s =>
                    {
                        var crit = State.CriteriaFor(s);
                        return ($"{s} ({crit.ClassId})", crit.ClassId, (IEnumerable<WantedMod>)crit.Included, crit.MatchAll);
                    }),
                    active.SelectMany(s => State.CriteriaFor(s).Excluded)
                        .Concat(State.Global.Excluded).Distinct(StringComparer.Ordinal),
                    allowOverflow: true);
            }
        }
        _tasks = tasks;
        _barTasks = State.Mode == "advanced" ? [] : tasks;
        _labelledQueries = State.Mode == "advanced" && _paste is not null
            ? [("combined paste", _paste.Query)]
            : tasks.Select(t => (t.Title, (string?)t.Result.Query)).ToList();
        var queries = _labelledQueries
            .Where(q => !string.IsNullOrWhiteSpace(q.Query)).Select(q => q.Query!).ToList();
        // Highlight/dim only once the active scope actually has mods picked:
        // an anchor-only query (no chips) stays neutral.
        var chipsPicked = State.Mode == "simple"
            ? State.Global.Included.Count > 0 || State.Global.Excluded.Count > 0
            : State.ActiveSlots().Count > 0;
        _highlight = chipsPicked
            ? State.TestItems
                .Where(item => queries.Any(q => ItemMatcher.Match(q, item.MatchLines()).Match))
                .Select(item => item.Id).ToHashSet()
            : [];
        _dimNonMatching = chipsPicked && queries.Count > 0;
        _model.Update(_barTasks.FirstOrDefault()?.Result, _paste);
    }

    /// <summary>Selected backpack item (null when none or it was removed).</summary>
    private TestItem? SelectedItem() =>
        State.SelectedItemId is { } id ? State.TestItems.FirstOrDefault(i => i.Id == id) : null;

    private TaskView CompileTask(string cardId, string title, string? itemClass, SlotCriteria crit)
    {
        // allowOverflow: a picked string always keeps its value; over-budget
        // states render with the k/N meter instead of a placeholder.
        var result = Engine.CompilePicks(crit.Included, crit.Excluded, crit.MatchAll, itemClass);
        return new TaskView(cardId, title, itemClass, result);
    }

    /// <summary>Distinct skipped picks across the visible compiles and the combined paste.</summary>
    private List<CompilerDiagnostic> UnresolvedDiagnostics() =>
        _tasks.SelectMany(t => t.Result.Diagnostics)
            .Concat(_paste?.Diagnostics ?? [])
            .Where(d => d.Code == "unresolved-modifier")
            .GroupBy(d => d.Message, StringComparer.Ordinal)
            .Select(g => g.First())
            .ToList();

    /// <summary>Mods for the picker scope (empty while advanced is unfocused).</summary>
    private IReadOnlyList<ModEntry> RailMods =>
        State.Mode == "simple"
            ? Engine.PlayableMods()
            : State.FocusedSlot is { } focus
                ? Engine.ModsForClass(State.SlotClassOrDefault(focus))
                : [];

    private string ClassName(string classId) =>
        Engine.Classes.FirstOrDefault(c => c.Id == classId)?.Name ?? classId;

    /// <summary>Classes fitting the slot; a saved class that no longer fits stays listed so nobody gets stranded.</summary>
    private IEnumerable<ItemClassEntry> ClassOptions(string slotId)
    {
        var playable = Engine.InGameClasses().ToList();
        var allowed = SlotClasses.AllowedFor(slotId, playable.Select(c => c.Id)).ToHashSet();
        var current = State.SlotClassOrDefault(slotId);
        return playable.Where(c => allowed.Contains(c.Id) || c.Id == current);
    }

    private void SetClass(string slotId, ChangeEventArgs e)
    {
        if (e.Value is string id && id.Length > 0)
            State.SetSlotClass(slotId, id);
    }
    private async Task ResetWorkbench()
    {
        await Persistence.ClearAsync();
        State.Reset(); // notifies -> recompute + save of defaults
    }

    public void Dispose()
    {
        _disposed = true;
        State.Changed -= OnStateChanged;
        Intro.Changed -= OnIntroChanged;
        Nav.LocationChanged -= OnLocationChanged;
        try { _ = JS.InvokeVoidAsync("poeRegexUnwatchTabs"); } catch { }
        _tabRef?.Dispose();
        _tabRef = null;
    }
}
