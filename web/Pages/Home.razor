@page "/"
@using PoeRegex.Core
@using PoeRegex.Core.Compilation
@using PoeRegex.Core.Data
@using PoeRegex.Web.Core
@inject EngineService Engine
@inject WorkbenchState State
@inject web.Services.PersistenceService Persistence
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Renly's Recipes</PageTitle>

<div class="bench">
    <section class="panel inventory mode-@State.Mode" aria-label="Inventory">
        @{
            var barQuery = BarQuery();
            var scopeText = ScopeText();
        }
        @if (_showIntro == true)
        {
            <IntroPanel OnDismiss="DismissIntro" />
        }
        else if (_showIntro == false)
        {
            <div class="intro-link-row">
                <button type="button" class="intro-link" id="intro-open" @onclick="ShowIntro">how it works</button>
            </div>
        }

        <div class="mode-bar">
            <span class="section-label">search mode</span>
            <ModeSwitch State="State" />
        </div>

        <div class="inv-top">
            @if (State.Mode == "advanced")
            {
                <div class="inv-doll">
                    <PaperDoll State="State" />
                </div>
            }
            <div class="inv-editor" aria-label="Mods to find">
                @if (State.Mode == "advanced")
                {
                    @if (State.FocusedSlot is not null)
                    {
                        <ModPicker State="State" Scope="@State.FocusedSlot" Mods="@RailMods" />
                    }
                    else
                    {
                        <div class="hint">click a slot on the doll to pick its mods</div>
                    }
                }
                else
                {
                    <ModPicker State="State" Scope="@null" Mods="@RailMods" />
                }
            </div>
        </div>

        <PicksRail State="State" Scope="@RailScope" Mods="@RailMods" ShowHint="@RailHint" Label="selected mods" />

        <div class="result-bar">
            <div class="rb-head">
                <span class="rb-label">Your search string</span>
                @if (scopeText.Length > 0)
                {
                    <span class="rb-scope">@scopeText</span>
                }
                @if (UnresolvedDiagnostics() is { Count: > 0 } unresolved)
                {
                    <span class="rb-unresolved" id="rb-unresolved" title="@UnresolvedTitle(unresolved)">@unresolved.Count unresolved</span>
                }
                <span class="rb-hint">copy → paste into the game's item search</span>
            </div>
            <div class="result-strip" id="result-strip" aria-label="Compiled search string">
                @if (barQuery.Length > 0)
                {
                    @if (State.Mode == "advanced" && _paste is not null)
                    {
                        <div class="slot-query @(_paste.Exceeded ? "over" : "")" id="slot-query-advanced">
                            <code title="@_paste.Query">@_paste.Query</code>
                            <span class="meter-num" title="@MeterTitle(_paste.Length, _paste.Limit)">
                                @_paste.Length/@_paste.Limit@(_paste.Exceeded ? " OVER" : "")
                            </span>
                            <button id="slot-copy-advanced" @onclick="() => CopyBar(_paste.Query)">copy</button>
                        </div>
                    }
                    else
                    {
                        @foreach (var t in _barTasks)
                        {
                            <div class="slot-query @(t.Result.Exceeded ? "over" : "")" id="slot-query-@t.CardId">
                                <code title="@t.Result.Query">@t.Result.Query</code>
                                <span class="meter-num" title="@MeterTitle(t.Result.Length, t.Result.Limit)">
                                    @t.Result.Length/@t.Result.Limit@(t.Result.Exceeded ? " OVER" : "")
                                </span>
                                <button id="slot-copy-@t.CardId" @onclick="() => CopyBar(t.Result.Query)">copy</button>
                            </div>
                        }
                    }
                }
                else
                {
                    <span class="rb-empty">nothing to show yet — pick mods to build the string</span>
                }
            </div>
        </div>

        <div class="modrow pack-tools">
            <div class="pack-label">
                Test items
                <HelpTip Title="what test items are for">
                    <ul>
                        <li><b>import item</b> — paste an item copied from the game.</li>
                        <li><b>assemble item</b> — build one from catalog mods.</li>
                        <li>A search string lights up the matching items in the backpack.</li>
                    </ul>
                </HelpTip>
            </div>
            <button id="import-open" class="btn" @onclick="() => _importOpen = true">import item</button>
            <button id="query-import-open" class="btn" @onclick="() => _queryImportOpen = true">import search</button>
            <button id="builder-open" class="btn" @onclick="() => _builderOpen = true">assemble item</button>
            <button id="pack-remove" class="btn" disabled="@(State.SelectedItemId is null)"
                    title="@RemoveTitle()" @onclick="RemoveSelected">remove item</button>
        </div>
        <div class="pack-wrap">
            <BackpackGrid State="State" HighlightIds="_highlight" DimNonMatching="_dimNonMatching" OnPick="PickItem" />
        </div>
        <ImportPanel State="State" Open="_importOpen" OnClose="CloseImport" />
        <QueryImportPanel State="State" Open="_queryImportOpen" OnClose="CloseQueryImport" />
        <ItemBuilder State="State" Open="_builderOpen" OnClose="CloseBuilder" />
    </section>
    <div class="advanced-reserve" aria-hidden="true"></div>
</div>

<details class="panel advanced" id="more-info">
    <summary>More info</summary>
    <div id="engine-status">@_engineStatus</div>
    @if (_paste is not null)
    {
        <div class="qcard" id="combined-paste">
            <div class="qcard-head">
                <span>combined paste</span>
                <span class="meter" title="@_paste.Length/@_paste.Limit">
                    <span class="meter-bar meter-@ModSearch.MeterColor(_paste.Length, _paste.Limit)"
                          style="width:@(Math.Round(ModSearch.MeterRatio(_paste.Length, _paste.Limit) * 100))%"></span>
                </span>
                <span class="meter-num">@_paste.Length/@_paste.Limit@(_paste.Exceeded ? " OVER" : "")</span>
            </div>
            <div class="qquery" id="combined-paste-query">@_paste.Query</div>
            <div class="qactions">
                <button id="combined-copy" @onclick="() => CopyBar(_paste.Query)">copy</button>
            </div>
            <div class="qexplain">
                <div>anchor: <code>@_paste.Anchor</code></div>
                @foreach (var g in _paste.Groups)
                {
                    <div>@g.Label → <code>@g.Token</code></div>
                }
            </div>
            @foreach (var d in _paste.Diagnostics)
            {
                <div class="qdiag">@d.Level @d.Code: @d.Message</div>
            }
            <div class="more">slot exclusions apply globally; same-class slots merge (see plan §8.1)</div>
        </div>
    }
    @foreach (var t in _tasks)
    {
        <QueryCard CardId="@t.CardId" Title="@t.Title" ItemClass="@t.ItemClass" Result="@t.Result" />
    }
    <div class="modrow reset-row">
        <button id="workbench-reset" class="btn btn-danger"
                title="Destructive: clears every slot's class and mods plus the backpack lab"
                @onclick="ResetWorkbench">reset workbench</button>
        <div class="adv-meta">
            <span class="hint @(Engine.DataReady ? "" : "warn")" id="data-stamp"
                  title="catalog data version, target model, and exact table status">
                data: @Engine.DataVersion · @Engine.TargetModel ·
                @(Engine.DataReady ? "exact table" : "exact table missing")
            </span>
            <BuildStamp />
            <span class="legal-links">
                <a href="license.txt" target="_blank" rel="noopener noreferrer">license</a>
                <a href="notice.txt" target="_blank" rel="noopener noreferrer">notice</a>
                <a href="provenance.md" target="_blank" rel="noopener noreferrer">data provenance</a>
            </span>
        </div>
    </div>
</details>

<ItemTooltip Item="@SelectedItem()" X="_ttX" Y="_ttY" OnDismiss="DismissTooltip" />

@code {
    private sealed record TaskView(
        string CardId, string Title, string? ItemClass, CompileResult Result);

    private string _engineStatus = "booting...";
    private bool? _showIntro;
    private List<TaskView> _tasks = [];
    private List<TaskView> _barTasks = [];
    private List<(string Label, string? Query)> _labelledQueries = [];
    private HashSet<string> _highlight = [];
    private bool _dimNonMatching;
    private bool _importOpen;
    private bool _queryImportOpen;
    private bool _builderOpen;
    private MultiPasteResult? _paste;
    private double _ttX;
    private double _ttY;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        _engineStatus = $"engine ok ({Engine.InGameClasses().Count()} classes with mods)";
        _showIntro = !await Persistence.LoadIntroDismissedAsync();
        var saved = await Persistence.LoadAsync();
        if (saved is not null)
            WorkbenchSnapshot.Restore(State, saved);
        // Silently refresh builder-assembled items against the current catalog so
        // lines saved under an older (buggy) renderer text stop displaying.
        var healed = false;
        foreach (var item in State.TestItems)
            if (item.Reheal(Engine)) healed = true;
        if (healed) _ = Persistence.SaveAsync(WorkbenchSnapshot.Capture(State));
        Recompute();
    }

    private async Task DismissIntro()
    {
        _showIntro = false;
        await Persistence.SaveIntroDismissedAsync();
    }

    private void ShowIntro() => _showIntro = true;

    private void CloseImport() => _importOpen = false;
    private void CloseQueryImport() => _queryImportOpen = false;

    private void CloseBuilder() => _builderOpen = false;

    private void OnStateChanged()
    {
        Recompute();
        _ = Persistence.SaveAsync(WorkbenchSnapshot.Capture(State));
        InvokeAsync(StateHasChanged);
    }

    private async Task CopyBar(string query)
    {
        try { await JS.InvokeAsync<string>("poeRegexCopy", query); }
        catch { }
    }

    /// <summary>Pack tile click: pin the tooltip at the cursor; same tile dismisses.</summary>
    private void PickItem((string Id, double X, double Y) pick)
    {
        if (State.SelectedItemId == pick.Id)
        {
            State.SelectTestItem(null);
            return;
        }
        _ttX = pick.X;
        _ttY = pick.Y;
        State.SelectTestItem(pick.Id);
    }

    private void DismissTooltip() => State.SelectTestItem(null);

    private void RemoveSelected()
    {
        if (State.SelectedItemId is { } id)
            State.RemoveTestItem(id);
    }

    private string RemoveTitle() => SelectedItem() is { } item
        ? $"remove {item.Name} from the backpack"
        : "select a backpack item first";

    private void Recompute()
    {
        var tasks = new List<TaskView>();
        _paste = null;
        if (State.Mode == "simple")
        {
            tasks.Add(CompileTask("simple", "all items", null, State.Global));
        }
        else
        {
            var active = State.ActiveSlots();
            foreach (var s in active)
            {
                var crit = State.CriteriaFor(s);
                tasks.Add(CompileTask(s, $"{s} ({crit.ClassId})", crit.ClassId, crit));
            }
            if (active.Count > 0)
            {
                // Over-budget pastes keep their value: the strip shows the full
                // string with the k/N meter in its over state (allowOverflow
                // never throws); the in-game box is the judge, not the compiler.
                _paste = Engine.Combine(
                    active.Select(s =>
                    {
                        var crit = State.CriteriaFor(s);
                        return ($"{s} ({crit.ClassId})", crit.ClassId, (IEnumerable<WantedMod>)crit.Included);
                    }),
                    active.SelectMany(s => State.CriteriaFor(s).Excluded)
                        .Concat(State.Global.Excluded).Distinct(StringComparer.Ordinal),
                    allowOverflow: true);
            }
        }
        _tasks = tasks;
        _barTasks = State.Mode == "advanced" ? [] : tasks;
        _labelledQueries = State.Mode == "advanced" && _paste is not null
            ? [("combined paste", _paste.Query)]
            : tasks.Select(t => (t.Title, (string?)t.Result.Query)).ToList();
        var queries = _labelledQueries
            .Where(q => !string.IsNullOrWhiteSpace(q.Query)).Select(q => q.Query!).ToList();
        // Highlight/dim only once the active scope actually has mods picked:
        // an anchor-only query (no chips) stays neutral.
        var chipsPicked = State.Mode == "simple"
            ? State.Global.Included.Count > 0 || State.Global.Excluded.Count > 0
            : State.ActiveSlots().Count > 0;
        _highlight = chipsPicked
            ? State.TestItems
                .Where(item => queries.Any(q => ItemMatcher.Match(q, item.MatchLines()).Match))
                .Select(item => item.Id).ToHashSet()
            : [];
        _dimNonMatching = chipsPicked && queries.Count > 0;
    }

    /// <summary>Selected backpack item (null when none or it was removed).</summary>
    private TestItem? SelectedItem() =>
        State.SelectedItemId is { } id ? State.TestItems.FirstOrDefault(i => i.Id == id) : null;

    private TaskView CompileTask(string cardId, string title, string? itemClass, SlotCriteria crit)
    {
        // allowOverflow: a picked string always keeps its value; over-budget
        // states render with the k/N meter instead of a placeholder.
        var result = Engine.Compile(
            crit.Included.SelectMany(m => m.Requirements()),
            crit.Excluded.Select(e => new ModifierRequirement(e)),
            itemClass: itemClass,
            allowOverflow: true);
        return new TaskView(cardId, title, itemClass, result);
    }

    /// <summary>
    /// Distinct skipped picks across the visible compiles (and the combined
    /// paste). The result bar carries a quiet count when this is non-zero; the
    /// title is the engine's factual diagnostic text.
    /// </summary>
    private List<CompilerDiagnostic> UnresolvedDiagnostics() =>
        _tasks.SelectMany(t => t.Result.Diagnostics)
            .Concat(_paste?.Diagnostics ?? [])
            .Where(d => d.Code == "unresolved-modifier")
            .GroupBy(d => d.Message, StringComparer.Ordinal)
            .Select(g => g.First())
            .ToList();

    private static string UnresolvedTitle(IReadOnlyList<CompilerDiagnostic> diagnostics) =>
        string.Join("\n", diagnostics.Select(d => d.Message));

    private static string MeterTitle(int length, int limit) =>
        length > limit
            ? $"{length}/{limit} characters — {length - limit} over the game's search box limit"
            : $"{length} of {limit} characters";

    /// <summary>The single string shown in the search-string bar for the current scope.</summary>
    private string BarQuery() =>
        State.Mode == "advanced"
            ? _paste?.Query ?? ""
            : _barTasks.FirstOrDefault()?.Result.Query ?? "";

    /// <summary>Picks rail scope: the focused slot in advanced, the global set in simple.</summary>
    private string? RailScope => State.Mode == "advanced" ? State.FocusedSlot : null;

    /// <summary>The rail shows its "+ to add" hint only where a picker is available.</summary>
    private bool RailHint => State.Mode == "simple" || State.FocusedSlot is not null;

    /// <summary>Mods for the rail/picker scope (empty while advanced is unfocused).</summary>
    private IReadOnlyList<ModEntry> RailMods =>
        State.Mode == "simple"
            ? Engine.PlayableMods()
            : State.FocusedSlot is { } focus
                ? Engine.ModsForClass(State.SlotClassOrDefault(focus))
                : [];

    /// <summary>What the bar's string covers: silent in simple; the slots in advanced.</summary>
    private string ScopeText()
    {
        if (State.Mode != "advanced") return "";
        var active = State.ActiveSlots();
        if (active.Count == 0) return "";
        if (active.Count > 3) return $"{active.Count} slots";
        if (active.Count == 1)
        {
            var slot = active[0];
            var label = GearSlot.ById(slot)?.Label ?? slot;
            var cls = State.SlotClassOrDefault(slot);
            return string.Equals(label, cls, StringComparison.OrdinalIgnoreCase)
                ? label
                : $"{label} · {cls}";
        }
        return string.Join(" + ", active.Select(s => GearSlot.ById(s)?.Label ?? s));
    }

    private async Task ResetWorkbench()
    {
        await Persistence.ClearAsync();
        State.Reset(); // notifies -> recompute + save of defaults
    }

    public void Dispose() => State.Changed -= OnStateChanged;
}
