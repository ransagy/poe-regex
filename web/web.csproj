<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <ProjectReference Include="..\src\PoeRegex.Core\PoeRegex.Core.csproj" />
    <ProjectReference Include="..\src\PoeRegex.Web.Core\PoeRegex.Web.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legal notices ship with the app and are linked from the Advanced panel.
         build.sh also copies them after publish (Cloudflare runs build.sh). -->
    <Content Include="..\LICENSE" Link="wwwroot\license.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\NOTICE" Link="wwwroot\notice.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\docs\PROVENANCE.md" Link="wwwroot\provenance.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
