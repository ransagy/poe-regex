{
  "name": "poe-regex-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenTUI demo for the poe-regex engine (spec §7 layout).",
  "scripts": {
    "spike": "node --experimental-ffi --disable-warning=ExperimentalWarning spike.mjs",
    "dev": "node --experimental-ffi --disable-warning=ExperimentalWarning src/index.mjs",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/*.test.mjs\"",
    "test:smoke": "python3 test/smoke-pty.py",
    "build:cli": "dotnet publish ../../src/PoeRegex.Cli -c Release -p:PublishAot=true --output ../../out"
  },
  "dependencies": {
    "@opentui/core": "0.6.6"
  },
  "engines": {
    "node": ">=26.4.0"
  }
}
