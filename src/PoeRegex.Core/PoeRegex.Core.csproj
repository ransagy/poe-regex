<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../data/catalogs/poe2.catalog.json" LogicalName="PoeRegex.Core.catalogs.poe2.catalog.json" />
    <EmbeddedResource Include="../../data/catalogs/poe2.fragments.json" LogicalName="PoeRegex.Core.catalogs.poe2.fragments.json" Condition="Exists('../../data/catalogs/poe2.fragments.json')" />
    <EmbeddedResource Include="../../data/catalogs/poe2.safety-items.txt" LogicalName="PoeRegex.Core.catalogs.poe2.safety-items.txt" />
    <EmbeddedResource Include="../../data/catalogs/poe2.vendor-corpus.json" LogicalName="PoeRegex.Core.catalogs.poe2.vendor-corpus.json" Condition="Exists('../../data/catalogs/poe2.vendor-corpus.json')" />
  </ItemGroup>

</Project>
